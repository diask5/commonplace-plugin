@@ -0,0 +1,45 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {createRuntimeUpgrade,runtimeWork} from '../apps/commonplace/server/runtime-upgrade.mjs';
+import {CloudSync} from '../apps/commonplace/server/cloud-sync.mjs';
+
+function fixture(app={}) {
+  let time=10, queued, restarts=0;
+  const upgrade=createRuntimeUpgrade(app,{restart:()=>{restarts++;},now:()=>time,schedule:fn=>{queued=fn;return {unref(){}};},cancel:()=>{queued=null;},deadlineMs:100});
+  return {app,upgrade,restarts:()=>restarts,step:async(ms=0)=>{time+=ms;const fn=queued;queued=null;fn?.();await Promise.resolve();}};
+}
+
+test('recurring collection drains once without changing saved sync settings',async()=>{
+  const app={cloudSync:{running:true,state:{enabled:true}},contextMirror:{running:true,state:{enabled:true,generation:'retained'}},jobs:new Set()};
+  const f=fixture(app),saved=JSON.stringify([app.cloudSync.state,app.contextMirror.state]);
+  assert.equal(f.upgrade.request().draining,true);assert.equal(app.runtimeDraining,true);
+  await f.step();assert.equal(f.restarts(),0);
+  app.cloudSync.running=false;app.contextMirror.running=false;
+  await f.step();assert.equal(f.restarts(),1);assert.equal(f.upgrade.request().restarting,true);
+  await f.step();assert.equal(f.restarts(),1);assert.equal(JSON.stringify([app.cloudSync.state,app.contextMirror.state]),saved);
+});
+
+test('active foreground jobs retain their guard and drain timeout resumes background scheduling',async()=>{
+  const app={resourceTicking:true,cloudBrowserLogin:{running:true},historyAnswer:{running:true},jobs:new Set(['job'])},f=fixture(app);
+  f.upgrade.request();await f.step(99);assert.equal(f.restarts(),0);
+  assert.deepEqual(runtimeWork(app),['resourceCheck','signInCheck','answer','jobs']);
+  await f.step(1);assert.equal(f.upgrade.status().state,'busy');assert.equal(app.runtimeDraining,false);
+  app.historyAnswer.running=false;app.jobs.clear();app.resourceTicking=false;app.cloudBrowserLogin.running=false;f.upgrade.request();await f.step();assert.equal(f.restarts(),1);
+});
+
+test('duplicate restart requests do not extend the drain deadline or lose a newly active job',async()=>{
+  const app={capturing:true},f=fixture(app);
+  const first=f.upgrade.request();await f.step(50);assert.equal(f.upgrade.request().deadlineAt,first.deadlineAt);
+  app.capturing=false;app.cloudBrowserLogin={current:{}};await f.step(50);
+  assert.equal(f.restarts(),0);assert.equal(f.upgrade.status().state,'busy');
+});
+
+test('closing a pending drain cancels restart and restores scheduling',async()=>{
+  const f=fixture({building:true});f.upgrade.request();f.upgrade.close();await f.step(200);
+  assert.equal(f.restarts(),0);assert.equal(f.app.runtimeDraining,false);
+});
+
+test('cloud collection starts no network or disk work during a runtime drain',async()=>{
+  let checked=0;const app={runtimeDraining:true,accountClient:{view:()=>{checked++;return {connected:true};}}};
+  await CloudSync.prototype.tick.call({app});assert.equal(checked,0);
+});
