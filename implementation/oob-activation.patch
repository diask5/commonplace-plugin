+  let starts=0,restarts=0;
+  const server=createServer(async(req,res)=>{let raw='';for await(const c of req)raw+=c;const r=JSON.parse(raw);assert.equal(req.headers.authorization,'Bearer private-test');
+   if(req.url==='/api/runtime/restart'){restarts++;res.writeHead(status,{'content-type':'application/json'});res.end(JSON.stringify({draining:status===200}));}
+   else {res.writeHead(200,{'content-type':'application/json'});res.end(JSON.stringify({id:r.id,result:{}}));}
