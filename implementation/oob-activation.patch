diff --git a/apps/commonplace/server/runtime-upgrade.mjs b/apps/commonplace/server/runtime-upgrade.mjs
new file mode 100644
index 0000000..5a83a0f
--- /dev/null
+++ b/apps/commonplace/server/runtime-upgrade.mjs
@@ -0,0 +1,52 @@
+// Drain recurring work without changing the owner's saved collection choices.
+// Foreground work retains the existing guard. A deadline resumes scheduling;
+// an update never forces a busy job to stop.
+export function runtimeWork(app) {
+  return Object.entries({
+    collection: app.cloudSync?.running,
+    mirror: app.contextMirror?.running,
+    resources: app.mcpResourceIngestion?.active?.size,
+    resourceCheck: app.resourceTicking,
+    signIn: app.cloudBrowserLogin?.current,
+    signInCheck: app.cloudBrowserLogin?.running,
+    import: app.historyImport?.running,
+    answer: app.historyAnswer?.running,
+    workspace: app.workspaceReceiver?.running,
+    desktop: app.desktopReceiver?.running,
+    ssh: app.sshWorkspaces?.running,
+    build: app.building,
+    organization: app.organizing,
+    capture: app.capturing,
+    jobs: app.jobs?.size,
+    background: app.backgroundTicking,
+  }).filter(([, active]) => active).map(([name]) => name);
+}
+
+export function createRuntimeUpgrade(app, {
+  restart, now = Date.now, schedule = setTimeout, cancel = clearTimeout,
+  deadlineMs = 120000, pollMs = 100,
+} = {}) {
+  let state = 'idle', startedAt = null, timer;
+  const status = () => ({state, startedAt, deadlineAt: startedAt === null ? null : startedAt + deadlineMs, waitingFor: runtimeWork(app)});
+  function enqueue() { timer = schedule(check, pollMs); timer.unref?.(); }
+  function check() {
+    if (state !== 'draining') return;
+    if (runtimeWork(app).length === 0) {
+      state = 'restarting';
+      // The guard is checked immediately before shutdown, in the same turn.
+      Promise.resolve().then(restart).catch(() => { state = 'failed'; app.runtimeDraining = false; });
+    } else if (now() - startedAt >= deadlineMs) {
+      state = 'busy'; app.runtimeDraining = false;
+    } else enqueue();
+  }
+  return {
+    status,
+    request() {
+      if (state !== 'draining' && state !== 'restarting') {
+        state = 'draining'; startedAt = now(); app.runtimeDraining = true; enqueue();
+      }
+      return {restarting: state === 'restarting', draining: state === 'draining', ...status()};
+    },
+    close() { cancel(timer); if (state !== 'restarting') app.runtimeDraining = false; state = 'closed'; },
+  };
+}
