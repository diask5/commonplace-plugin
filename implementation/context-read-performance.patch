diff --git a/tests/archive-coordination.test.mjs b/tests/archive-coordination.test.mjs
new file mode 100644
index 0000000..2eff0ad
--- /dev/null
+++ b/tests/archive-coordination.test.mjs
@@ -0,0 +1,77 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {mkdtemp,rm,writeFile,chmod} from 'node:fs/promises';
+import {tmpdir} from 'node:os';
+import path from 'node:path';
+import {openDatabase} from '../apps/commonplace-account/server/sqlite.mjs';
+import {AccountService} from '../apps/commonplace-account/server/service.mjs';
+import {CloudWork} from '../apps/commonplace-account/server/cloud-work.mjs';
+import {CloudArchive} from '../apps/commonplace-account/server/cloud-archive.mjs';
+import {ContextStore} from '../apps/commonplace-account/server/context-store.mjs';
+import {sharedContext,closeSharedContext} from '../apps/commonplace-account/server/shared-context.mjs';
+// The web process builds into COMMONPLACE_CONTEXT_DIR; the worker process builds
+// elsewhere but updates the same published_revision flag.
+async function fixture(t){
+  const dir=await mkdtemp(path.join(tmpdir(),'archive-coordination-')),previous=process.env.COMMONPLACE_CONTEXT_DIR;
+  process.env.COMMONPLACE_CONTEXT_DIR=path.join(dir,'web');
+  const db=openDatabase(path.join(dir,'db.sqlite'),{migrations:path.resolve('apps/commonplace-account/drizzle')});
+  t.after(async()=>{await closeSharedContext({db});db.close();if(previous===undefined)delete process.env.COMMONPLACE_CONTEXT_DIR;else process.env.COMMONPLACE_CONTEXT_DIR=previous;await rm(dir,{recursive:true,force:true});});
+  const service=new AccountService(db,'https://relay.example'),owner=(await service.profile({userId:'owner',email:'owner@example.test'})).id;
+  new ContextStore(service).upsert(owner,{conversation:{id:'conversation-one',title:'Orchid notes',capturedAt:Date.now()},messages:[{id:'message-one',role:'user',text:'Orchid coordination fact',position:0,capturedAt:Date.now()}]});
+  const worker=new CloudArchive(new CloudWork(service),{directory:path.join(dir,'worker')});
+  return {dir,db,service,owner,worker};
+}
+function countPrepares(t){
+  const original=CloudArchive.prototype.prepare,calls=[];
+  CloudArchive.prototype.prepare=function(...args){calls.push(args);return original.apply(this,args);};
+  t.after(()=>{CloudArchive.prototype.prepare=original;});
+  return calls;
+}
+const search=f=>sharedContext(f.service,f.owner,'archive-search',{query:'Orchid'});
+
+test('a snapshot published only by the worker directory does not make web search wait for a rebuild',async t=>{
+  const f=await fixture(t);
+  await (await f.worker.prepare(f.owner)).release();
+  const state=f.db.sqlite.prepare('SELECT revision,published_revision FROM cp_cloud_archive_state WHERE owner=?').get(f.owner);
+  assert.equal(state.published_revision,state.revision);
+  const prepares=countPrepares(t);
+  const result=await search(f);
+  assert.equal(result.results.length,1);
+  assert.equal(prepares.length,0,'live read, not a synchronous snapshot build');
+});
+
+test('a current local snapshot is used even when the shared published flag disagrees',async t=>{
+  const f=await fixture(t);
+  const web=new CloudArchive(new CloudWork(f.service),{directory:process.env.COMMONPLACE_CONTEXT_DIR});
+  await (await web.prepare(f.owner)).release();
+  f.db.sqlite.prepare('UPDATE cp_cloud_archive_state SET published_revision=0 WHERE owner=?').run(f.owner);
+  const prepares=countPrepares(t);
+  assert.equal((await search(f)).results.length,1);
+  assert.equal(prepares.length,1);
+  assert.deepEqual(prepares[0][1],{reuseCurrent:true});
+});
+
+test('a local snapshot behind the revision is not trusted',async t=>{
+  const f=await fixture(t);
+  const web=new CloudArchive(new CloudWork(f.service),{directory:process.env.COMMONPLACE_CONTEXT_DIR});
+  await (await web.prepare(f.owner)).release();
+  new ContextStore(f.service).upsert(f.owner,{conversation:{id:'conversation-two',title:'Second',capturedAt:Date.now()},messages:[{id:'message-two',role:'user',text:'Orchid later fact',position:0,capturedAt:Date.now()}]});
+  const stale=countPrepares(t);
+  const result=await search(f);
+  assert.equal(result.results.length,2);
+  assert.equal(stale.length,0,'stale local snapshot falls back to the live read');
+});
+
+// Expiry is checked locally even if the other publisher still reports ready.
+test('an expired local manifest cannot select the snapshot path',async t=>{
+  const f=await fixture(t);
+  const web=new CloudArchive(new CloudWork(f.service),{directory:process.env.COMMONPLACE_CONTEXT_DIR});
+  const snapshot=await web.prepare(f.owner);await snapshot.release();
+  const manifestFile=path.join(snapshot.directory,'manifest.json');
+  await chmod(manifestFile,0o644);
+  await writeFile(manifestFile,JSON.stringify({...snapshot.manifest,expiresAt:Date.now()-1}));
+  await chmod(manifestFile,0o444);
+  const prepares=countPrepares(t),result=await search(f);
+  assert.equal(result.results.length,1);
+  assert.equal(prepares.length,0,'expired manifest routes to authoritative live data');
+});
