+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtemp, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import path from 'node:path';
+import { openDatabase } from '../apps/commonplace-account/server/sqlite.mjs';
+import { AccountService } from '../apps/commonplace-account/server/service.mjs';
+import { CloudWork } from '../apps/commonplace-account/server/cloud-work.mjs';
+import { legacyVisibleSql } from '../apps/commonplace-account/server/unified-context.mjs';
+
+const migrations = path.resolve('apps/commonplace-account/drizzle');
+const savedSql = 'SELECT count(*) AS count,max(synced_at) AS lastSyncedAt FROM (SELECT synced_at FROM cp_cloud_sources s WHERE owner=? AND ' + legacyVisibleSql + ' UNION ALL SELECT synced_at FROM cp_context_chunks WHERE owner=?)';
+const plan = (db, sql, ...args) => db.sqlite.prepare('EXPLAIN QUERY PLAN ' + sql).all(...args).map(r => r.detail).join('\n');
+
+async function fixture(t) {
+  const dir = await mkdtemp(path.join(tmpdir(), 'read-indexes-'));
+  const file = path.join(dir, 'db.sqlite');
+  const db = openDatabase(file, { migrations });
+  t.after(async () => { try { db.close(); } catch {} await rm(dir, { recursive: true, force: true }); });
+  const service = new AccountService(db, 'https://relay.example');
+  const owner = (await service.profile({ userId: 'firebase:owner', email: 'owner@example.test' })).id;
+  const other = (await service.profile({ userId: 'firebase:other', email: 'other@example.test' })).id;
+  return { db, file, service, owner, other, work: new CloudWork(service, { now: () => Date.now() }) };
+}
+
+function seed(db, owner, other) {
+  const s = db.sqlite;
+  for (const [id, who] of [['dev-a', owner], ['dev-b', other], ['dev-r', owner]]) {
+    s.prepare('INSERT INTO cp_devices(id,owner,client,name,scope,created_at) VALUES(?,?,?,?,?,?)').run(id, who, 'test', id, 'commonplace:read', 1);
+  }
+  s.prepare('UPDATE cp_devices SET revoked=1 WHERE id=?').run('dev-r');
+  const src = s.prepare('INSERT INTO cp_cloud_sources(id,owner,device,source_key,revision,title,body,digest,captured_at,synced_at) VALUES(?,?,?,?,1,?,?,?,1,?)');
+  src.run('s1', owner, 'dev-a', 'k1', 't', 'body', 'd1', 100);
+  src.run('s2', owner, 'dev-a', 'k2:child', 't', 'body', 'd2', 300);
+  src.run('s3', owner, 'dev-a', 'k3', 't', 'body', 'd3', 900);
+  src.run('s4', other, 'dev-b', 'k1', 't', 'body', 'd4', 5000);
+  s.prepare("INSERT INTO cp_context_documents(id,owner,provider,external_id,title,source_url,captured_at,synced_at) VALUES('doc1',?,'chatgpt','x','d','',1,1)").run(owner);
+  s.prepare('INSERT INTO cp_context_chunks(id,document,owner,title,body,captured_at,synced_at) VALUES(?,?,?,?,?,1,?)').run('c1', 'doc1', owner, 't', 'b', 700);
+  const stream = s.prepare("INSERT INTO cp_context_streams(id,owner,provider,external_id,title,excluded,updated_at) VALUES(?,?,'codex',?,'t',?,1)");
+  const origin = s.prepare("INSERT INTO cp_context_origins(stream,device,source_key,captured_at,seen_at,state) VALUES(?,?,?,1,?,'current')");
+  stream.run('st-live', owner, 'e1', 0); origin.run('st-live', 'dev-a', 'a', 4000);
+  stream.run('st-excluded', owner, 'e2', 1); origin.run('st-excluded', 'dev-a', 'b', 8000);
+  stream.run('st-revoked', owner, 'e3', 0); origin.run('st-revoked', 'dev-r', 'c', 9000);
+}
+
+test('0045 is additive and creates the read indexes', async t => {
+  const { db } = await fixture(t);
+  const names = db.sqlite.prepare("SELECT name FROM sqlite_master WHERE type='index'").all().map(r => r.name);
+  for (const n of ['cp_cloud_sources_owner_synced', 'cp_context_chunks_owner_synced', 'cp_agent_auth_store_expires']) assert.ok(names.includes(n), n);
+  assert.ok(db.sqlite.prepare("SELECT 1 FROM cp_schema_migrations WHERE name='0045_context_read_indexes.sql'").get());
+});
+
+test('migration is idempotent across reopen and rerun', async t => {
+  const { db, file } = await fixture(t);
+  const before = db.sqlite.prepare("SELECT name,sql FROM sqlite_master WHERE type='index' ORDER BY name").all();
+  db.close();
+  const again = openDatabase(file, { migrations });
+  t.after(() => again.close());
+  assert.deepEqual(again.sqlite.prepare("SELECT name,sql FROM sqlite_master WHERE type='index' ORDER BY name").all(), before);
+  const sql = (await import('node:fs')).readFileSync(path.join(migrations, '0045_context_read_indexes.sql'), 'utf8');
+  again.sqlite.exec(sql);
+  assert.equal(again.sqlite.prepare("SELECT count(*) AS n FROM cp_schema_migrations WHERE name='0045_context_read_indexes.sql'").get().n, 1);
+});
+
+test('sourceStatus and stats queries use covering indexes, not table scans', async t => {
+  const { db, owner } = await fixture(t);
+  const p = plan(db, savedSql, owner, owner);
+  assert.match(p, /USING COVERING INDEX cp_cloud_sources_owner_synced/);
+  assert.match(p, /USING COVERING INDEX cp_context_chunks_owner_synced/);
+  assert.doesNotMatch(p, /SCAN s\b(?! USING)|SCAN cp_context_chunks(?! USING)/);
+  assert.match(plan(db, 'SELECT max(synced_at) AS at FROM cp_cloud_sources WHERE owner=?', owner), /COVERING INDEX cp_cloud_sources_owner_synced/);
+  assert.match(plan(db, 'DELETE FROM cp_agent_auth_store WHERE expires>0 AND expires<=?', 5), /cp_agent_auth_store_expires/);
+});
+
+test('sourceStatus results match unindexed evaluation for owner, exclusion and canonical streams', async t => {
+  const { db, work, owner, other } = await fixture(t);
+  seed(db, owner, other);
+  const s = db.sqlite;
+  const reference = who => s.prepare(savedSql.replace('FROM cp_cloud_sources s', 'FROM cp_cloud_sources s NOT INDEXED').replace('FROM cp_context_chunks WHERE', 'FROM cp_context_chunks NOT INDEXED WHERE')).get(who, who);
+  let got = work.sourceStatus(owner);
+  assert.equal(got.count, 3 + 1 + 1); // three sources, one chunk, one current canonical stream
+  assert.equal(got.canonicalConversations, 1);
+  assert.equal(got.lastSyncedAt, 4000); // excluded and revoked origins do not contribute
+  assert.equal(got.count - got.canonicalConversations, reference(owner).count);
+  assert.equal(reference(owner).lastSyncedAt, 900);
+  // A legacy alias hides k2 and its children from this owner only.
+  s.exec('PRAGMA foreign_keys=OFF');
+  s.prepare('INSERT INTO cp_context_legacy_aliases(owner,device,source_key,stream) VALUES(?,?,?,?)').run(owner, 'dev-a', 'k2', 'st-live');
+  s.exec('PRAGMA foreign_keys=ON');
+  got = work.sourceStatus(owner);
+  assert.equal(got.count, 2 + 1 + 1);
+  assert.equal(got.count - got.canonicalConversations, reference(owner).count);
+  const theirs = work.sourceStatus(other);
+  assert.equal(theirs.count, 1);
+  assert.equal(theirs.lastSyncedAt, 5000);
+  assert.equal(work.sourceStatus('nobody').count, 0);
+});
