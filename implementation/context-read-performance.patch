@@ -0,0 +1,133 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {randomBytes,createHash} from 'node:crypto';
+import {mkdtemp,rm,readFile,writeFile,readdir,lstat,stat,chmod,symlink,mkdir} from 'node:fs/promises';
+import {tmpdir} from 'node:os';
+import {PassThrough} from 'node:stream';
+import path from 'node:path';
+import {openDatabase} from '../apps/commonplace-account/server/sqlite.mjs';
+import {AccountService} from '../apps/commonplace-account/server/service.mjs';
+import {CloudWork} from '../apps/commonplace-account/server/cloud-work.mjs';
+import {CloudArchive} from '../apps/commonplace-account/server/cloud-archive.mjs';
+import {ArchiveTools,serveArchive} from '../apps/commonplace-account/server/archive-tools.mjs';
+const uid=()=>randomBytes(12).toString('hex'),hash=s=>createHash('sha256').update(s).digest('hex');
+async function fixture(t){
+  const dir=await mkdtemp(path.join(tmpdir(),'archive-io-')),db=openDatabase(path.join(dir,'db.sqlite'),{migrations:path.resolve('apps/commonplace-account/drizzle')});
+  t.after(async()=>{db.close();await rm(dir,{recursive:true,force:true});});
+  const service=new AccountService(db,'https://relay.example'),owner=(await service.profile({userId:'owner',email:'owner@example.test'})).id;
+  const work=new CloudWork(service),archive=new CloudArchive(work,{directory:path.join(dir,'archives')}),device=uid();
+  work.run('INSERT INTO cp_devices(id,owner,client,name,scope,created_at) VALUES(?,?,?,?,?,?)',device,owner,'test','Mac','commonplace',Date.now());
+  const native=(key,text,revision=1)=>work.upload(owner,{id:device},{key:hash(key),text,title:'Codex chats: '+key,revision,capturedAt:Date.now()-1000});
+  const root=path.join(dir,'archives',owner);
+  const generations=async()=>(await readdir(root)).filter(n=>/^r\d+-/.test(n)).sort();
+  return {dir,db,work,owner,archive,native,root,generations};
+}
+const sectionFile=(snapshot,id)=>path.join(snapshot.directory,'sections',id+'.txt');
+const idFor=(snapshot,title)=>snapshot.manifest.documents.find(d=>d.title.includes(title)).sections[0];
+
+test('reused sections keep their inode and a writable prior section is made 0444 again',async t=>{
+  const f=await fixture(t);f.native('keep','Keep body '.repeat(50));f.native('writable','Writable body '.repeat(50));
+  const a=await f.archive.prepare(f.owner),keep=idFor(a,'keep'),writable=idFor(a,'writable');
+  const inode=(await stat(sectionFile(a,keep))).ino,writableInode=(await stat(sectionFile(a,writable))).ino;
+  await chmod(sectionFile(a,writable),0o644);
+  f.native('other','Another source');
+  const b=await f.archive.prepare(f.owner);assert.notEqual(b.directory,a.directory);
+  assert.equal((await stat(sectionFile(b,keep))).ino,inode,'clean unchanged section is hard-linked');
+  assert.equal((await stat(sectionFile(b,writable))).ino,writableInode,'writable section is still linked, then fixed');
+  for(const id of [keep,writable]){const s=await lstat(sectionFile(b,id));assert.ok(s.isFile());assert.equal(s.mode&0o7777,0o444,id);}
+  for(const [id,source] of Object.entries(b.manifest.sources))assert.equal(hash(await readFile(sectionFile(b,id))),source.digest,'every byte matches its manifest digest');
+  await a.release();await b.release();
+});
+
+test('a corrupted prior section prevents any reuse and is rewritten from storage',async t=>{
+  const f=await fixture(t);f.native('keep','Keep body '.repeat(50));f.native('corrupt','Corrupt body '.repeat(50));
+  const a=await f.archive.prepare(f.owner),keep=idFor(a,'keep'),corrupt=idFor(a,'corrupt');
+  const inode=(await stat(sectionFile(a,keep))).ino;
+  await chmod(sectionFile(a,corrupt),0o644);await writeFile(sectionFile(a,corrupt),'tampered');await chmod(sectionFile(a,corrupt),0o444);
+  f.native('other','Another source');
+  const b=await f.archive.prepare(f.owner);
+  assert.notEqual((await stat(sectionFile(b,keep))).ino,inode,'untrusted prior generation is not linked');
+  for(const [id,source] of Object.entries(b.manifest.sources)){assert.equal(hash(await readFile(sectionFile(b,id))),source.digest);assert.equal((await lstat(sectionFile(b,id))).mode&0o7777,0o444);}
+  assert.notEqual(await readFile(sectionFile(b,corrupt),'utf8'),'tampered');
+  await a.release();await b.release();
+});
+
+test('freshly written sections are 0444 even under a restrictive umask and a writable linked source is fixed',async t=>{
+  const f=await fixture(t);f.native('fresh','Fresh '.repeat(40));
+  const previous=process.umask(0o277);let snapshot;
+  try{snapshot=await f.archive.prepare(f.owner);}finally{process.umask(previous);}
+  for(const id of Object.keys(snapshot.manifest.sources))assert.equal((await lstat(sectionFile(snapshot,id))).mode&0o7777,0o444);
+  await snapshot.release();
+});
+
+test('release collects a retired generation only after its last pin and never removes the current or another pinned generation',async t=>{
+  const f=await fixture(t);f.native('one','First revision');
+  const a1=await f.archive.prepare(f.owner),a2=await f.archive.prepare(f.owner,{reuseCurrent:true});assert.equal(a1.directory,a2.directory);
+  f.native('two','Second revision');
+  const b=await f.archive.prepare(f.owner);assert.notEqual(b.directory,a1.directory);
+  assert.equal((await f.generations()).length,2,'pinned older generation survives refresh');
+  await a1.release();assert.equal((await f.generations()).length,2,'second pin on the old generation remains');
+  f.native('three','Third revision');
+  const c=await f.archive.prepare(f.owner);
+  await b.release();await b.release();
+  assert.deepEqual(await f.generations(),[path.basename(a1.directory),path.basename(c.directory)].sort(),'unpinned b is collected, pinned a and current c stay');
+  const before=await f.generations();await c.release();assert.deepEqual(await f.generations(),before,'releasing the current generation deletes nothing');
+  await a2.release();assert.deepEqual(await f.generations(),[path.basename(c.directory)]);
+  const text=await readFile(sectionFile(c,Object.keys(c.manifest.sources)[0]),'utf8');assert.ok(text.length>0);
+});
+
+test('an invalid or unsafe current pointer makes release delete nothing and never throw',async t=>{
+  const f=await fixture(t);f.native('one','First revision');
+  const outside=path.join(f.dir,'outside');await mkdir(outside);await writeFile(path.join(outside,'keep.txt'),'x');
+  const pointers=[
+    '{not json',
+    JSON.stringify({generation:'../outside',revision:1}),
+    JSON.stringify({generation:'r1-0000000000000000',revision:99}),
+    JSON.stringify({generation:'r9-0000000000000000',revision:9}),
+    'SYMLINK',
+  ];
+  for(const [i,pointer] of pointers.entries()){
+    const a=await f.archive.prepare(f.owner);f.native('bump'+i,'More '+i);
+    const b=await f.archive.prepare(f.owner);
+    const link=path.join(f.root,'r99-aaaaaaaaaaaaaaaa');
+    if(pointer==='SYMLINK'){await symlink(outside,link);await writeFile(path.join(f.root,'current.json'),JSON.stringify({generation:'r99-aaaaaaaaaaaaaaaa',revision:99}));}
+    else await writeFile(path.join(f.root,'current.json'),pointer);
+    const before=await f.generations();
+    await a.release();
+    assert.deepEqual(await f.generations(),before,'pointer '+i+' deleted nothing');
+    assert.equal(await readFile(path.join(outside,'keep.txt'),'utf8'),'x');
+    await rm(link,{force:true});
+    await b.release();
+    await f.archive.refresh(f.owner);
+  }
+});
+
+test('serveArchive speaks MCP after the lazy adapter import and returns exactly the direct tool output',async t=>{
+  const f=await fixture(t);f.native('alpha','The lazy loaded archive says pineapple.');f.native('beta','Second document without that word.');
+  const snapshot=await f.archive.prepare(f.owner),receipt=path.join(f.dir,'receipt'),direct=await ArchiveTools.open(snapshot.directory,path.join(f.dir,'direct-receipt'));
+  const input=new PassThrough(),output=new PassThrough();let out='';const done=new Promise(resolve=>output.on('data',b=>{out+=b;if(out.trim().split('\n').length===5){input.end();resolve();}}));
+  const doc=snapshot.manifest.documents.find(d=>d.title.includes('alpha')).id;
+  const served=serveArchive(snapshot.directory,receipt,{input,output});
+  const requests=[{id:1,method:'initialize',params:{protocolVersion:'2024-11-05',capabilities:{},clientInfo:{name:'test',version:'1'}}},{id:2,method:'tools/list'},
+    {id:3,method:'tools/call',params:{name:'archive_search',arguments:{query:'pineapple'}}},{id:4,method:'tools/call',params:{name:'archive_read',arguments:{documentId:doc}}},{id:5,method:'tools/call',params:{name:'archive_read',arguments:{documentId:'nope'}}}];
+  await served;input.write(requests.map(r=>JSON.stringify({jsonrpc:'2.0',...r})).join('\n')+'\n');
+  await Promise.race([done,new Promise((_,reject)=>setTimeout(()=>reject(new Error('no MCP responses: '+out)),5000).unref())]);
+  const responses=out.trim().split('\n').map(JSON.parse).sort((a,b)=>a.id-b.id);assert.equal(responses.length,5);
+  assert.equal(responses[1].result.tools.length,3);
+  const strip=v=>{const copy=JSON.parse(JSON.stringify(v));delete copy.resourceUri;for(const r of copy.results||[])delete r.resourceUri;return copy;};
+  const search=JSON.parse(responses[2].result.content[0].text),read=JSON.parse(responses[3].result.content[0].text);
+  assert.deepEqual(strip(search),strip(await direct.call('archive_search',{query:'pineapple'})));
+  assert.deepEqual(strip(read),strip(await direct.call('archive_read',{documentId:doc})));
+  assert.equal(search.results.length,1);assert.ok(search.results[0].resourceUri&&read.resourceUri);assert.match(read.text,/pineapple/);
+  assert.equal(responses[4].result.isError,true);
+  assert.equal(await readFile(receipt,'utf8').then(s=>s.trim().split('\n').length>0),true,'receipts still recorded');
+  await snapshot.release();
+});
