+];
+
+// All owner data travels as argv, never interpolated AppleScript or shell code.
+// osascript reads a static program from stdin; execFile never invokes a shell.
+export function runAppleScript(script,args,{execute=execFile}={}){
+ return new Promise((resolve,reject)=>{
+  const child=execute('/usr/bin/osascript',['-l','AppleScript','-',...args],{timeout:30000,maxBuffer:1024*1024,encoding:'utf8'},(error,stdout,stderr)=>{
+   if(error){error.hostReason=String(stderr||error.message).trim();reject(error);}else resolve(String(stdout).trim());
+  });
+  child.stdin?.on('error',()=>{});
+  child.stdin?.end(script);
+ });
+}
+
+const jsonHandlers=String.raw`
+on replaceText(needle, replacement, value)
+ set AppleScript's text item delimiters to needle
+ set pieces to text items of value
+ set AppleScript's text item delimiters to replacement
+ set resultText to pieces as text
+ set AppleScript's text item delimiters to ""
+ return resultText
+end replaceText
+on jsonText(value)
+ set value to my replaceText("\\", "\\\\", value as text)
+ set value to my replaceText(quote, "\\" & quote, value)
+ repeat with n from 0 to 31
+  set digits to "0123456789abcdef"
+  set escaped to "\\u00" & character ((n div 16) + 1) of digits & character ((n mod 16) + 1) of digits
+  set value to my replaceText(character id n, escaped, value)
+ end repeat
+ return quote & value & quote
+end jsonText
+on jsonList(values)
+ set resultText to "["
+ repeat with value in values
+  if resultText is not "[" then set resultText to resultText & ","
+  set resultText to resultText & my jsonText(contents of value)
+ end repeat
+ return resultText & "]"
+end jsonList
+`;
+
+export const contactsScript=jsonHandlers+String.raw`
+on run argv
+ set needle to item 1 of argv
+ set resultText to "["
+ set countFound to 0
+ tell application "Contacts"
+  set matches to people whose name contains needle
+  repeat with personRecord in matches
+   set countFound to countFound + 1
+   if countFound > 20 then exit repeat
+   set personId to id of personRecord as text
+   set personName to name of personRecord as text
+   set emailValues to value of emails of personRecord
+   set phoneValues to value of phones of personRecord
+   if resultText is not "[" then set resultText to resultText & ","
+   set resultText to resultText & "{" & quote & "id" & quote & ":" & my jsonText(personId) & "," & quote & "name" & quote & ":" & my jsonText(personName) & "," & quote & "emails" & quote & ":" & my jsonList(emailValues) & "," & quote & "phones" & quote & ":" & my jsonList(phoneValues) & "}"
+  end repeat
+ end tell
+ return "{" & quote & "contacts" & quote & ":" & resultText & "]," & quote & "truncated" & quote & ":" & (countFound > 20) & "}"
+end run
+`;
+
+export const mailScript=String.raw`
+on run argv
+ set recipientAddress to item 1 of argv
+ set messageText to item 2 of argv
+ set subjectText to item 3 of argv
+ set deliveryMode to item 4 of argv
+ tell application "Mail"
+  set invitationMessage to make new outgoing message with properties {subject:subjectText, content:messageText, visible:true}
+  tell invitationMessage
+   make new to recipient at end of to recipients with properties {address:recipientAddress}
+  end tell
+  if deliveryMode is "submit" then
+   set submitted to send invitationMessage
+   if submitted is false then error "Mail did not confirm submission."
+   return "submitted"
+  end if
+  activate
+  return "composer"
+ end tell
+end run
+`;
+
+export const messagesScript=String.raw`
+on run argv
+ set recipientAddress to item 1 of argv
+ set messageText to item 2 of argv
+ tell application "Messages"
+  set availableServices to every service whose service type is iMessage
+  if (count of availableServices) is not 1 then error "Choose one active iMessage account in Messages before sending."
+  set invitationService to item 1 of availableServices
+  set recipientBuddy to buddy recipientAddress of invitationService
+  send messageText to recipientBuddy
+  return "submitted"
+ end tell
+end run
