+      }catch{/* Durable owner-visible source status is the retry receipt. */}
+    }
+  }
+  async close(){await this.mutations.catch(()=>{});for(const entry of this.active.values())entry.controller.abort();await Promise.allSettled([...this.active.values()].map(e=>e.promise));await this.writes;}
+}
diff --git a/apps/commonplace/server/mcp-resource-tools.mjs b/apps/commonplace/server/mcp-resource-tools.mjs
new file mode 100644
index 0000000..397d533
--- /dev/null
+++ b/apps/commonplace/server/mcp-resource-tools.mjs
@@ -0,0 +1,17 @@
+const id={type:'string',pattern:'^[a-f0-9]{24}$'};
+const tool=(name,description,properties={},required=[],write=false)=>({name,description,inputSchema:{type:'object',properties,required,additionalProperties:false},annotations:{readOnlyHint:!write,destructiveHint:name==='remove_mcp_resource_source',openWorldHint:write}});
+const ownerRequested={type:'boolean',const:true,description:'The owner explicitly requested this source configuration or removal; peer requests cannot grant consent.'};
+export const mcpResourceTools=[
+  tool('list_mcp_resource_sources','Read private upstream MCP source configuration and capture status for the current account on this native installation. No provider is contacted. Resources remain private under existing sharing rules.'),
+  tool('configure_mcp_resource_source','Only on the owner’s explicit request, add one selected upstream HTTP MCP resource endpoint to private My context or update its pause/exclusion settings. Supports public HTTPS or explicit numeric loopback HTTP. Never scan host configs, execute provider tools or put credentials in URLs. tokenEnv is a local environment variable NAME, never a token. Connection is not capture completion. Existing source endpoint/auth references are immutable; add a new source to change them.',{ownerRequested,sourceId:id,label:{type:'string',minLength:1,maxLength:120},endpoint:{type:'string',maxLength:2000},tokenEnv:{type:'string',pattern:'^[A-Z_][A-Z0-9_]{0,127}$'},enabled:{type:'boolean'},excludedResourceIds:{type:'array',items:id,maxItems:200}},['ownerRequested'],true),
+  tool('sync_mcp_resource_source','Start background retrieval of resources/list and bounded text resources/read from one owner-configured source using the native installation, then publish complete captures to the owner’s private collection. Returns promptly while capture is running; use list_mcp_resource_sources for actual completion receipts. No arbitrary tools, redirects or interactive OAuth are executed. Inspect returned state for partial/failed capture.',{sourceId:id},['sourceId'],true),
+  tool('remove_mcp_resource_source','Only on the owner’s explicit request, stop an upstream source and exclude its imported resources from the private canonical collection. Remote cleanup failures stay pending for retry; removed is reported only after server exclusion receipts. Already shared excerpts cannot be recalled.',{sourceId:id,ownerRequested},['sourceId','ownerRequested'],true),
+];
+export async function mcpResourceCall(app,name,args){
+  const collector=app?.mcpResourceIngestion;if(!collector)throw Error('Update the native Meet Proxy runtime to manage upstream MCP resource sources.');
+  if(name==='list_mcp_resource_sources')return collector.list();
+  if(name==='configure_mcp_resource_source')return collector.configure(args);
+  if(name==='sync_mcp_resource_source')return collector.sync({...args,wait:false});
+  if(name==='remove_mcp_resource_source')return collector.remove(args);
+  throw Error('Unknown resource source action.');
+}
diff --git a/apps/commonplace/server/mcp-resource-transport-source.mjs b/apps/commonplace/server/mcp-resource-transport-source.mjs
new file mode 100644
index 0000000..ef02426
--- /dev/null
+++ b/apps/commonplace/server/mcp-resource-transport-source.mjs
@@ -0,0 +1,71 @@
+import {lookup as dnsLookup} from 'node:dns/promises';
+import {isIP} from 'node:net';
+import http from 'node:http';
+import https from 'node:https';
+import {Client,StreamableHTTPClientTransport} from '@modelcontextprotocol/client';
+
+// Native-only, explicitly selected endpoint. No host config discovery, process
+// launch, OAuth discovery, redirect following, cookies or ambient credentials.
+export function mcpResourceEndpoint(value){
+  if(typeof value!=='string'||value.length>2000||/[\x00-\x20\x7f]/.test(value))throw Error('Choose an MCP HTTPS endpoint or an explicit loopback HTTP endpoint.');
+  let url;try{url=new URL(value);}catch{throw Error('Invalid MCP endpoint.');}
+  if(url.username||url.password||url.search||url.hash)throw Error('MCP endpoint URLs cannot contain credentials, query strings or fragments.');
+  const host=url.hostname.replace(/^\[|\]$/g,'');
+  if(!(['https:'].includes(url.protocol)||url.protocol==='http:'&&['127.0.0.1','::1'].includes(host)))throw Error('Use HTTPS, or HTTP on 127.0.0.1 or [::1].');
+  if(url.protocol==='https:'&&isIP(host)&&!publicAddress(host))throw Error('HTTPS endpoints must use public addresses. Use explicit HTTP loopback for a local server.');
+  return url;
+}
+export function publicAddress(address){
+  if(isIP(address)===4){
+    const [a,b,c]=address.split('.').map(Number);
+    return !(a===0||a===10||a===127||a>=224||a===100&&b>=64&&b<=127||a===169&&b===254||a===172&&b>=16&&b<=31||a===192&&(b===168||b===0||b===2)||a===198&&(b===18||b===19||b===51&&c===100)||a===203&&b===0&&c===113);
+  }
+  // Public IPv6 unicast only; mapped IPv4, ULA, link-local, multicast and
+  // transition/documentation ranges are deliberately unavailable.
+  if(isIP(address)!==6||!/^[23][a-f0-9]{3}:/i.test(address)||/^2002:/i.test(address))return false;
+  const [first,second]=address.split(':');
+  return first.toLowerCase()!=='2001'||parseInt(second||'0',16)>=0x200&&parseInt(second,16)!==0xdb8;
+}
+export function mcpResourceFetch(endpoint,{tokenEnv,env=process.env,lookup=dnsLookup,maxBytes=1_000_000,timeoutMs=10000}={}){
+  const selected=mcpResourceEndpoint(endpoint);
+  if(tokenEnv!==undefined&&(typeof tokenEnv!=='string'||! /^[A-Z_][A-Z0-9_]{0,127}$/.test(tokenEnv)))throw Error('Choose a local environment variable name for the bearer token.');
+  return async(input,init={})=>{
+    const target=new URL(input instanceof Request?input.url:String(input));
+    if(target.href!==selected.href)throw Error('MCP request left the selected endpoint.');
+    const method=init.method||'GET';
+    // No background SSE channel is needed for a one-shot resource capture.
+    if(method==='GET')return new Response(null,{status:405});
+    if(!['POST','DELETE'].includes(method))throw Error('Unsupported MCP transport method.');
+    const host=selected.hostname.replace(/^\[|\]$/g,''),loopback=selected.protocol==='http:';
+    const addresses=isIP(host)?[{address:host,family:isIP(host)}]:await lookup(host,{all:true,verbatim:true});
+    if(!addresses.length||!loopback&&addresses.some(a=>!publicAddress(a.address)))throw Error('MCP endpoint resolved to a non-public address.');
+    const pinned=addresses[0],headers=new Headers(init.headers);
+    headers.delete('cookie');headers.delete('authorization');headers.delete('proxy-authorization');headers.delete('host');
+    if(tokenEnv){const token=env[tokenEnv];if(typeof token!=='string'||!token||token.length>8192||/[\x00-\x20\x7f]/.test(token))throw Error('The selected local token environment variable is unavailable or invalid.');headers.set('authorization','Bearer '+token);}
+    const body=init.body==null?null:typeof init.body==='string'?init.body:null;
+    if(init.body!=null&&body===null||body&&Buffer.byteLength(body)>64000)throw Error('MCP request exceeds transport limits.');
+    const signal=AbortSignal.any([AbortSignal.timeout(timeoutMs),...(init.signal?[init.signal]:[])]);
+    // Resolve before connecting and pin that validated address in the socket's
+    // lookup callback. DNS cannot change the destination after the SSRF check.
+    return new Promise((resolve,reject)=>{
+      const request=(selected.protocol==='https:'?https:http).request(selected,{method,headers:Object.fromEntries(headers),agent:false,signal,
+        lookup:(_hostname,options,callback)=>options.all?callback(null,[pinned]):callback(null,pinned.address,pinned.family)},response=>{
+        const status=response.statusCode||500;
+        if(status>=300&&status<400){response.destroy();reject(Error('MCP redirects are not allowed. Select the final endpoint explicitly.'));return;}
+        if(Number(response.headers['content-length']||0)>maxBytes){response.destroy();reject(Error('MCP response exceeds the capture limit.'));return;}
+        const chunks=[];let bytes=0;
+        response.on('data',chunk=>{bytes+=chunk.length;if(bytes>maxBytes){response.destroy(Error('MCP response exceeds the capture limit.'));return;}chunks.push(chunk);});
+        response.on('error',reject);
+        response.on('end',()=>resolve(new Response([204,205,304].includes(status)?null:Buffer.concat(chunks),{status,headers:response.headers})));
+      });
+      request.on('error',reject);request.end(body);
+    });
+  };
+}
+export async function connectMcpResources(source,options={}){
+  const client=new Client({name:'meet-proxy-private-resource-collector',version:'1'},{capabilities:{},listMaxPages:1});
+  const transport=new StreamableHTTPClientTransport(new URL(source.endpoint),{fetch:mcpResourceFetch(source.endpoint,{...options,tokenEnv:source.tokenEnv}),requestInit:{redirect:'error'}});
+  try{await client.connect(transport,{signal:options.signal,timeout:options.timeoutMs||10000});}
+  catch(error){await client.close().catch(()=>{});throw error;}
+  return {list:params=>client.request({method:'resources/list',params},{signal:options.signal,timeout:options.timeoutMs||10000}),read:uri=>client.readResource({uri},{cacheMode:'bypass',signal:options.signal,timeout:options.timeoutMs||10000}),close:()=>client.close()};
+}
