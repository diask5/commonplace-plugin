+      }
+    }
+  }
+  if(!documentId||documentId.startsWith('work-')){
+    for(const t of db.prepare('SELECT id,prompt,result,updated_at FROM cp_cloud_tasks WHERE owner=? AND result IS NOT NULL AND prompt<>? AND (? IS NULL OR id=?) ORDER BY id').iterate(owner,setupCheckPrompt,documentId?.slice(5)??null,documentId?.slice(5)??null)){
+      const result=JSON.parse(t.result);
+      yield {doc:{id:'work-'+t.id,kind:'cloud-task',title:t.prompt.slice(0,160)},section:{id:'task_'+t.id,body:'User request:\n'+t.prompt+'\n\nCloud work result ('+result.kind+'):\n'+result.text+'\n\nCitations: '+(result.citations||[]).join(', '),captured_at:t.updated_at,synced_at:t.updated_at},position:0};
+    }
+  }
