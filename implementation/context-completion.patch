+            if(!await this.send(source,key,{...base,state:'current',messages:[]},identity,generation,{lastCheckedAt:this.now(),status:'current'}))partial=true;
+            continue;
+          }
+          const provenance=`MCP resource: ${source.label}\nOrigin: ${new URL(source.endpoint).origin}\nResource: ${r.resource}\nCaptured: ${new Date(observed).toISOString()}\n\n`;
+          const messages=[];if(text)text=provenance+text;
+          for(let offset=0;text&&offset<text.length;){let end=Math.min(offset+7000,text.length);if(end<text.length&&/[\uD800-\uDBFF]/.test(text[end-1])&&/[\uDC00-\uDFFF]/.test(text[end]))end--;messages.push({id:'resource:'+offset,role:'user',text:text.slice(offset,end),position:offset,modifiedAt:observed});offset=end;}
