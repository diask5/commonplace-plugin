+export const archiveDocumentId=/^(?:native|chatgpt|work|unified|thread|context)-[a-f0-9]{24}$/;
+
+// One authoritative projection for file materialization and bounded live reads.
+// A selected read never waits for unrelated filesystem/index reconciliation.
+// Call inside a read transaction so metadata, authority and bytes agree.
+export function* archiveSections(db,owner,{now=Date.now(),documentId}={}){
+  if(documentId!==undefined&&!archiveDocumentId.test(documentId))throw Error('Conversation is not in this account archive.');
+  if(!documentId||documentId.startsWith('native-')){
+    const columns=documentId?'s.id,s.source_key,s.device,s.title':'s.*';
+    for(const metadata of db.prepare('SELECT '+columns+' FROM cp_cloud_sources s WHERE owner=? AND '+legacyVisibleSql+' ORDER BY device,source_key').iterate(owner)){
