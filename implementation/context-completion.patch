+      yield {doc:{id,kind:s.title.startsWith('Codex chats:')||s.title.startsWith('Archived Codex chats:')||s.title.startsWith('Conductor Codex chats:')?'codex':'claude',title:s.title.replace(/ · \d+$/,''),device:s.device},section:s,position:key?Number(key[2]):0};
+    }
+  }
+  if(!documentId||documentId.startsWith('chatgpt-')){
+    for(const d of db.prepare('SELECT * FROM cp_context_documents WHERE owner=? AND (? IS NULL OR id=?) ORDER BY id').iterate(owner,documentId?.slice(8)??null,documentId?.slice(8)??null)){
+      const chunks=db.prepare('SELECT * FROM cp_context_chunks WHERE document=? AND owner=?').all(d.id,owner),byId=new Map(chunks.map(s=>[s.id,s]));
+      for(let i=0;i<chunks.length;i++){
+        const section=byId.get(hash(d.id+':'+i).slice(0,24));if(!section)throw Error('Incomplete imported conversation.');
