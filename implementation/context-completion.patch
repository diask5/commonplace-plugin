+  if(!documentId||documentId.startsWith('thread-')||documentId.startsWith('context-'))yield* new WorkspaceNetwork(db,{now:()=>now}).sections(owner,documentId);
+}
+
+export function readArchiveDocument(db,owner,input,{now=Date.now()}={}){
+  if(!/^[a-f0-9]{24}$/.test(owner))throw Error('Invalid archive owner.');
+  if(!input||typeof input!=='object'||Array.isArray(input)||Object.keys(input).some(k=>!['documentId','revision','offset','limit'].includes(k)))throw Error('Unknown archive argument.');
+  if(typeof input.documentId!=='string'||!archiveDocumentId.test(input.documentId))throw Error('Conversation is not in this account archive.');
+  const revision=db.prepare('SELECT revision FROM cp_cloud_archive_state WHERE owner=?').get(owner)?.revision??0;
+  if(input.revision!==undefined&&input.revision!==revision)return {value:{changed:true,revision,restart:true}};
+  const rows=[...archiveSections(db,owner,{now,documentId:input.documentId})].sort((a,b)=>a.position-b.position||a.section.id.localeCompare(b.section.id));
+  if(!rows.length)throw Error('Conversation is not in this account archive.');
+  const totalCharacters=rows.reduce((sum,row)=>sum+row.section.body.length,0),offset=input.offset===undefined?0:input.offset,limit=input.limit===undefined?12000:input.limit;
+  if(!Number.isSafeInteger(offset)||offset<0||offset>totalCharacters||!Number.isSafeInteger(limit)||limit<1||limit>16000)throw Error('Invalid page offset or size.');
