+ {name:'lookup_invitation_contact',description:'Only when the owner asks to invite a local contact, look up that name in macOS Contacts. Results stay local. Multiple people or addresses require the owner to choose; never infer a recipient from a name. macOS Contacts/TCC and host approvals still apply. No invitation is sent.',inputSchema:{type:'object',properties:{query:{...string,maxLength:120},ownerRequested},required:['query','ownerRequested'],additionalProperties:false},annotations:{readOnlyHint:true,destructiveHint:false,openWorldHint:false}},
