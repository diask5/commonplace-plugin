+ el('close-mcp-source').onclick=()=>el('mcp-source-dialog').close();el('mcp-source-dialog').addEventListener('close',()=>{if(trigger?.isConnected)trigger.focus();});
+ el('mcp-source-connect').onclick=()=>{el('mcp-source-dialog').close();onConnect();};
