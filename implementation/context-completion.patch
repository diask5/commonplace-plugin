+// Retrieval uses the account server's existing OAuth + Streamable HTTP MCP.
+// No host address, transcript ingestion, token, or delivery capability is invented.
+export function personalAssistantConnection(origin){
+ const url=new URL(origin);if(!['https:','http:'].includes(url.protocol)||url.username||url.password||url.pathname!=='/'||url.search||url.hash)throw Error('Use your Meet Proxy server origin.');
+ if(url.protocol==='http:'&&!['localhost','127.0.0.1','[::1]'].includes(url.hostname))throw Error('Use HTTPS for a remote MCP connection.');
+ const endpoint=url.origin+'/mcp';return {endpoint,resourceMetadata:url.origin+'/.well-known/oauth-protected-resource/mcp',authorizationMetadata:url.origin+'/.well-known/oauth-authorization-server',config:JSON.stringify({mcpServers:{'meet-proxy':{type:'http',url:endpoint}}},null,2),instructions:'In your assistant’s MCP/connector settings, add '+endpoint+' as a remote Streamable HTTP server. Choose OAuth, continue with your existing Meet Proxy account, and review the requested permissions. The host must support MCP OAuth discovery, dynamic client registration and PKCE S256. Finish any host-required approval or reload. Then ask the assistant to call archive_search and archive_read on an authorized result and report its actual receipt. This connects context retrieval. Native chat delivery and automatic history collection require a separately supported native integration; a successful sign-in or copied URL does not verify either.'};
+}
+
+export async function checkPersonalAssistantServer(origin,{fetcher=fetch,signal}={}){
+ const connection=personalAssistantConnection(origin);
+ const get=async url=>{const response=await fetcher(url,{credentials:'omit',redirect:'error',signal});if(!response.ok)throw Error('OAuth discovery unavailable ('+response.status+').');return response.json();};
+ const [resource,authorization]=await Promise.all([get(connection.resourceMetadata),get(connection.authorizationMetadata)]);
+ const expected=new URL(origin).origin;
+ if(resource.resource!==connection.endpoint||!resource.authorization_servers?.includes(expected)||authorization.issuer!==expected||!authorization.code_challenge_methods_supported?.includes('S256')||!authorization.response_types_supported?.includes('code'))throw Error('This server did not advertise a compatible OAuth MCP connection.');
+ for(const field of ['authorization_endpoint','token_endpoint','registration_endpoint'])if(new URL(authorization[field]).origin!==expected)throw Error('Unexpected OAuth server.');
+ return {state:'authorization-ready',endpoint:connection.endpoint,next:'Server discovery passed. Add this URL in your compatible assistant, authorize there, then verify a context search and read. This check does not attach an assistant.'};
+}
+
+export function personalAssistantSetup({getAccount=()=>null}={}){
+ const el=id=>document.getElementById(id);let epoch=0,controller=null,trigger=null;
+ const reset=()=>{epoch++;controller?.abort();controller=null;if(el('personal-assistant-dialog').open)el('personal-assistant-dialog').close();el('personal-assistant-help').open=false;el('personal-assistant-copy-status').textContent='';el('personal-assistant-status').textContent='';el('personal-assistant-check').disabled=false;};
+ const open=()=>{if(!getAccount())return;reset();trigger=document.activeElement;const data=personalAssistantConnection(location.origin);el('personal-assistant-endpoint').value=data.endpoint;el('personal-assistant-config').value=data.config;el('personal-assistant-instructions').textContent=data.instructions;el('personal-assistant-dialog').showModal();};
+ for(const button of document.querySelectorAll('[data-personal-assistant]'))button.onclick=open;
+ el('close-personal-assistant').onclick=()=>el('personal-assistant-dialog').close();el('personal-assistant-dialog').addEventListener('close',()=>{epoch++;controller?.abort();el('personal-assistant-check').disabled=false;if(trigger?.isConnected)trigger.focus();});
+ const copy=async id=>{try{await navigator.clipboard.writeText(el(id).value);el('personal-assistant-copy-status').textContent='Copied. Add it in your assistant and sign in.';}catch{el(id).focus();el(id).select();el('personal-assistant-copy-status').textContent='Select and copy the value above.';}};
+ el('personal-assistant-copy').onclick=()=>copy('personal-assistant-endpoint');el('personal-assistant-copy-config').onclick=()=>copy('personal-assistant-config');
+ el('personal-assistant-check').onclick=async()=>{const version=++epoch;controller?.abort();controller=new AbortController();const timer=setTimeout(()=>controller.abort(),10000);el('personal-assistant-check').disabled=true;el('personal-assistant-status').textContent='Checking OAuth discovery…';try{const result=await checkPersonalAssistantServer(location.origin,{signal:controller.signal});if(version===epoch)el('personal-assistant-status').textContent=result.next;}catch(error){if(version===epoch)el('personal-assistant-status').textContent=error.name==='AbortError'?'The discovery check timed out. Try again.':error.message;}finally{clearTimeout(timer);if(version===epoch)el('personal-assistant-check').disabled=false;}};
+ return {open,reset};
+}
