+  for(const {section} of rows){
+    if(position+section.body.length>offset&&text.length<limit){const from=Math.max(0,offset-position);text+=section.body.slice(from,from+limit-text.length);citations.push(section.id);}
+    position+=section.body.length;if(text.length>=limit)break;
+  }
+  const doc=rows[0].doc;
+  return {value:{documentId:doc.id,title:doc.title,kind:doc.kind,path:'documents/'+doc.id+'.txt',revision,offset,text,citations,nextOffset:offset+text.length<totalCharacters?offset+text.length:null,totalCharacters},expiresAt:new WorkspaceNetwork(db,{now:()=>now}).expiresAt(owner)};
+}
