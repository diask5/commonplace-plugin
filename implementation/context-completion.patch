+import {startUiPreview} from '../scripts/preview-ui.mjs';
+
+test('personal assistant setup contains a real remote MCP URL and truthful host capabilities',()=>{
+ const data=personalAssistantConnection('https://meet.example');assert.deepEqual(JSON.parse(data.config),{mcpServers:{'meet-proxy':{type:'http',url:'https://meet.example/mcp'}}});assert.match(data.instructions,/PKCE S256/);assert.match(data.instructions,/archive_search and archive_read/);assert.match(data.instructions,/separately supported native integration/);
+ for(const origin of ['javascript:bad','http://remote.example','https://user:pass@meet.example','https://meet.example/path'])assert.throws(()=>personalAssistantConnection(origin));
+});
+test('discovery verifies actual OAuth metadata without claiming authorization or host registration',async t=>{
+ const p=await startUiPreview();t.after(()=>p.close());p.service.origin=p.origin;p.service.resource=p.origin+'/mcp';
+ const fetcher=(url,options)=>p.service.handle(new Request(url,options));const result=await checkPersonalAssistantServer(p.origin,{fetcher});assert.equal(result.state,'authorization-ready');assert.match(result.next,/does not attach/);
+ const denied=await p.service.handle(new Request(p.origin+'/mcp',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({jsonrpc:'2.0',id:1,method:'tools/list'})}));assert.equal(denied.status,401);assert.match(denied.headers.get('WWW-Authenticate'),/oauth-protected-resource/);
+});
+test('compatible personal host completes existing DCR + PKCE OAuth then searches authorized context',async t=>{
+ const p=await startUiPreview();t.after(()=>p.close());const s=p.service;s.origin=p.origin;s.resource=p.origin+'/mcp';
+ const redirect_uri='http://127.0.0.1:14567/callback',client=await s.register({client_name:'Compatible personal assistant fixture',redirect_uris:[redirect_uri]}),verifier=randomBytes(32).toString('base64url'),challenge=createHash('sha256').update(verifier).digest('base64url');
+ const flow=await s.beginAuthorization({id:p.people.ready.owner},{client_id:client.client_id,redirect_uri,response_type:'code',state:'owner-controlled-state',code_challenge:challenge,code_challenge_method:'S256',resource:s.resource,scope:'commonplace:read'});
+ const approved=new URL(await s.approve({id:p.people.ready.owner},{flowId:flow.id,csrf:flow.csrf,consent:'allow'},flow.cookie,s.origin));
+ const tokens=await s.exchange({grant_type:'authorization_code',client_id:client.client_id,redirect_uri,resource:s.resource,code:approved.searchParams.get('code'),code_verifier:verifier});
+ const rpc=async(method,params)=>{const response=await s.handle(new Request(s.origin+'/mcp',{method:'POST',headers:{'content-type':'application/json',accept:'application/json',authorization:'Bearer '+tokens.access_token},body:JSON.stringify({jsonrpc:'2.0',id:1,method,params})}));assert.equal(response.status,200);return response.json();};
+ const listed=await rpc('tools/list');assert.ok(listed.result.tools.some(t=>t.name==='archive_search'));assert.ok(listed.result.tools.some(t=>t.name==='archive_read'));
+ const search=await rpc('tools/call',{name:'archive_search',arguments:{query:'release'}});assert.notEqual(search.result.isError,true,JSON.stringify(search));
+ const matches=JSON.parse(search.result.content[0].text);assert.ok(matches.results.length>0);const read=await rpc('tools/call',{name:'archive_read',arguments:{documentId:matches.results[0].documentId,revision:matches.revision}});assert.notEqual(read.result.isError,true,JSON.stringify(read));const page=JSON.parse(read.result.content[0].text);assert.ok(page.text.length>0);assert.ok(page.citations.length>0);
+ const write=await rpc('tools/call',{name:'run_cloud_task',arguments:{prompt:'Unapproved mutation',nonce:randomBytes(12).toString('hex')}});assert.equal(write.result.isError,true,'read-only OAuth does not silently grant writes');
+});
+test('discovery refuses foreign OAuth destinations and missing PKCE support',async()=>{
+ const origin='https://meet.example',resource={resource:origin+'/mcp',authorization_servers:[origin]},authorization={issuer:origin,response_types_supported:['code'],code_challenge_methods_supported:['S256'],authorization_endpoint:origin+'/authorize',token_endpoint:origin+'/oauth/token',registration_endpoint:'https://foreign.example/register'};
+ const fetcher=async url=>Response.json(url.includes('protected-resource')?resource:authorization);await assert.rejects(checkPersonalAssistantServer(origin,{fetcher}),/Unexpected OAuth/);authorization.registration_endpoint=origin+'/register';authorization.code_challenge_methods_supported=['plain'];await assert.rejects(checkPersonalAssistantServer(origin,{fetcher}),/compatible OAuth/);
