+ for(const button of document.querySelectorAll('[data-mcp-resource-source]'))button.onclick=open;
+ for(const id of ['mcp-source-label','mcp-source-endpoint','mcp-source-token-env'])el(id).oninput=render;
+ el('mcp-source-copy').onclick=()=>{render();if(!el('mcp-source-copy').disabled)return copy(el('mcp-source-prompt').value,el('mcp-source-prompt'));};
