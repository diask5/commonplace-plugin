diff --git a/tests/seamless-collection.test.mjs b/tests/seamless-collection.test.mjs
new file mode 100644
index 0000000..10b4742
--- /dev/null
+++ b/tests/seamless-collection.test.mjs
@@ -0,0 +1,183 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {mkdtemp,mkdir,writeFile,rm,utimes,appendFile} from 'node:fs/promises';
+import path from 'node:path';
+import {tmpdir} from 'node:os';
+import {CanonicalSync} from '../apps/commonplace/server/canonical-sync.mjs';
+
+const line=(session,id,text)=>JSON.stringify({sessionId:session,uuid:id,type:'user',message:{role:'user',content:text}})+'\n';
+async function fixture(t,{budget=6}={}){
+ const dir=await mkdtemp(path.join(tmpdir(),'seamless-')),root=path.join(dir,'chats');await mkdir(root);
+ t.after(()=>rm(dir,{recursive:true,force:true}));
+ const f={dir,root,uploads:[],clock:{now:Date.now()},fail:null,roots:[{path:root,name:'Claude chats',kind:'claude'}]};
+ f.app={dir,accountClient:{request:async(route,input)=>{
+  if(route.endsWith('/context-checkpoint'))return f.checkpoint;
+  f.uploads.push(structuredClone(input));
+  const failure=f.fail?.(input);if(failure)throw failure;
+  return {id:'stream-'+input.sourceKey.slice(0,6)};
+ }}};
+ f.sync=(extra={})=>new CanonicalSync(f.app,{budget,now:()=>f.clock.now,...extra});
+ f.chat=async(name,text,{age=0}={})=>{const file=path.join(root,name+'.jsonl');await writeFile(file,line(name,name+'-1',text));const when=new Date(Date.now()-age);await utimes(file,when,when);return file;};
+ f.titles=from=>f.uploads.slice(from).map(u=>u.conversation.id);
+ return f;
+}
+
+test('a new chat is not queued behind a full budget of unchanged heartbeats',async t=>{
+ const f=await fixture(t),sync=f.sync();
+ for(let i=0;i<10;i++)await f.chat('old'+String(i).padStart(2,'0'),'Old '+i,{age:3600000});
+ for(let i=0;i<3;i++){await sync.tick('owner',f.roots);f.clock.now+=1000;}
+ assert.equal(f.uploads.length,10,'initial history is collected in bounded ticks');
+ f.clock.now+=31000;
+ // Sorts before every old file under the previous lexicographic rotation.
+ await f.chat('aaa-new','Brand new chat');
+ const before=f.uploads.length,result=await sync.tick('owner',f.roots);
+ assert.equal(f.uploads[before].conversation.id,'aaa-new','fresh capture is the first upload');
+ assert.equal(result.sent.fresh,1);assert.equal(result.sent.heartbeat,5);
+ assert.equal(result.deferred.heartbeat,5);assert.equal(result.partial,false,'deferred heartbeats are not missing history');
+});
+
+test('a changed old chat and a new chat both beat heartbeats, newest first',async t=>{
+ const f=await fixture(t),sync=f.sync();
+ for(let i=0;i<8;i++)await f.chat('c'+i,'Chat '+i,{age:3600000});
+ await sync.tick('owner',f.roots);await sync.tick('owner',f.roots);
+ f.clock.now+=31000;
+ await f.chat('c7','Chat 7 edited',{age:5000});await f.chat('zzz','Newest',{age:0});
+ const before=f.uploads.length;await sync.tick('owner',f.roots);
+ assert.deepEqual(f.titles(before).slice(0,2),['zzz','c7']);
+});
+
+test('initial backfill leads with the newest chat and still serves the longest-waiting one',async t=>{
+ const f=await fixture(t,{budget:2}),sync=f.sync();
+ for(let i=0;i<6;i++)await f.chat('chat'+i,'Chat '+i,{age:(6-i)*60000});
+ const result=await sync.tick('owner',f.roots);
+ assert.deepEqual(f.titles(0),['chat5','chat0']);assert.equal(result.partial,true,'unsent fresh chats keep the tick partial');
+ assert.equal(result.deferred.fresh,4);
+});
+
+test('constant fresh traffic cannot starve heartbeats or an old backfill',async t=>{
+ const f=await fixture(t,{budget:2}),sync=f.sync();
+ await f.chat('steady','Steady',{age:3600000});
+ const big=path.join(f.root,'big.jsonl');
+ await writeFile(big,Array.from({length:120},(_,i)=>line('big','big-'+i,'Backfill message '+i)).join(''));
+ await utimes(big,new Date(Date.now()-3600000),new Date(Date.now()-3600000));
+ let counter=0,bigDone=false,steadyBeat=false;
+ for(let tick=0;tick<40&&!(bigDone&&steadyBeat);tick++){
+  f.clock.now+=31000;
+  await f.chat('fresh'+counter++,'Fresh '+tick);
+  const from=f.uploads.length;await sync.tick('owner',f.roots);
+  for(const u of f.uploads.slice(from)){if(u.conversation.id==='big'&&u.state==='current')bigDone=true;if(u.conversation.id==='steady'&&u.revision>1)steadyBeat=true;}
+ }
+ assert.ok(bigDone,'the continuing backfill finishes while new chats keep arriving');
+ assert.ok(steadyBeat,'unchanged sources still receive heartbeats');
+});
+
+test('a failed upload replays identically before any newer work and does not mark complete',async t=>{
+ const f=await fixture(t,{budget:3}),sync=f.sync();
+ await f.chat('old','Old',{age:600000});await f.chat('new','New');
+ f.fail=()=>Object.assign(Error('offline'),{status:503});
+ await assert.rejects(sync.tick('owner',f.roots),/offline/);
+ const first=f.uploads[0];f.fail=null;
+ await f.chat('newer','Newer than the failed upload');
+ const restarted=f.sync(),result=await restarted.tick('owner',f.roots);
+ assert.deepEqual(f.uploads[1],first,'exact retry precedes fresh work');
+ assert.equal(f.uploads[2].conversation.id,'newer');
+ assert.equal(result.partial,false);
+ assert.equal(new Set(f.uploads.slice(1).map(u=>u.conversation.id)).size,3);
+});
+
+test('an unreadable source is skipped without consuming upload budget or hiding other chats',async t=>{
+ const f=await fixture(t,{budget:1}),sync=f.sync();
+ await writeFile(path.join(f.root,'broken.json'),'{not json');
+ await utimes(path.join(f.root,'broken.json'),new Date(),new Date());
+ await f.chat('good','Readable',{age:100000});
+ const result=await sync.tick('owner',f.roots);
+ assert.deepEqual(f.titles(0),['good']);assert.equal(result.partial,true);
+ const calls=f.uploads.length;f.clock.now+=5000;const waiting=await sync.tick('owner',f.roots);
+ assert.equal(f.uploads.length,calls,'a just-failed source is not retried within the backoff');
+ assert.equal(waiting.partial,true,'backoff must not look current');assert.equal(waiting.backedOff,1);
+ f.clock.now+=31000;await writeFile(path.join(f.root,'broken.json'),JSON.stringify([{sessionId:'fixed',uuid:'f1',type:'user',message:{role:'user',content:'Now valid'}}]));
+ await sync.tick('owner',f.roots);assert.ok(f.titles(calls).includes('fixed'),'repair is collected as fresh work');
+});
+
+test('changing accounts discards another account\'s pending state and recollects only under the new owner',async t=>{
+ const f=await fixture(t,{budget:2}),sync=f.sync();
+ await f.chat('one','One');
+ f.fail=()=>Object.assign(Error('offline'),{status:503});
+ await assert.rejects(sync.tick('alice',f.roots),/offline/);
+ f.fail=null;const result=await f.sync().tick('bob',f.roots);
+ assert.equal(f.uploads.length,2);assert.equal(f.uploads[0].ownerId,'alice');assert.equal(f.uploads[1].ownerId,'bob');
+ assert.equal(result.sent.fresh,1,'no alice retry is replayed for bob');
+ assert.equal(JSON.parse(await (await import('node:fs/promises')).readFile(path.join(f.dir,'canonical-sync.json'),'utf8')).owner,'bob');
+});
+
+test('a restored relay checkpoint makes the source fresh and is recollected before heartbeats',async t=>{
+ const f=await fixture(t,{budget:2}),sync=f.sync();
+ for(let i=0;i<3;i++)await f.chat('s'+i,'Source '+i,{age:600000});
+ await sync.tick('owner',f.roots);await sync.tick('owner',f.roots);
+ f.clock.now+=31000;
+ let conflict=true;f.checkpoint={epoch:2,revision:9};
+ f.fail=input=>{if(conflict&&input.conversation.id==='s1'){conflict=false;return Object.assign(Error('stale'),{status:409});}};
+ const from=f.uploads.length;
+ for(let i=0;i<3;i++){await sync.tick('owner',f.roots);f.clock.now+=31000;}
+ const restored=f.uploads.slice(from).filter(u=>u.conversation.id==='s1'&&u.epoch===2);
+ assert.ok(restored.length>0,'source recollected with the restored epoch');assert.equal(restored[0].revision,10);
+});
+
+test('source heartbeats still report unchanged chats once the queue is clear',async t=>{
+ const f=await fixture(t),sync=f.sync();
+ await f.chat('quiet','Quiet',{age:600000});
+ await sync.tick('owner',f.roots);f.clock.now+=1000;
+ let result=await sync.tick('owner',f.roots);assert.equal(f.uploads.length,1,'nothing is resent before the heartbeat is due');assert.equal(result.partial,false);
+ f.clock.now+=31000;result=await sync.tick('owner',f.roots);
+ assert.equal(f.uploads.length,2);assert.equal(f.uploads[1].state,'current');assert.equal(result.sent.heartbeat,1);
+});
+
+test('a partial malformed capture stays partial through backoff and retries before heartbeats',async t=>{
+ const f=await fixture(t,{budget:1}),sync=f.sync(),file=path.join(f.root,'bad.jsonl');
+ await writeFile(file,line('bad','b1','Good first line')+'{not json\n');
+ await f.chat('calm','Calm',{age:600000});
+ let r=await sync.tick('owner',f.roots);r=await sync.tick('owner',f.roots);
+ assert.equal(f.uploads.filter(u=>u.conversation.id==='bad')[0].state,'partial');
+ assert.equal(r.partial,true);
+ const uploads=f.uploads.length;f.clock.now+=5000;r=await sync.tick('owner',f.roots);
+ assert.equal(f.uploads.length,uploads);assert.equal(r.partial,true,'same-version partial capture is not a heartbeat');assert.equal(r.backedOff,1);
+ f.clock.now+=31000;r=await sync.tick('owner',f.roots);
+ assert.equal(f.uploads[uploads].conversation.id,'bad','retry beats the due heartbeat of the calm chat');
+ assert.equal(r.sent.retry,1);assert.equal(r.partial,true,'still partial until a complete retry');
+ await appendFile(file,'');await writeFile(file,line('bad','b1','Good first line')+line('bad','b2','Repaired'));
+ f.clock.now+=31000;r=await sync.tick('owner',f.roots);
+ assert.equal(f.uploads.at(-1).state,'current');
+ await sync.tick('owner',f.roots);r=await sync.tick('owner',f.roots);assert.equal(r.partial,false);
+});
+
+test('a deferred retry keeps the tick partial even with no fresh work',async t=>{
+ const f=await fixture(t,{budget:1}),sync=f.sync();
+ for(const n of ['x','y'])await writeFile(path.join(f.root,n+'.json'),'{broken');
+ await sync.tick('owner',f.roots);await sync.tick('owner',f.roots);
+ f.clock.now+=31000;const r=await sync.tick('owner',f.roots);
+ assert.equal(r.partial,true);
+});
+
+test('bounded scans rotate through every file and never imply a source disappeared',async t=>{
+ const f=await fixture(t,{budget:6});
+ for(let i=0;i<7;i++)await f.chat('f'+i,'File '+i,{age:600000});
+ const sync=f.sync({maxScan:3});let r;
+ for(let i=0;i<4;i++){r=await sync.tick('owner',f.roots);f.clock.now+=1000;}
+ assert.equal(r.scanned,3);assert.equal(r.discovered,7);assert.equal(r.partial,true,'a capped scan is never complete');
+ assert.equal(new Set(f.uploads.map(u=>u.conversation.id)).size,7,'rotation reaches every file');
+ assert.equal(f.uploads.filter(u=>u.state==='unavailable').length,0,'unscanned files are not tombstoned');
+ f.clock.now+=60000;
+ await rm(path.join(f.root,'f0.jsonl'));
+ const capped=await sync.tick('owner',f.roots);
+ assert.equal(f.uploads.filter(u=>u.state==='unavailable').length,0,'no unavailable marking from a partial file set');
+ const full=f.sync();await full.tick('owner',f.roots);
+ assert.equal(f.uploads.filter(u=>u.state==='unavailable').length,1,'a complete scan still reports the missing source');
+ assert.equal(capped.partial,true);
+});
+
+test('an unreadable root never marks its previously collected chats unavailable',async t=>{
+ const f=await fixture(t),sync=f.sync();
+ await f.chat('kept','Kept',{age:600000});await sync.tick('owner',f.roots);
+ f.clock.now+=60000;const r=await sync.tick('owner',[{path:path.join(f.dir,'missing'),name:'Gone',kind:'claude'}]);
+ assert.equal(r.partial,true);assert.equal(f.uploads.filter(u=>u.state==='unavailable').length,0);
+});
