+// Manual benchmark (not part of npm test): node tests/seamless-retrieval-benchmark.mjs [conversations] [chars-per-conversation]
+import {randomBytes,createHash} from 'node:crypto';
+import {mkdtemp,rm} from 'node:fs/promises';
+import {tmpdir} from 'node:os';
+import path from 'node:path';
+import {performance} from 'node:perf_hooks';
+import {openDatabase} from '../apps/commonplace-account/server/sqlite.mjs';
+import {AccountService} from '../apps/commonplace-account/server/service.mjs';
+import {CloudWork} from '../apps/commonplace-account/server/cloud-work.mjs';
+import {CloudArchive} from '../apps/commonplace-account/server/cloud-archive.mjs';
+import {ArchiveTools} from '../apps/commonplace-account/server/archive-tools.mjs';
+import {sharedContext,warmSharedContext,closeSharedContext} from '../apps/commonplace-account/server/shared-context.mjs';
+import {ContextStore} from '../apps/commonplace-account/server/context-store.mjs';
+import {archiveSections,liveArchiveQuery} from '../apps/commonplace-account/server/archive-source.mjs';
+const N=Number(process.argv[2]||400),SIZE=Number(process.argv[3]||75000);
+const uid=()=>randomBytes(12).toString('hex'),ms=t=>Math.round(performance.now()-t),mb=n=>Math.round(n/1048576);
+let peak=0;const sampler=setInterval(()=>{peak=Math.max(peak,process.memoryUsage().rss);},20);
+const words=Array.from({length:3000},(_,i)=>'w'+(i*7919).toString(36));
+const rnd=(()=>{let s=1;return()=>(s=(s*1103515245+12345)&0x7fffffff)/0x7fffffff;})();
