+// The private browser handoff authorizes this installation and one real native
+// chat. Never put the token in a public web URL, status response, archive or shared message.
+export class ContextSetup extends CloudWork {
+ constructor(service,options){super(service,options);this.groups=new Groups(service);this.db.exec(`
+ CREATE TABLE IF NOT EXISTS cp_context_setups(hash TEXT PRIMARY KEY,owner TEXT NOT NULL,space TEXT,receiver_generation INTEGER,app TEXT NOT NULL,created_at INTEGER NOT NULL,expires_at INTEGER NOT NULL,device TEXT,session TEXT,claimed_at INTEGER,version TEXT);
+ CREATE TABLE IF NOT EXISTS cp_context_collectors(device TEXT PRIMARY KEY,owner TEXT NOT NULL,state TEXT NOT NULL,seen_at INTEGER NOT NULL,files INTEGER NOT NULL);
+ `);}
+ begin(owner,{token,groupId=null,app}){
+  const hash=digest(token);if(!['claude','codex','conductor'].includes(app))fail(400,'Choose your desktop app.');
+  const group=groupId?this.groups.describe(owner,groupId):null;
+  return this.tx(()=>{const prior=this.get('SELECT * FROM cp_context_setups WHERE hash=?',hash);
+   if(prior&&(prior.owner!==owner||prior.space!==groupId||prior.app!==app))fail(409,'This setup request is already in use.');
+   if(!prior){this.run('DELETE FROM cp_context_setups WHERE expires_at<?',this.now()-86400000);this.run('INSERT INTO cp_context_setups(hash,owner,space,receiver_generation,app,created_at,expires_at) VALUES(?,?,?,?,?,?,?)',hash,owner,groupId,group?.generation??null,app,this.now(),this.now()+1800000);}
+   return {expiresAt:prior?.expires_at??this.now()+1800000};
+  });
+ }
+ async claim(device,input){
+  const hash=digest(input.token);
+  if(device.workspaceId||input.verified!==true||!['Claude','Codex'].includes(input.provider)||!/^[a-f0-9]{24}$/.test(input.sessionId||''))fail(403,'Use the installed plugin in your actual native chat.');
+  if(!/^\d+\.\d+\.\d+(?:[-.][a-zA-Z0-9.-]+)?$/.test(input.pluginVersion||''))fail(400,'Update your plugin and retry setup.');
+  const result=this.tx(()=>{
+   const source=this.service.mailboxes.device(device),grant=this.get('SELECT * FROM cp_context_setups WHERE hash=?',hash);
+   if(!grant||grant.expires_at<=this.now())fail(410,'This setup request expired. Reopen setup in the browser; your sign-in is preserved.');
+   const account=this.get("SELECT id,name,email FROM cp_profiles WHERE id=? AND subject NOT LIKE 'agent-host:%'",grant.owner);
+   if(!account)fail(403,'The signed-in account is unavailable.');
+   const existing=this.service.mailboxes.identity(source);
+   if(existing&&existing.id!==account.id)fail(409,'This installation belongs to another Google account. Your existing connection has not changed.');
+   if(grant.device&&(grant.device!==source.id||grant.session!==input.sessionId))fail(409,'Another chat already used this setup request. Keep the original chat.');
+   if(grant.app==='codex'&&input.provider!=='Codex'||grant.app==='claude'&&input.provider!=='Claude'||grant.app==='conductor'&&input.host!=='conductor')fail(409,'This is a different app. Choose it in browser setup first.');
+   const actor={...source,owner:account.id},nativeKey=this.service.personInbox.identity(actor,input);
+   const route=grant.space?(this.groups.member(account.id,grant.space),this.get('SELECT * FROM cp_group_receivers WHERE workspace=? AND owner=?',grant.space,account.id)):null;
+   if(route&&route.generation!==grant.receiver_generation&&route.session!==nativeKey)fail(409,'Your space chat changed. Reopen setup before connecting another chat.');
