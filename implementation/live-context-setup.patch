+  if(!device||this.service.mailboxes.owner(device)!==owner)return {...base,disconnected:true};
+  const nativeKey=this.service.personInbox.identity({...device,owner},{sessionId:grant.session,provider:'Codex'});
+  const session=this.get('SELECT * FROM cp_inbox_sessions WHERE id=? AND owner=?',nativeKey,owner);
+  if(!session)return {...base,disconnected:true};
+  // Agent Auth uses separate scoped device records for one installation.
+  const installationIds=new Set((device.client==='agent-auth'?this.all("SELECT id FROM cp_devices WHERE client='agent-auth' AND owner=? AND revoked=0",device.owner):[device]).map(d=>d.id));
