+   const active=unified.activeOrigins(s.id);if(!active.length)return false;
+   // Check visibility without loading transcript bodies into a status response.
+   return !!this.get(`SELECT 1 FROM cp_context_events e JOIN cp_context_event_origins p USING(stream,message,version,digest)
+     WHERE e.stream=? AND e.deleted=0 AND (${active.map(()=>'(p.device=? AND p.source_key=?)').join(' OR ')})
+     AND NOT EXISTS(SELECT 1 FROM cp_context_events newer WHERE newer.stream=e.stream AND newer.message=e.message AND (newer.version>e.version OR (newer.version=e.version AND newer.deleted=1))) LIMIT 1`,s.id,...active.flatMap(o=>[o.device,o.source_key]));
+  }).length:0;
+  const collector=this.all('SELECT device,state,seen_at AS seenAt,files FROM cp_context_collectors WHERE owner=? ORDER BY seen_at DESC',owner).find(c=>installationIds.has(c.device));
+  const route=grant.space?this.get('SELECT session FROM cp_group_receivers WHERE workspace=? AND owner=?',grant.space,owner):null;
+  return {...base,linked:true,version:grant.version,chat:this.groups.session(session),spaceLinked:!grant.space||route?.session===nativeKey,syncEnabled:!!this.get('SELECT sync_enabled FROM cp_cloud_settings WHERE owner=?',owner)?.sync_enabled,collector:collector?{state:collector.state,seenAt:collector.seenAt,files:collector.files,online:collector.seenAt>this.now()-30000}:null,receipts,searchableConversations:ready};
+ }
+}
