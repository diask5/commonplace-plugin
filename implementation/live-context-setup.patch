+  const origins=streams.flatMap(s=>unified.activeOrigins(s.id).filter(o=>installationIds.has(o.device)));
+  const receipts={conversations:streams.length,lastReceivedAt:origins.reduce((n,o)=>Math.max(n,o.seen_at),0)||null,partial:origins.some(o=>o.state!=='current')};
