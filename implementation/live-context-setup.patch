+   this.run('INSERT OR IGNORE INTO cp_inbox_sessions(id,owner,device,session,provider,host,machine,label,delivery,seen,active_at) VALUES(?,?,?,?,?,?,?,?,?,?,0)',nativeKey,account.id,source.id,input.sessionId,input.provider,clean(input.host,'unknown'),clean(input.machine,'Unknown computer'),clean(input.label,'Connected chat'),['native','hook','prompt'].includes(input.delivery)?input.delivery:'prompt',this.now());
+   if(!grant.claimed_at){
+    this.run('INSERT INTO cp_cloud_settings VALUES(?,1) ON CONFLICT(owner) DO UPDATE SET sync_enabled=1',account.id);
+    if(route)this.run('UPDATE cp_group_receivers SET session=?,generation=generation+CASE WHEN session IS ? THEN 0 ELSE 1 END WHERE workspace=? AND owner=?',nativeKey,nativeKey,grant.space,account.id);
+   }
+   this.run('UPDATE cp_context_setups SET device=?,session=?,claimed_at=COALESCE(claimed_at,?),version=? WHERE hash=?',source.id,input.sessionId,this.now(),input.pluginVersion,hash);
+   this.run('DELETE FROM cp_installation_links WHERE device=?',source.id);
