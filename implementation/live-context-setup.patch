+  return {account:result.account,groupId:result.groupId,sessionId:result.sessionId,linked:true,syncEnabled:!!this.get('SELECT sync_enabled FROM cp_cloud_settings WHERE owner=?',result.account.id)?.sync_enabled,serverOrigin:this.service.origin};
