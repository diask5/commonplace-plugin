+ f.session.delivery='prompt';let now=100000;t.mock.method(Date,'now',()=>now);
+ const root=path.join(f.dir,'conductor-receivers',f.session.sessionId),file=path.join(root,'status.json'),lock=path.join(root,'receiver.lock');
+ await mkdir(root,{recursive:true});await writeFile(lock,String(process.pid));
+ const checkpoint={pid:process.pid,revision:RUNTIME_REVISION,at:now,state:'ready',phase:'waiting',lastFailure:null,lastSubmission:null,hostSession:env.CONDUCTOR_SESSION_ID};
+ await writeFile(file,JSON.stringify(checkpoint));const before=await readFile(file,'utf8');
+ const status=()=>setupStatus({...f,env});
+ let r=await status();assert.equal(r.nativeChat.receiver,'ready');assert.equal(r.nativeChat.automaticDelivery,true);
+ now+=19999;r=await status();assert.equal(r.nativeChat.automaticDelivery,true);
+ now++;r=await status();assert.equal(r.nativeChat.receiver,'stale');assert.equal(r.nativeChat.automaticDelivery,false);
+ assert.equal(r.nativeChat.receiverLastCheckedAt,checkpoint.at);assert.equal(r.nativeChat.receiverCheckAgeMs,20000);
+ assert.match(r.nextSteps.join(' '),/may be finishing a poll/);assert.match(r.nextSteps.join(' '),/unconfirmed/);
+ assert.doesNotMatch(r.nextSteps.join(' '),/configure-codex|helper|reinstall|reconnect|not available here|has stopped/i);
+ now+=3000;r=await status();assert.equal(r.nativeChat.receiver,'stale');assert.equal(r.nativeChat.automaticDelivery,false);assert.equal(r.nativeChat.receiverCheckAgeMs,23000);
+ assert.equal(await readFile(file,'utf8'),before);assert.equal(await readFile(lock,'utf8'),String(process.pid),'setup never renews receiver evidence');
+ now=checkpoint.at+52820;await writeFile(file,JSON.stringify({...checkpoint,at:now}));
+ r=await status();assert.equal(r.nativeChat.receiver,'ready');assert.equal(r.nativeChat.automaticDelivery,true);assert.deepEqual(r.nextSteps,[]);
+ assert.doesNotMatch(JSON.stringify(r),/PRIVATE_/);
+});
+test('Conductor stale-checkpoint guidance never masks old runtime, dead locks, startup or failures',async t=>{
+ for(const scenario of ['old-runtime','dead-pid','lock-mismatch','stopped','failed','startup','wrong-host','unverified'])await t.test(scenario,async t=>{
+  const f=await fixture(t),env={CONDUCTOR_IS_LOCAL:'0',CONDUCTOR_SESSION_ID:'11111111-1111-4111-8111-111111111111'},now=100000;
+  f.session.delivery='prompt';t.mock.method(Date,'now',()=>now);
+  const root=path.join(f.dir,'conductor-receivers',f.session.sessionId);await mkdir(root,{recursive:true});
+  const checkpoint={pid:process.pid,revision:RUNTIME_REVISION,at:now-23000,state:'ready',phase:'waiting',lastFailure:null,hostSession:env.CONDUCTOR_SESSION_ID};let lock=process.pid;
+  if(scenario==='old-runtime')checkpoint.revision--;
+  if(scenario==='dead-pid')checkpoint.pid=lock=2147483647;
+  if(scenario==='lock-mismatch')lock=2147483647;
+  if(scenario==='stopped')checkpoint.state='stopped';
+  if(scenario==='failed'){checkpoint.state='reconnecting';checkpoint.lastFailure={phase:'mailbox',at:now-23000};}
+  if(scenario==='startup')checkpoint.state='starting';
+  if(scenario==='wrong-host')checkpoint.hostSession='22222222-2222-4222-8222-222222222222';
+  if(scenario==='unverified')f.session.verified=false;
+  await writeFile(path.join(root,'receiver.lock'),String(lock));await writeFile(path.join(root,'status.json'),JSON.stringify(checkpoint));
+  const r=await setupStatus({...f,env});assert.equal(r.nativeChat.automaticDelivery,false);assert.notEqual(r.nativeChat.receiver,'stale');
+  assert.equal(r.nativeChat.receiverLastCheckedAt,undefined);assert.doesNotMatch(r.nextSteps.join(' '),/may be finishing a poll/);
+  if(scenario==='old-runtime')assert.equal(r.nativeChat.receiver,'upgrade-required');
+  if(scenario==='dead-pid'||scenario==='lock-mismatch'||scenario==='stopped')assert.equal(r.nativeChat.receiver,'stopped');
+  if(scenario==='failed')assert.equal(r.nativeChat.receiver,'reconnecting');
+  if(scenario==='startup')assert.equal(r.nativeChat.receiver,'starting');
+  if(scenario==='unverified')assert.match(r.nextSteps.join(' '),/verified native chat identity/);
+ });
+});
