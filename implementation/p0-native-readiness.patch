+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {spawn} from 'node:child_process';
+import {createInterface} from 'node:readline';
+import {mkdtemp,rm} from 'node:fs/promises';
+import path from 'node:path';
+import {tmpdir} from 'node:os';
+import {createCodexRequestBinding} from '../apps/commonplace/server/native-session.mjs';
+const first='01234567-89ab-7cde-8f01-234567890abc',second='01234567-89ab-7cde-8f01-234567890def';
+const metadata=(id=first)=>({threadId:id,sessionId:id,'x-codex-turn-metadata':{thread_id:id,session_id:id,sandbox_mode:'danger-full-access'}});
+test('Codex transport identity requires matching host fields and cannot replace an established chat',()=>{
+ const bind=createCodexRequestBinding();assert.equal(bind({clientInfo:{name:'Codex'},arguments:{_meta:metadata()}}),null);
+ assert.equal(bind(metadata()),first);assert.equal(bind(metadata()),first);
+ assert.throws(()=>bind(metadata(second)),/different native chat/);assert.throws(()=>bind({}),/omitted/);
+ const old=createCodexRequestBinding({provider:'Codex',nativeId:first});assert.equal(old(),null);assert.throws(()=>old(metadata(second)),/different native chat/);assert.equal(old(metadata()),first);
+ assert.throws(()=>createCodexRequestBinding({provider:'Claude',nativeId:first})(metadata()),/provider mismatch/);
+ for(const meta of [{...metadata(),threadId:'invalid'},{...metadata(),sessionId:second},{...metadata(),'x-codex-turn-metadata':{thread_id:second,session_id:first}}])assert.throws(()=>createCodexRequestBinding()(meta),/metadata/);
+});
+async function stdio(t){
+ const dir=await mkdtemp(path.join(tmpdir(),'codex-protocol-'));const env={...process.env,COMMONPLACE_DATA_DIR:dir,COMMONPLACE_DISABLE_BACKGROUND:'1'};
+ for(const key of Object.keys(env))if(key.startsWith('CLAUDE_')||key.startsWith('CONDUCTOR_')||key.startsWith('CODEX_'))delete env[key];
+ const root=process.env.COMMONPLACE_TEST_PLUGIN,exe=root?path.join(root,'runtime/node'):process.execPath,script=root?path.join(root,'server/plugin.mjs'):path.resolve('apps/commonplace/server/plugin.mjs');
+ const child=spawn(exe,[script],{env,stdio:['pipe','pipe','pipe']});let stderr='';child.stderr.on('data',b=>stderr+=b);const pending=new Map();let id=0;
+ const lines=createInterface({input:child.stdout});lines.on('line',line=>{const v=JSON.parse(line);pending.get(v.id)?.resolve(v);pending.delete(v.id);});
+ child.on('exit',()=>{for(const p of pending.values())p.reject(Error('Plugin exited: '+stderr));});
+ t.after(async()=>{child.stdin.end();await new Promise(resolve=>{if(child.exitCode!==null)return resolve();const timer=setTimeout(()=>child.kill('SIGTERM'),3000);child.once('exit',()=>{clearTimeout(timer);resolve();});});lines.close();await rm(dir,{recursive:true,force:true});});
+ const call=(method,params)=>new Promise((resolve,reject)=>{const next=++id;pending.set(next,{resolve,reject});child.stdin.write(JSON.stringify({jsonrpc:'2.0',id:next,method,params})+'\n');});
+ const init=await call('initialize',{protocolVersion:'2025-11-25',capabilities:{},clientInfo:{name:'Codex',version:'test'}});assert.ok(init.result);child.stdin.write(JSON.stringify({jsonrpc:'2.0',method:'notifications/initialized'})+'\n');
+ return {call,dir};
+}
+test('actual native stdio binds per-call Codex metadata before setup and rejects later missing or foreign identity',{timeout:15000},async t=>{
+ const f=await stdio(t),setup=meta=>f.call('tools/call',{name:'setup_status',arguments:{},...(meta?{_meta:meta}:{})});
+ let r=await setup();assert.equal(r.result.structuredContent.nativeChat.verified,false,'initialize display name is not native identity');
+ r=await setup(metadata());assert.equal(r.result.structuredContent.nativeChat.verified,true);assert.equal(r.result.structuredContent.account.connected,false,'chat identity does not manufacture account consent');assert.equal(r.result.structuredContent.nativeChat.automaticDelivery,false);
+ r=await setup(metadata(second));assert.match(r.error.message,/different native chat/);
+ r=await setup();assert.match(r.error.message,/omitted/);
+ r=await setup(metadata());assert.equal(r.result.structuredContent.nativeChat.verified,true);
+});
