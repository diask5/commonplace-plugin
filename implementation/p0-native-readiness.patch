+ const f=await fixture(t);await writeFile(path.join(f.dir,'background/version'),'0.4.18');
+ assert.equal(BACKGROUND_VERSION,PLUGIN_VERSION);assert.notEqual(BACKGROUND_VERSION,'0.4.18');
+ assert.deepEqual(await ensureCloudBackground(f.dir,f.options),{installed:true});
+ assert.equal(await readFile(path.join(f.dir,'background/version'),'utf8'),PLUGIN_VERSION);
+ assert.equal(await readFile(path.join(f.dir,'background',PLUGIN_VERSION,'node'),'utf8'),'test runtime');
+ assert.equal(await readFile(path.join(f.dir,'background',PLUGIN_VERSION,'server/local-client.mjs'),'utf8'),await readFile(new URL('../apps/commonplace/server/local-client.mjs',import.meta.url),'utf8'));
+ const agents=path.join(f.root,'Library/LaunchAgents'),names=await readdir(agents);assert.equal(names.length,1);
