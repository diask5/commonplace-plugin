+ child.stderr.on('data',chunk=>errors+=chunk);
+ const lines=createInterface({input:child.stdout});lines.on('line',line=>{const value=JSON.parse(line);pending.get(value.id)?.resolve(value);pending.delete(value.id);});
+ child.once('exit',()=>{for(const p of pending.values())p.reject(Error(errors||'Plugin exited'));});
+ t.after(async()=>{
+  child.stdin.end();if(child.exitCode===null&&child.signalCode===null){const timer=setTimeout(()=>child.kill('SIGTERM'),1000);await once(child,'exit');clearTimeout(timer);}
+  lines.close();await new Promise(resolve=>server.close(resolve));await rm(dir,{recursive:true,force:true});
+ });
+ const rpc=(method,params={})=>new Promise((resolve,reject)=>{pending.set(++id,{resolve,reject});child.stdin.write(JSON.stringify({jsonrpc:'2.0',id,method,params})+'\n');});
+ assert.ok((await rpc('initialize',{protocolVersion:'2025-11-25',capabilities:{},clientInfo:{name:'Untrusted client name',version:'test'}})).result);
+ child.stdin.write(JSON.stringify({jsonrpc:'2.0',method:'notifications/initialized'})+'\n');
+ assert.ok((await rpc('tools/list')).result);
+ assert.equal((await rpc('tools/call',{name:'setup_status',arguments:{}})).result.structuredContent.nativeChat.verified,true);
+ assert.equal(await readFile(trace,'utf8').catch(e=>{if(e.code==='ENOENT')return '';throw e;}),'','read-only discovery must not query host metadata');
+ const result=await rpc('tools/call',{name:'discover_agents',arguments:{}});
+ assert.equal(result.result.structuredContent.self.label,name,JSON.stringify(result));
+ assert.equal(result.result.structuredContent.self.id,'a'.repeat(24));assert.equal(result.result.structuredContent.self.ownerId,'b'.repeat(24));assert.equal(result.result.structuredContent.self.generation,1);
+ const registered=calls.find(c=>c.input.params?.name==='discover_agents').input._commonplaceSession;
+ assert.equal(registered.sessionId,sessionKey('Codex',thread));assert.equal(registered.provider,'Codex');assert.equal(registered.verified,true);
