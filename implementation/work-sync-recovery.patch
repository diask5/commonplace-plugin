+ assert.ok(hostCalls.length>=2);assert.equal(hostCalls.every(({args})=>args[0]==='session'&&args[1]==='get'&&args[2]===host),true);
+ assert.equal(hostCalls[0].label,'Stale setup name');
+ assert.equal(hostCalls[1].label,name,'receiver startup must inherit the current name instead of the saved setup label');
+});
