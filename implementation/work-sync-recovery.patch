+console.log(JSON.stringify({id:${JSON.stringify(host)},name:${JSON.stringify(name)},deepLink:${JSON.stringify(`conductor://workspace?id=${workspace}&session=${host}`)}}));
+`,{mode:0o700});
+ const server=createServer(async(req,res)=>{
+  let raw='';for await(const chunk of req)raw+=chunk;const input=JSON.parse(raw);calls.push({route:req.url,input});
+  assert.equal(req.headers.authorization,'Bearer naming-fixture');
+  let output={};
+  if(req.url==='/api/account/status')output={toolset:'account-inbox'};
+  if(req.url==='/local/mcp')output={jsonrpc:'2.0',id:input.id,result:{content:[{type:'text',text:JSON.stringify(input.params?.name==='discover_agents'?{self:{id:'a'.repeat(24),ownerId:'b'.repeat(24),generation:1,label:input._commonplaceSession.label}}:{})}]}};
+  res.writeHead(200,{'content-type':'application/json'});res.end(JSON.stringify(output));
+ });
+ server.listen(0,'127.0.0.1');await once(server,'listening');
+ await writeFile(path.join(dir,'runtime.json'),JSON.stringify({origin:'http://127.0.0.1:'+server.address().port,token:'naming-fixture',revision:RUNTIME_REVISION,pid:process.pid}));
+ const env={...process.env,HOME:home,COMMONPLACE_DATA_DIR:dir,COMMONPLACE_DISABLE_BACKGROUND:'1'};
+ for(const key of Object.keys(env))if(key.startsWith('CONDUCTOR_')||key.startsWith('CLAUDE_')||key.startsWith('CODEX_'))delete env[key];
+ Object.assign(env,{CONDUCTOR_IS_LOCAL:'0',CONDUCTOR_SESSION_ID:host,CONDUCTOR_WORKSPACE_ID:workspace,CONDUCTOR_WORKSPACE_NAME:'Meet Proxy Chat Connection',CONDUCTOR_CLI_PATH:cli,CODEX_THREAD_ID:thread});
