+// Synthetic protocol fixtures exercise interruption points without reading any
+// native chat history. Real relay/digest/search integration is covered above.
+const checksum=text=>createHash('sha256').update(text).digest('hex');
+async function mirrorHarness(t,texts,{pageSize=1000,fileSlice=1_000_000}={}){
+ const dir=await mkdtemp(path.join(tmpdir(),'mirror-retry-'));t.after(()=>rm(dir,{recursive:true,force:true}));
+ const h={owner:'a'.repeat(24),revision:1,calls:[],documents:[],texts:new Map()};
+ h.set=(title,text)=>{
+  const id='unified-'+checksum(title).slice(0,24),path='documents/'+id+'.txt';
+  const doc={id,path,title,kind:'codex',project:'synthetic',capturedAt:1000,updatedAt:1000,digest:checksum(text),characters:text.length};
+  h.documents=h.documents.filter(d=>d.id!==id);h.documents.push(doc);h.texts.set(path,text);return doc;
+ };
+ for(const [title,text] of texts)h.set(title,text);
+ h.client={state:{session:{humanAccount:{id:h.owner}}},view:()=>({connected:true})};
+ h.client.request=async(endpoint,input={})=>{
+  h.calls.push({endpoint,input});
+  if(endpoint.endsWith('/identity/status'))return {connected:true,account:{id:h.owner}};
+  if(input.revision!==undefined&&input.revision!==h.revision)return {changed:true,restart:true,revision:h.revision};
+  if(endpoint.endsWith('/archive-manifest')){
+   if(input.knownRevision===h.revision)return {unchanged:true,revision:h.revision,asOf:1000};
+   const cursor=input.cursor||0,page=h.documents.slice(cursor,cursor+pageSize);
+   return {revision:h.revision,asOf:1000,expiresAt:null,total:h.documents.length,characters:h.documents.reduce((sum,d)=>sum+d.characters,0),documents:page,nextCursor:cursor+page.length<h.documents.length?cursor+page.length:null};
+  }
+  assert.ok(endpoint.endsWith('/archive-files'));
+  return {revision:h.revision,files:input.paths.map(({path,offset})=>{
+   const doc=h.documents.find(d=>d.path===path),text=h.texts.get(path).slice(offset,offset+fileSlice);
+   return {path,offset,text,digest:doc.digest,totalCharacters:doc.characters,nextOffset:offset+text.length<doc.characters?offset+text.length:null};
+  })};
+ };
+ h.app={dir,accountClient:h.client};h.mirror=await ContextMirror.open(h.app,{searchCommand:'context-search'});
+ h.downloads=()=>h.calls.filter(c=>c.endpoint.endsWith('/archive-files')).flatMap(c=>c.input.paths.map(p=>p.path));
+ return h;
+}
