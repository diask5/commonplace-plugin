+++ b/tests/live-index-reuse.test.mjs
@@ -0,0 +1,112 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {randomBytes,createHash} from 'node:crypto';
+import {mkdtemp,rm,readFile,writeFile,chmod,readdir,mkdir,symlink} from 'node:fs/promises';
+import {tmpdir} from 'node:os';
+import path from 'node:path';
+import {openDatabase} from '../apps/commonplace-account/server/sqlite.mjs';
+import {AccountService} from '../apps/commonplace-account/server/service.mjs';
+import {CloudWork} from '../apps/commonplace-account/server/cloud-work.mjs';
+import {CloudArchive} from '../apps/commonplace-account/server/cloud-archive.mjs';
+import {collectLiveIndexes} from '../apps/commonplace-account/server/live-archive-index.mjs';
+import {liveArchiveQuery} from '../apps/commonplace-account/server/archive-source.mjs';
+const hash=s=>createHash('sha256').update(s).digest('hex');
+async function fixture(t,size=1000,count=40){
+ const dir=await mkdtemp(path.join(tmpdir(),'live-reuse-test-'));
+ const db=openDatabase(path.join(dir,'db.sqlite'),{migrations:path.resolve('apps/commonplace-account/drizzle')});
+ t.after(async()=>{db.close();await rm(dir,{recursive:true,force:true});});
+ const service=new AccountService(db,'https://relay.example');
+ const owner=(await service.profile({userId:'owner',email:'owner@example.test'})).id;
+ const other=(await service.profile({userId:'other',email:'other@example.test'})).id;
+ const work=new CloudWork(service),device=randomBytes(12).toString('hex');
+ work.run('INSERT INTO cp_devices(id,owner,client,name,scope,created_at) VALUES(?,?,?,?,?,?)',device,owner,'test','Mac','commonplace',Date.now());
+ const native=(i,body,revision=1,title='Codex chats: document '+i)=>work.upload(owner,{id:device},{key:hash('source'+i),text:body,title,revision,capturedAt:1000+i});
+ for(let i=0;i<count;i++)native(i,('shared marker word'+i+' value['+i+'].x ').repeat(Math.ceil(size/35)).slice(0,size));
+ const archive=new CloudArchive(work,{directory:path.join(dir,'archives')});
+ const base=await archive.materialize(owner);
+ const compare=async(input,expectedReuse=true)=>{
+  const stats={},now=Date.now();
+  db.sqlite.exec('BEGIN');
+  try{
+   const begin=performance.now();
+   const actual=await liveArchiveQuery(db.sqlite,owner,'archive_search',input,{base,stats,now});
+   const patchMs=performance.now()-begin,fullBegin=performance.now();
+   const expected=await liveArchiveQuery(db.sqlite,owner,'archive_search',input,{now});
+   assert.deepEqual(actual,expected);
+   if(expectedReuse)assert.ok(stats.reused>0,JSON.stringify(stats));else assert.deepEqual(stats,{});
+   assert.equal((await readdir(path.dirname(base.directory)).catch(()=>[])).some(n=>n.startsWith('.live-index-')),false);
+   return {actual,stats,patchMs,fullMs:performance.now()-fullBegin};
+  }finally{db.sqlite.exec('COMMIT');}
+ };
+ return {dir,db,service,work,owner,other,native,base,archive,compare};
+}
+test('patched contentless FTS matches full rebuild after add/edit/delete with ranking and paging',async t=>{
+ const f=await fixture(t);
+ f.native(0,'new marker replacement',2);f.native(60,'new shared marker added');
+ f.work.run('DELETE FROM cp_cloud_sources WHERE owner=? AND source_key=?',f.owner,hash('source1'));
+ const before=await readFile(path.join(f.base.directory,'search.sqlite'));
+ for(const input of [{query:'shared marker'},{query:'shared marker',cursor:15},{query:'new'},{query:'mark*',kind:'codex'},{query:'marker',after:1015},{query:'value[3].x',mode:'phrase'}]){
+  const {stats}=await f.compare(input,input.mode!=='phrase');
+  if(!input.mode){assert.equal(stats.removed,2);assert.equal(stats.indexed,2);}
+ }
+ assert.deepEqual(await readFile(path.join(f.base.directory,'search.sqlite')),before,'base index remains immutable');
+});
+test('removed private source and another owner never appear through a stale index',async t=>{
+ const f=await fixture(t);
+ f.work.run('DELETE FROM cp_cloud_sources WHERE owner=? AND source_key=?',f.owner,hash('source3'));
+ const {actual}=await f.compare({query:'word3'});assert.equal(actual.value.results.length,0);
+ const result=await liveArchiveQuery(f.db.sqlite,f.other,'archive_search',{query:'shared'},{base:f.base});
+ assert.equal(result.value.results.length,0);
+});
+test('corrupt index, corrupt removed body and a retired base fall back without stale text',async t=>{
+ const f=await fixture(t);f.native(0,'new replacement',2);
+ const d=f.base.manifest.documents.find(d=>d.title==='Codex chats: document 0');
+ const file=path.join(f.base.directory,d.path);await chmod(file,0o600);await writeFile(file,'corrupted');
+ await f.compare({query:'replacement'},false);
+ const index=path.join(f.base.directory,'search.sqlite');await chmod(index,0o600);await writeFile(index,'not sqlite');
+ await f.compare({query:'replacement'},false);
+ await rm(f.base.directory,{recursive:true});await f.compare({query:'replacement'},false);
+});
+test('small changes only index changed documents in a larger real archive',async t=>{
+ const f=await fixture(t,38000,180);f.native(0,'shared marker changed',2);
+ const start=performance.now();const {stats,patchMs,fullMs}=await f.compare({query:'shared marker'});
+ assert.equal(stats.reused,179);assert.equal(stats.indexed,1);assert.equal(stats.removed,1);
+ t.diagnostic('7 MB authoritative projection + patched/full equality: '+Math.round(performance.now()-start)+' ms; patched '+Math.round(patchMs)+' ms, fresh '+Math.round(fullMs)+' ms');
+});
+
+test('retirement reclaims only dead-process scratch and preserves live queries',async t=>{
+ const f=await fixture(t),root=path.dirname(f.base.directory);
+ const dead='.live-index-111111-7-abcdef',live='.live-index-222222-7-ghijkl';
+ await mkdir(path.join(root,dead));await mkdir(path.join(root,live));
+ await symlink(f.dir,path.join(root,'.live-index-111111-7-aaaaaa'));
+ await collectLiveIndexes(root,{alive:pid=>pid===222222,stamp:async()=> '7'});
+ const names=await readdir(root);assert.ok(!names.includes(dead));assert.ok(names.includes(live));
+ assert.ok(names.includes('.live-index-111111-7-aaaaaa'));assert.ok(names.includes(path.basename(f.base.directory)));
+});
+test('derived index work can release the captured read transaction without mixing snapshots',async t=>{
+ const f=await fixture(t);let projected=false;f.db.sqlite.exec('BEGIN');
