diff --git a/apps/commonplace-account/server/live-archive-index.mjs b/apps/commonplace-account/server/live-archive-index.mjs
new file mode 100644
index 0000000..414733c
--- /dev/null
+++ b/apps/commonplace-account/server/live-archive-index.mjs
@@ -0,0 +1,81 @@
+import {DatabaseSync} from 'node:sqlite';
+import {mkdtemp,copyFile,chmod,rm,lstat,open,readdir,readFile} from 'node:fs/promises';
+import {constants} from 'node:fs';
+import path from 'node:path';
+import {createHash} from 'node:crypto';
+import {contextLayout,fileDigest} from './archive-index.mjs';
+
+const digest=body=>createHash('sha256').update(body).digest('hex');
+const same=(a,b)=>a.digest===b.digest&&a.title===b.title&&a.kind===b.kind&&
+  (a.project||'').toLowerCase()===(b.project||'').toLowerCase()&&a.capturedAt===b.capturedAt;
+
+// Orphan scratch belongs to one account and one process. Never remove a live
+// process's query, or an arbitrary/symlinked directory. A later archive cleanup
+// reclaims a crashed process's derived index without touching published files.
+async function processStamp(pid) {
+  // The production archive has one PID namespace. Linux start ticks distinguish
+  // a recycled PID (including a restarted PID1) from the original process.
+  try{const raw=await readFile('/proc/'+pid+'/stat','utf8'),stamp=raw.slice(raw.lastIndexOf(')')+2).split(' ')[19];return /^\d+$/.test(stamp)?stamp:null;}catch{return null;}
+}
+export async function collectLiveIndexes(root,{alive=pid=>{try{process.kill(pid,0);return true;}catch(e){return e.code==='EPERM';}},stamp=processStamp}={}) {
+  for(const entry of await readdir(root,{withFileTypes:true}).catch(()=>[])) {
+    const match=/^\.live-index-(\d+)-(\d+|unknown)-[a-zA-Z0-9]{6}$/.exec(entry.name);
+    if(!match||!entry.isDirectory())continue;
+    const pid=Number(match[1]);if(!Number.isSafeInteger(pid)||pid<=0)continue;
+    if(alive(pid)){const current=await stamp(pid);if(!current||match[2]==='unknown'||current===match[2])continue;}
+    await rm(path.join(root,entry.name),{recursive:true,force:true}).catch(()=>{});
+  }
+}
+
+// A prior index is only an acceleration input. The caller still reconstructs
+// the complete current authorized projection and fences its revision/expiry.
+// Mutate a private copy; published snapshots and the primary DB stay untouched.
+export async function patchLiveIndex(base,manifest,bodies,{stats}={}) {
+  if(!base||base.manifest?.owner!==manifest.owner||base.manifest.layout!==contextLayout)return null;
+  const prior=base.manifest,old=new Map(prior.documents.map(d=>[d.id,d]));
+  if(old.size!==prior.documents.length)return null;
+  const current=new Map(manifest.documents.map(d=>[d.id,d]));
+  const removed=prior.documents.filter(d=>!current.has(d.id)||!same(d,current.get(d.id)));
+  const added=manifest.documents.filter(d=>!old.has(d.id)||!same(old.get(d.id),d));
+  // A large delta is cheaper and simpler to rebuild with the ordinary path.
+  if(removed.length+added.length>Math.max(16,prior.documents.length/2))return null;
+  let directory,db;
+  try {
+    const source=path.join(base.directory,'search.sqlite'),stat=await lstat(source);
+    if(!stat.isFile()||stat.isSymbolicLink()||stat.size>128_000_000||typeof prior.files?.['search.sqlite']!=='string')return null;
+    // Scratch is outside immutable generations, so retirement cannot race a
+    // new directory entry. Mode0700 keeps it private; dead-process cleanup is
+    // tied to the owner's archive lifecycle.
+    directory=await mkdtemp(path.join(path.dirname(base.directory),'.live-index-'+process.pid+'-'+(await processStamp(process.pid)||'unknown')+'-'));
+    const filename=path.join(directory,'search.sqlite');
+    await copyFile(source,filename);await chmod(filename,0o600);
+    if(await fileDigest(filename)!==prior.files['search.sqlite'])throw Error('Invalid acceleration index.');
+    db=new DatabaseSync(filename);
+    // This is disposable derived data, never a change to primary durability.
+    db.exec('PRAGMA journal_mode=MEMORY; BEGIN');
+    const rows=db.prepare('SELECT * FROM documents').all(),byId=new Map(rows.map(r=>[r.id,r]));
+    if(rows.length!==old.size||rows.some(r=>{const d=old.get(r.id);return !d||r.kind!==d.kind||r.project!==(d.project||'').toLowerCase()||r.captured_at!==d.capturedAt;}))throw Error('Invalid acceleration metadata.');
+    const remove=db.prepare("INSERT INTO search(search,rowid,title,body) VALUES('delete',?,?,?)");
+    const removeMeta=db.prepare('DELETE FROM documents WHERE id=?');
+    for(const d of removed) {
+      if(!/^(?:native|chatgpt|work|unified|thread|context)-[a-f0-9]{24}$/.test(d.id)||d.path!=='documents/'+d.id+'.txt')throw Error('Invalid acceleration document.');
+      const handle=await open(path.join(base.directory,d.path),constants.O_RDONLY|constants.O_NOFOLLOW);
+      let body;try{const s=await handle.stat();if(!s.isFile()||s.size>64_000_000)throw Error('Invalid acceleration document.');body=await handle.readFile('utf8');}finally{await handle.close();}
+      if(digest(body)!==d.digest)throw Error('Invalid acceleration document.');
+      remove.run(byId.get(d.id).rowid,d.title,body);removeMeta.run(d.id);
+    }
+    let rowid=rows.reduce((n,r)=>Math.max(n,r.rowid),0);
+    const meta=db.prepare('INSERT INTO documents VALUES(?,?,?,?,?)'),insert=db.prepare('INSERT INTO search(rowid,title,body) VALUES(?,?,?)');
+    for(const d of added) {
+      const body=d.sections.map(id=>bodies.get(id)).join('');
+      meta.run(++rowid,d.id,d.kind,(d.project||'').toLowerCase(),d.capturedAt);insert.run(rowid,d.title,body);
+    }
+    db.exec('COMMIT');
+    if(stats)Object.assign(stats,{reused:old.size-removed.length,removed:removed.length,indexed:added.length});
+    return {db,close:async()=>{try{db.close();}finally{await rm(directory,{recursive:true,force:true}).catch(()=>{});}}};
+  } catch {
+    // Missing/retired or damaged base files never supply results. Start fresh.
+    try{db?.close();}finally{if(directory)await rm(directory,{recursive:true,force:true}).catch(()=>{});}
+    return null;
+  }
+}
