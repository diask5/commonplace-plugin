+// Preserve a bounded failure category on stderr before the SDK wrapper replaces
+// the original exception. Never log messages, stacks, URLs, paths, identities,
+// request bodies or arbitrary error codes. A wrapper-generated 503 is not an
+// observed HTTP response. This adds evidence, not retries or an auth diagnosis.
+export function agentAuthDiagnostic(error) {
+  const categories = new Map([
+    ['ENOTFOUND', 'dns'], ['EAI_AGAIN', 'dns'],
+    ['ECONNRESET', 'socket'], ['ECONNREFUSED', 'socket'], ['EPIPE', 'socket'],
+    ['UND_ERR_SOCKET', 'socket'],
+    ['ETIMEDOUT', 'timeout'], ['UND_ERR_CONNECT_TIMEOUT', 'timeout'],
+    ['UND_ERR_HEADERS_TIMEOUT', 'timeout'], ['UND_ERR_BODY_TIMEOUT', 'timeout'],
+    ['CERT_HAS_EXPIRED', 'tls'], ['DEPTH_ZERO_SELF_SIGNED_CERT', 'tls'],
+    ['UNABLE_TO_VERIFY_LEAF_SIGNATURE', 'tls'],
+    ['ERR_TLS_CERT_ALTNAME_INVALID', 'tls'],
+  ]);
+  let category = 'unclassified', reportedStatus = null;
+  try {
+    if (Number.isInteger(error?.status) && error.status >= 400 && error.status <= 599)
+      reportedStatus = error.status;
+    const seen = new Set();
+    for (let item = error, depth = 0; item && depth < 4 && !seen.has(item); item = item.cause, depth++) {
+      seen.add(item);
+      if (categories.has(item.code)) { category = categories.get(item.code); break; }
+      if (item.name === 'TimeoutError') { category = 'timeout'; break; }
+      if (item.name === 'AbortError') { category = 'aborted'; break; }
+      if (item instanceof SyntaxError) { category = 'parse'; break; }
+    }
+    if (category === 'unclassified' && reportedStatus !== null) category = 'reported-status';
+  } catch { /* A malformed exception must not replace the original failure. */ }
+  return {event: 'meet_proxy_agent_auth_failure', category, reportedStatus};
+}
+
+export function reportAgentAuthDiagnostic(error, write = value => process.stderr.write(value)) {
+  try { write(JSON.stringify(agentAuthDiagnostic(error)) + '\n'); }
+  catch { /* Diagnostics must never mask the request failure or trigger work. */ }
+}
