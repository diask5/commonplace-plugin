diff --git a/apps/commonplace/tests/account-errors.test.mjs b/apps/commonplace/tests/account-errors.test.mjs
index 4f40180..363ddf1 100644
--- a/apps/commonplace/tests/account-errors.test.mjs
+++ b/apps/commonplace/tests/account-errors.test.mjs
@@ -1,6 +1,68 @@
 import test from 'node:test';
 import assert from 'node:assert/strict';
-import {safeAccountError} from '../server/account-errors.mjs';
+import {safeAccountError,agentAuthDiagnostic,reportAgentAuthDiagnostic} from '../server/account-errors.mjs';
+
+test('Agent Auth diagnostics retain only allowlisted categories and supplied status',()=>{
+  const cases = [
+    [Object.assign(Error('PRIVATE https://secret.example/token'), {cause:{code:'ENOTFOUND'}}), 'dns', null],
+    [Object.assign(Error('PRIVATE'), {cause:{cause:{code:'ECONNRESET'}}}), 'socket', null],
+    [Object.assign(Error('PRIVATE'), {cause:{code:'ERR_TLS_CERT_ALTNAME_INVALID'}}), 'tls', null],
+    [new DOMException('PRIVATE', 'TimeoutError'), 'timeout', null],
+    [new DOMException('PRIVATE', 'AbortError'), 'aborted', null],
+    [new SyntaxError('PRIVATE response body'), 'parse', null],
+    [Object.assign(Error('PRIVATE'), {status:401}), 'reported-status', 401],
+    [Object.assign(Error('PRIVATE'), {status:429}), 'reported-status', 429],
+    [Object.assign(Error('PRIVATE'), {status:503}), 'reported-status', 503],
+    [Object.assign(Error('PRIVATE'), {code:'PRIVATE-CODE',status:'503'}), 'unclassified', null],
+    [Object.assign(Error('PRIVATE'), {code:23}), 'unclassified', null],
+    [null, 'unclassified', null],
+  ];
+  for(const [error,category,reportedStatus] of cases) {
+    const result=agentAuthDiagnostic(error);
+    assert.deepEqual(result,{event:'meet_proxy_agent_auth_failure',category,reportedStatus});
+    assert.doesNotMatch(JSON.stringify(result),/PRIVATE|secret\.example|token|stack|message/);
+    assert.ok(JSON.stringify(result).length<128);
+  }
+  const cycle=Error('PRIVATE');cycle.cause=cycle;
+  assert.equal(agentAuthDiagnostic(cycle).category,'unclassified');
+  assert.doesNotThrow(()=>agentAuthDiagnostic({get status(){throw Error('PRIVATE');}}));
+});
+
+test('diagnostic reporting writes one bounded JSON line and cannot mask a failure',()=>{
+  const lines=[];
+  reportAgentAuthDiagnostic(Error('PRIVATE'),line=>lines.push(line));
+  assert.equal(lines.length,1);
+  assert.deepEqual(JSON.parse(lines[0]),{event:'meet_proxy_agent_auth_failure',category:'unclassified',reportedStatus:null});
+  assert.equal(lines[0].split('\n').length,2);
+  assert.doesNotThrow(()=>reportAgentAuthDiagnostic(Error('PRIVATE'),()=>{throw Error('sink unavailable');}));
+});
+
+test('real AgentConnection reports before synthetic status wrapping and never retries',async()=>{
+  const {spawnSync}=await import('node:child_process');
+  const moduleUrl=new URL('../server/agent-auth-client.mjs',import.meta.url).href;
+  const child=spawnSync(process.execPath,['--input-type=module','-e',`
+    import assert from 'node:assert/strict';
+    import {AgentConnection} from ${JSON.stringify(moduleUrl)};
+    let calls=0;
+    for(const rateLimited of [false,true]) {
+      const original=rateLimited?Object.assign(Error('PRIVATE'),{code:'rate_limited',status:429,retryAfter:17}):Object.assign(Error('PRIVATE'),{cause:{code:'ECONNRESET'}});
+      const connection={agent:async()=> 'fixture-agent',client:{executeCapability:async()=>{calls++;throw original;}}};
+      await assert.rejects(AgentConnection.prototype.request.call(connection,'/account/api/private-path',{secret:'PRIVATE'}),error=>{
+        if(rateLimited){assert.equal(error,original);assert.equal(error.retryAfter,17);}
+        else {assert.equal(error.status,503);assert.equal(error.message,'Commonplace Agent Auth failed (connection unavailable).');}
+        return true;
+      });
+    }
+    assert.equal(calls,2);
+  `],{encoding:'utf8'});
+  assert.equal(child.status,0,child.stderr);
+  assert.doesNotMatch(child.stderr,/PRIVATE|fixture-agent|private-path|ECONNRESET/);
+  const diagnostics=child.stderr.split('\n').filter(line=>line.startsWith('{')).map(line=>JSON.parse(line));
+  assert.deepEqual(diagnostics,[
+    {event:'meet_proxy_agent_auth_failure',category:'socket',reportedStatus:null},
+    {event:'meet_proxy_agent_auth_failure',category:'reported-status',reportedStatus:429},
+  ]);
+});
 
