+ // Imported messages have authoritative stored boundaries too. Reconstruct the
+ // complete indexed projection before selecting exact bodies; never parse role
+ // markers from user text or disclose generated IDs/source titles as content.
+ importedMessageCandidates(owner,source){
+  if(source.text.length>16000)return null;
+  if(this.archiveRevision(owner)!==source.revision)fail(409,'Context changed.');
+  const doc=this.get('SELECT id,title FROM cp_context_documents WHERE id=? AND owner=?',source.id.slice(8),owner);
+  if(!doc||doc.title!==source.title)fail(409,'Context changed.');
+  const rows=this.all('SELECT external_id,parent_id,role,body FROM cp_context_messages WHERE document=? ORDER BY position,captured_at,external_id',doc.id);
+  const parts=rows.map(row=>({row,header:row.role+' [message '+row.external_id+(row.parent_id?'; reply to '+row.parent_id:'; branch unknown')+']: '}));
+  const projection=parts.map(({row,header})=>header+row.body+'\n\n').join('');
+  if(!rows.length||projection!==source.text||this.archiveRevision(owner)!==source.revision)fail(409,'Context changed.');
+  const context='Private source title: '+JSON.stringify(source.title)+'\n'+source.text;
+  if(context.length>16000)return [];
+  if(rows.some(row=>row.body.length>8000))return null;
+  const candidates=[];let offset=0;
+  for(const {row,header}of parts){
+   const text=row.body,start=offset+header.length;
+   if(text.trim()&&text.isWellFormed())candidates.push({...source,title:'Shared excerpt',sourceTitle:source.title,text,context,contextComplete:true,sourceOffset:start,sourceEnd:start+text.length});
+   offset+=header.length+text.length+2;
+  }
+  return candidates;
+ }
