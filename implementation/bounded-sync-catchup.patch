+
+
+test('one long active conversation uses remaining upload slots before unchanged heartbeats',async t=>{
+ const f=await fixture(t),sync=f.sync();
+ for(let i=0;i<6;i++)await f.chat('quiet'+i,'Quiet '+i,{age:600000});
+ await sync.tick('owner',f.roots);f.clock.now+=31000;
+ await writeFile(path.join(f.root,'long.jsonl'),Array.from({length:240},(_,i)=>line('long','m'+i,'Long message '+i)).join(''));
+ const start=f.uploads.length;await sync.tick('owner',f.roots);const uploads=f.uploads.slice(start);
+ assert.equal(uploads.length,6,'existing six-upload bound is unchanged');
+ assert.equal(uploads.filter(u=>u.conversation.id==='long').length,6,'spare slots advance the long source');
+ assert.equal(uploads.at(-1).state,'current');assert.equal(new Set(uploads.map(u=>u.captureId)).size,1,'one atomic capture through every batch');
+ assert.equal(new Set(uploads.flatMap(u=>u.messages.map(m=>m.id))).size,240);
+});
+
+test('requeued chunks rotate across active sources and reserve overdue heartbeats',async t=>{
+ const f=await fixture(t),sync=f.sync();
+ await f.chat('steady','Steady',{age:600000});await sync.tick('owner',f.roots);f.clock.now+=31000;
+ for(const n of ['alpha','beta'])await writeFile(path.join(f.root,n+'.jsonl'),Array.from({length:400},(_,i)=>line(n,n+i,'Message '+i)).join(''));
+ sync.state.beatSkips=5;
+ const start=f.uploads.length;await sync.tick('owner',f.roots);const uploads=f.uploads.slice(start),names=uploads.map(u=>u.conversation.id);
+ assert.equal(uploads.length,6);assert.ok(names.indexOf('steady')<=2,'overdue heartbeat retains its reserved slot');
+ for(const n of ['alpha','beta'])assert.ok(names.filter(id=>id===n).length>=2,'each active source advances');
+});
+
+test('failed later chunk resumes exactly without losing the earlier chunk',async t=>{
+ const f=await fixture(t),sync=f.sync();
+ await writeFile(path.join(f.root,'long.jsonl'),Array.from({length:120},(_,i)=>line('long','m'+i,'Message '+i)).join(''));
+ f.fail=input=>input.revision===2?Object.assign(Error('offline second batch'),{status:503}):null;
+ await assert.rejects(sync.tick('owner',f.roots),/offline second batch/);
+ const failed=structuredClone(f.uploads.at(-1));assert.equal(f.uploads[0].revision,1);f.fail=null;
+ const start=f.uploads.length;await f.sync().tick('owner',f.roots);
+ assert.deepEqual(f.uploads[start],failed);assert.equal(f.uploads.at(-1).state,'current');
+ assert.equal(new Set(f.uploads.filter(u=>u.revision!==2).flatMap(u=>u.messages.map(m=>m.id))).size,80);
+});
