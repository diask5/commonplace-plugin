+++ b/apps/commonplace-account/server/decisions-scheduler.mjs
@@ -0,0 +1,43 @@
+import {createHash} from 'node:crypto';
+
+// The provider's default is 10 starts/second. Share one bounded FIFO across
+// accounts and classifier instances using the same credential in this process.
+// Keep headroom, never retry a decision, and include queueing in its deadline.
+export class DecisionsScheduler {
+  constructor({concurrency=4, intervalMs=125, maxQueue=128}={}) {
+    if(!Number.isSafeInteger(concurrency)||concurrency<1||!Number.isFinite(intervalMs)||intervalMs<0||!Number.isSafeInteger(maxQueue)||maxQueue<1)throw Error('Invalid Decisions scheduler limits.');
+    Object.assign(this,{concurrency,intervalMs,maxQueue});
+    this.active=0;this.queue=[];this.nextAt=0;this.timer=null;
+  }
+  run(work,signal) {
+    if(signal?.aborted)return Promise.reject(signal.reason);
+    if(this.queue.length>=this.maxQueue)return Promise.reject(Object.assign(Error('provider_queue_full'),{code:'provider_queue_full'}));
+    return new Promise((resolve,reject)=>{
+      const entry={work,signal,resolve,reject};
+      entry.abort=()=>{const i=this.queue.indexOf(entry);if(i<0)return;this.queue.splice(i,1);reject(signal.reason);this.pump();};
+      signal?.addEventListener('abort',entry.abort,{once:true});
+      this.queue.push(entry);this.pump();
+    });
+  }
+  pump() {
+    if(this.timer){clearTimeout(this.timer);this.timer=null;}
+    if(!this.queue.length||this.active>=this.concurrency)return;
+    const wait=this.nextAt-performance.now();
+    if(wait>0){this.timer=setTimeout(()=>{this.timer=null;this.pump();},wait);return;}
+    const entry=this.queue.shift();entry.signal?.removeEventListener('abort',entry.abort);
+    if(entry.signal?.aborted){entry.reject(entry.signal.reason);this.pump();return;}
+    this.active++;this.nextAt=performance.now()+this.intervalMs;
+    Promise.resolve().then(()=>{entry.signal?.throwIfAborted();return entry.work();}).then(entry.resolve,entry.reject).finally(()=>{this.active--;this.pump();});
+    this.pump();
+  }
+}
+
+// An injected transport gets its own pool so isolated tests do not consume the
+// real provider's slots. Neither candidate text nor credentials are retained here.
+const transports=new WeakMap();
+export function sharedDecisionsScheduler(fetchImpl,endpoint,apiKey) {
+  let pools=transports.get(fetchImpl);if(!pools){pools=new Map();transports.set(fetchImpl,pools);}
+  const key=createHash('sha256').update(JSON.stringify([endpoint,apiKey])).digest('hex');
+  let scheduler=pools.get(key);if(!scheduler){scheduler=new DecisionsScheduler();pools.set(key,scheduler);}
+  return scheduler;
+}
