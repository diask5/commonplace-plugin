+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {setTimeout as sleep} from 'node:timers/promises';
+import {DecisionsScheduler,sharedDecisionsScheduler} from '../apps/commonplace-account/server/decisions-scheduler.mjs';
+import {PerplexityDecisions,DECISIONS_MODEL,DECISIONS_URL} from '../apps/commonplace-account/server/perplexity-decisions.mjs';
+const input={rules:'Share project progress with Sam.',recipient:'Sam',candidate:{title:'Progress',text:'Project navigation is complete.',context:''}};
+const response=()=>Response.json({model:DECISIONS_MODEL,answers:{share:{type:'noul',noul:1}}});
+
+test('separate owners using the same provider credential share one scheduler',()=>{
+ const transport=async()=>response();
+ const a=new PerplexityDecisions({apiKey:'synthetic-one',fetchImpl:transport}),b=new PerplexityDecisions({apiKey:'synthetic-one',fetchImpl:transport});
+ assert.equal(a.scheduler,b.scheduler);
+ assert.notEqual(a.scheduler,new PerplexityDecisions({apiKey:'synthetic-two',fetchImpl:transport}).scheduler);
+ assert.notEqual(a.scheduler,sharedDecisionsScheduler(async()=>response(),DECISIONS_URL,'synthetic-one'));
+});
+test('shared queue bounds concurrent network work and preserves FIFO starts',async()=>{
+ const s=new DecisionsScheduler({concurrency:2,intervalMs:0});let active=0,peak=0;const starts=[];
+ const results=await Promise.all(Array.from({length:20},(_,i)=>s.run(async()=>{starts.push(i);peak=Math.max(peak,++active);await sleep(5);active--;return i;})));
+ assert.equal(peak,2);assert.deepEqual(starts,results);assert.equal(s.queue.length,0);
+});
+test('fast completions still respect the provider start rate',async()=>{
+ const s=new DecisionsScheduler({intervalMs:20});const times=[];
+ await Promise.all(Array.from({length:8},()=>s.run(()=>{times.push(performance.now());})));
+ for(let i=1;i<times.length;i++)assert.ok(times[i]-times[i-1]>=19,JSON.stringify(times));
+});
+test('cancelled queued work never reaches the provider and does not block later work',async()=>{
+ const s=new DecisionsScheduler({concurrency:1,intervalMs:0});const controller=new AbortController();let calls=0;
+ const first=s.run(()=>sleep(25));
+ const cancelled=s.run(()=>{calls++;},controller.signal);const rejected=assert.rejects(cancelled,/cancel/);
+ const last=s.run(()=>++calls);controller.abort(Error('cancel'));
+ await Promise.all([first,rejected,last]);assert.equal(calls,1);assert.equal(s.queue.length,0);
+});
+test('queue exhaustion is bounded and does not include candidate contents',async()=>{
+ const s=new DecisionsScheduler({concurrency:1,intervalMs:0,maxQueue:2});
+ const work=[s.run(()=>sleep(20)),s.run(()=>1),s.run(()=>2)];
+ await assert.rejects(s.run(()=>{throw Error('PRIVATE');}),{code:'provider_queue_full'});
+ await Promise.all(work);assert.equal(s.queue.length,0);
+});
+test('classifier deadline includes queue wait and expired work sends no request',async()=>{
+ const scheduler=new DecisionsScheduler({concurrency:1,intervalMs:0});const first=scheduler.run(()=>sleep(40));let calls=0;
+ const d=new PerplexityDecisions({apiKey:'synthetic',timeoutMs:5,scheduler,fetchImpl:async()=>{calls++;return response();}});
+ await assert.rejects(d.decide(input),{code:'provider_timeout'});await first;assert.equal(calls,0);
+});
+test('caller abort while queued remains cancellation and later requests can continue',async()=>{
+ const scheduler=new DecisionsScheduler({concurrency:1,intervalMs:0});const first=scheduler.run(()=>sleep(25));let calls=0;
+ const d=new PerplexityDecisions({apiKey:'synthetic',scheduler,fetchImpl:async()=>{calls++;return response();}}),c=new AbortController();
+ const result=d.decide({...input,signal:c.signal});c.abort(Error('PRIVATE REASON'));
+ await assert.rejects(result,e=>e.code==='provider_cancelled'&&!e.message.includes('PRIVATE'));await first;
+ assert.equal(calls,0);assert.equal((await d.decide(input)).probability,1);assert.equal(calls,1);
+});
+test('HTTP 429 remains withheld without an automatic retry or model fallback',async()=>{
+ let calls=0;const d=new PerplexityDecisions({apiKey:'synthetic',fetchImpl:async()=>{calls++;return new Response('PRIVATE PROVIDER BODY',{status:429});}});
+ await assert.rejects(d.decide(input),e=>e.code==='provider_http_429'&&!e.message.includes('PRIVATE'));assert.equal(calls,1);
+});
