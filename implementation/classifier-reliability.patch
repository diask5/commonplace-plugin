+// Synthetic, fixed holdout. Explicit CLI only; never part of automatic tests.
+import {writeFile,mkdir} from 'node:fs/promises';
+import {pathToFileURL} from 'node:url';
+import path from 'node:path';
+import {setTimeout as delay} from 'node:timers/promises';
+import {configuredDecider} from './policy-sharing-config.mjs';
+import {classifierHoldout} from './classifier-holdout-fixtures.mjs';
+import {PolicyContext,POLICY_THRESHOLD} from '../apps/commonplace-account/server/policy-context.mjs';
+import {DECISIONS_PROMPT_VERSION} from '../apps/commonplace-account/server/perplexity-decisions.mjs';
+const output=process.argv[2];if(!output)throw Error('Choose an evidence output path.');
+let provider=await configuredDecider(),promptVersion=DECISIONS_PROMPT_VERSION;
+if(!provider.configured||provider.local)throw Error('Hosted provider configuration required.');
+if(process.argv[3]){const baseline=await import(pathToFileURL(path.resolve(process.argv[3])));provider=new baseline.PerplexityDecisions({apiKey:provider.apiKey,endpoint:provider.endpoint,model:provider.model});promptVersion=baseline.DECISIONS_PROMPT_VERSION;}
+const rows=[];let calls=0;const started=Date.now();
+const decider={model:provider.model,decide:input=>{if(++calls>48)throw Error('Evaluation budget exceeded');return provider.decide(input);}};
+await mkdir(path.dirname(output),{recursive:true});
+for(const item of classifierHoldout){
+ const authority={id:'holdout',ownerId:'sample-owner',recipientId:'recipient',recipientLabel:item.recipient,active:true,revision:1,expiresAt:Date.now()+60000,rules:item.rules};
+ const gate=new PolicyContext({decider,getAuthority:async()=>authority,getCandidates:async()=>[item.candidate],isCurrent:async()=>true});
+ const result=await gate.preview({principal:authority.ownerId,grantId:authority.id});
+ rows.push({id:item.id,expected:item.expected,actual:!!result.recipientView.excerpts.length,audit:result.audit});
+ await delay(125);
+}
+const result={at:new Date().toISOString(),syntheticOnly:true,promptVersion,model:provider.model,threshold:POLICY_THRESHOLD,providerCalls:calls,elapsedMs:Date.now()-started,rows,summary:{cases:rows.length,permitted:rows.filter(r=>r.expected).length,forbidden:rows.filter(r=>!r.expected).length,falseAllows:rows.filter(r=>!r.expected&&r.actual).map(r=>r.id),falseWithholds:rows.filter(r=>r.expected&&!r.actual).map(r=>r.id),providerErrors:rows.filter(r=>r.audit.some(a=>a.probability===null)).length},limits:['Synthetic corpus authored before candidate evaluations; not independently authored or a safety guarantee.','One attempt per case; original thresholds, model and authority fences retained.','No production accounts or source contents used.']};
+await writeFile(output,JSON.stringify(result,null,2)+'\n',{mode:0o600});console.log(JSON.stringify({output,promptVersion,...result.summary,providerCalls:calls}));
