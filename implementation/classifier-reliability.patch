+import {SpaceContext} from '../apps/commonplace-account/server/space-context.mjs';
+import {POLICY_THRESHOLD} from '../apps/commonplace-account/server/policy-context.mjs';
+const output=process.argv[2]||'.context/sharing-stress/real-load.json',uid=()=>randomBytes(12).toString('hex');
+const network={active:0,peak:0,starts:[],statuses:[]};
+const p=await startContextPreview(),provider=await configuredDecider({fetchImpl:async(...args)=>{network.active++;network.peak=Math.max(network.peak,network.active);network.starts.push(performance.now());try{const response=await fetch(...args);network.statuses.push(response.status);return response;}finally{network.active--;}}});
+try{
+ if(!provider.configured||provider.local)throw new Error('Hosted Decisions configuration required.');
+ const people=[];
+ for(let i=0;i<10;i++)people.push((await p.service.profile({userId:'synthetic:real-sharing-load:'+i,email:'load'+i+'@example.test',displayName:i===0?'Zane':i===1?'Sam':'Collaborator '+i})).id);
+ for(const person of people.slice(1))p.work.run('INSERT INTO cp_connections(id,first_owner,second_owner) VALUES(?,?,?)',uid(),people[0],person);
+ const group=p.spaces.groups.create(people[0],{name:'Project Lumen launch',personIds:people.slice(1),nonce:uid()});
+ const publicText='Project Lumen pilot launches November 12, 2026. Eden Hart owns the rollout. Exact start time and timezone remain undecided.',privateText='Project Lumen private budget is $420,000. Private audit marker: PRIVATE_CANARY_LOAD.';
