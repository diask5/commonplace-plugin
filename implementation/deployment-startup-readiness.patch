+def wait_for_http(timeout=120, clock=time.monotonic, sleep=time.sleep, open_url=None):
+    """Bound startup grace without mistaking a slow or invalid response for ready."""
+    open_url = open_url or urllib.request.urlopen
+    deadline = clock() + timeout
+    last_error = None
+    while clock() < deadline:
+        try:
+            with open_url('http://127.0.0.1:3000/healthz',
+                          timeout=min(10, deadline - clock())) as response:
+                if json.load(response).get('ready') is not True:
+                    raise RuntimeError('HTTP health response is not ready.')
+            if clock() >= deadline:
+                raise TimeoutError('HTTP health response arrived after the startup deadline.')
+            return
+        except Exception as error:
+            last_error = error
+        remaining = deadline - clock()
+        if remaining > 0:
+            sleep(min(1, remaining))
+    raise TimeoutError('HTTP service did not become ready within the startup deadline.') from last_error
+
+
