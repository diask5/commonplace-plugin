+    def test_http_wait_accepts_slow_valid_startup_after_connection_refusal(self):
+        elapsed = [0]
+        attempts = []
+        def sleep(seconds):
+            elapsed[0] += seconds
+        def open_url(url, timeout):
+            attempts.append(timeout)
+            if len(attempts) == 1:
+                raise ConnectionRefusedError('starting')
+            elapsed[0] += 3
+            return io.BytesIO(b'{"ready":true}')
+        deploy.wait_for_http(clock=lambda: elapsed[0], sleep=sleep, open_url=open_url)
+        self.assertEqual(attempts, [10, 10])
+        self.assertEqual(elapsed[0], 4)
+
+    def test_http_wait_never_accepts_false_truthy_or_malformed_readiness(self):
+        for body in [b'{"ready":false}', b'{"ready":1}', b'{"ready":"true"}', b'{}', b'invalid']:
+            elapsed = [0]
+            def sleep(seconds):
+                elapsed[0] += seconds
+            with self.assertRaisesRegex(TimeoutError, 'startup deadline'):
+                deploy.wait_for_http(timeout=3, clock=lambda: elapsed[0], sleep=sleep,
+                                     open_url=lambda *a, **kw: io.BytesIO(body))
+            self.assertEqual(elapsed[0], 3)
+
+    def test_http_wait_caps_each_attempt_by_remaining_deadline(self):
