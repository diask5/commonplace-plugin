+export const agentConnectionsHome=()=>`<section data-view="agents" hidden><div class="social-heading"><div><h1 id="agents-home-title">Your agents</h1><p>See where your agents are connected.</p></div><button type="button" data-add-agent>Attach another agent</button></div><div id="agents-home-list" class="pair-list"></div></section><section data-view="inbox" hidden><div class="social-heading"><div><h1>Inbox</h1><p>One shared thread for each selected agent pair.</p></div></div><div id="pair-inbox" class="pair-list"></div><button type="button" id="legacy-agent-chats" class="secondary">Earlier agent conversations</button></section>`;
+export const agentConnectionsDialog=()=>`<dialog class="social-dialog" id="pair-dialog" aria-labelledby="pair-dialog-title"><div class="dialog-head"><h2 id="pair-dialog-title">Agent connection</h2><button type="button" data-close aria-label="Close">×</button></div><div class="dialog-body"><div id="pair-content"></div><p id="pair-dialog-status" role="status" aria-live="polite"></p></div></dialog>`;
+export const agentConnectionsCss=`.pair-list{background:white;border:1px solid var(--border);border-radius:14px;overflow:hidden}.pair-list .person-row{padding:18px 20px;border-bottom:1px solid var(--border);white-space:normal;min-height:78px}.pair-list .person-row:last-child{border-bottom:0}.pair-list .person-row[data-connected=true]{box-shadow:inset 3px 0 #377c55}.pair-list .person-info strong{font-size:15px;white-space:normal}.pair-list .person-info small{font-size:12px}.pair-state{font-size:12px;color:#356d4c}.pair-boundary{padding:12px;background:#f4f5f7;border-radius:8px;margin:10px 0;white-space:pre-wrap;overflow-wrap:anywhere}#pair-content .field{margin:16px 0}#pair-content .thread-message{margin:12px 0;overflow-wrap:anywhere}#pair-content .row{flex-wrap:wrap;gap:8px}#pair-content textarea{min-height:90px}#pair-content .pair-url{width:100%;font-size:12px}#pair-content h3{margin:18px 0 10px}`;
diff --git a/apps/commonplace-account/server/agent-connections.mjs b/apps/commonplace-account/server/agent-connections.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..72b7d7987fe991b450cf65843eeb6f100a91d06b
--- /dev/null
+++ b/apps/commonplace-account/server/agent-connections.mjs
@@ -0,0 +1,112 @@
+import {randomBytes,createHash} from 'node:crypto';
+import {WorkProblem} from './work.mjs';
+const uid=()=>randomBytes(12).toString('hex');
+const hash=s=>createHash('sha256').update(s).digest('hex');
+const fail=(status,message)=>{throw new WorkProblem(status,message);};
+const id=v=>{if(typeof v!=='string'||!/^[a-f0-9]{24}$/.test(v))fail(400,'Invalid agent or connection.');return v;};
+export const defaultTopic='Avoid personal details about family, religion or finances. Share useful answers only; never reveal private sources, credentials or transcripts.';
+
+// This is the common pair/policy service for native tools and the browser.
+// A pair connection grants shared messaging only; it grants no filesystem,
+// private history, execution, or delegated Chief of Staff authority.
+export class AgentConnections {
+ constructor(service,mail=service.mailboxes){this.service=service;this.mail=mail;}
+ get(...a){return this.mail.get(...a);} all(...a){return this.mail.all(...a);} run(...a){return this.mail.run(...a);} now(){return this.mail.now();}
+ policy(value={}){
+  const expiresAt=value.expiresAt??this.now()+14*86400000,topic=value.topic??defaultTopic;
+  if(!Number.isSafeInteger(expiresAt)||expiresAt<=this.now()||expiresAt>this.now()+30*86400000)fail(400,'Choose an expiry within the next 30 days.');
+  if(typeof topic!=='string'||!topic.trim()||topic.length>2000||/[\x00-\x1f\x7f]/.test(topic))fail(400,'Describe boundaries in 1–2,000 characters.');
+  return {expiresAt,topic:topic.trim()};
+ }
+ agent(agent,owner){
+  const row=this.get(`SELECT a.id,a.owner,a.created_at AS attachedAt,b.label,b.provider,b.seen_at AS lastSeenAt,p.name AS ownerName FROM cp_agent_addresses a
+   JOIN cp_agent_bindings b ON b.agent=a.id JOIN cp_devices d ON d.id=b.device JOIN cp_profiles p ON p.id=a.owner
+   WHERE a.id=? AND a.revoked_at IS NULL AND d.revoked=0`,id(agent));
+  if(!row||owner&&row.owner!==owner)fail(404,'Agent unavailable.');
+  try{this.mail.history.target({owner:row.owner},row.id);}catch{fail(404,'Agent unavailable.');}return row;
+ }
+ create(owner,input){
+  const a=this.agent(input.agentId,owner),policy=this.policy(input),direction=input.direction??'delegate';
+  if(!['request','delegate'].includes(direction))fail(400,'Choose request or delegate.');
+  const token=randomBytes(32).toString('base64url'),invite=uid(),now=this.now(),expiresAt=Math.min(policy.expiresAt,now+7*86400000);
+  this.run('INSERT INTO cp_agent_pair_invites(id,owner,agent,token_hash,direction,policy,created_at,expires_at) VALUES(?,?,?,?,?,?,?,?)',invite,owner,a.id,hash(token),direction,JSON.stringify(policy),now,expiresAt);
+  return {id:invite,url:this.service.origin+'/#agent-invite='+token,invitation:token,expiresAt,policy,direction};
+ }
+ invitation(value){
+  if(typeof value!=='string'||value.length>2048)fail(400,'Open the agent invitation link.');
+  const prefix=this.service.origin+'/#agent-invite=';const token=value.startsWith(prefix)?value.slice(prefix.length):value;
+  if(!/^[A-Za-z0-9_-]{43}$/.test(token))fail(400,'Open the agent invitation link.');
+  const row=this.get('SELECT * FROM cp_agent_pair_invites WHERE token_hash=?',hash(token));
+  if(!row)fail(404,'Invitation unavailable.');return row;
+ }
+ preview(owner,input){
+  const row=this.invitation(input.invitation);
+  if(row.accepted_by&&row.accepted_by!==owner)fail(409,'This invitation was already accepted.');
+  if(!row.accepted_by&&row.expires_at<=this.now())fail(409,'Invitation expired. Ask for a fresh link.');
+  const a=this.agent(row.agent);
+  return {inviter:{name:a.ownerName,agentName:a.label,provider:a.provider},direction:row.direction,policy:JSON.parse(row.policy),expiresAt:row.expires_at,
+   accepted:!!row.accepted_by,conversationId:row.accepted_by===owner?row.conversation:null,ownInvitation:row.owner===owner,
+   scope:'Shared answers and messages only. Both owners can read the full thread, including after it ends. Private sources and tool permissions are not shared.'};
+ }
+ pair(conversation){return this.get('SELECT p.*,t.first_agent,t.second_agent FROM cp_agent_pair_connections p JOIN cp_mail_conversations t ON t.id=p.conversation WHERE p.conversation=?',id(conversation));}
+ active(row){if(!row||row.revoked_at||JSON.parse(row.first_policy).expiresAt<=this.now()||JSON.parse(row.second_policy).expiresAt<=this.now())return false;try{this.agent(row.first_agent,row.first_owner);this.agent(row.second_agent,row.second_owner);return true;}catch{return false;}}
+ view(row){
+  const participants=[row.first_agent,row.second_agent].map((agent,i)=>{
+   const a=this.get("SELECT a.id,COALESCE(b.label,'Unavailable agent') AS name,COALESCE(b.provider,'unknown') AS provider,p.name AS ownerName,a.owner AS ownerId FROM cp_agent_addresses a LEFT JOIN cp_agent_bindings b ON b.agent=a.id JOIN cp_profiles p ON p.id=a.owner WHERE a.id=?",agent);
+   return {...a,policy:JSON.parse(i?row.second_policy:row.first_policy)};
+  });
+  return {id:row.conversation,participants,state:row.revoked_at?'severed':Math.min(...participants.map(p=>p.policy.expiresAt))<=this.now()?'expired':this.active(row)?'active':'unavailable',createdAt:row.created_at,canSend:this.active(row),expiresAt:Math.min(...participants.map(p=>p.policy.expiresAt))};
+ }
+ owned(owner,conversation){const row=this.pair(conversation);if(!row||![row.first_owner,row.second_owner].includes(owner))fail(404,'Connection unavailable.');return row;}
+ accept(owner,input){return this.mail.tx(()=>{
+  const invite=this.invitation(input.invitation),a=this.agent(invite.agent),b=this.agent(input.agentId,owner);
+  if(a.owner===owner)fail(400,'Your own agents already share your account. Invite another person.');
+  if(invite.accepted_by){if(invite.accepted_by!==owner||invite.accepted_agent!==b.id)fail(409,'Invitation already accepted with another agent.');return this.view(this.owned(owner,invite.conversation));}
+  if(invite.expires_at<=this.now())fail(409,'Invitation expired. Ask for a fresh link.');
+  const policy=this.policy(input),firstPolicy=JSON.parse(invite.policy);
+  if(firstPolicy.expiresAt<=this.now())fail(409,'Invitation boundaries expired. Ask for a fresh link.');
+  const pair=[a.id,b.id].sort();let thread=this.get('SELECT * FROM cp_mail_conversations WHERE first_agent=? AND second_agent=?',...pair);
+  if(!thread){thread={id:uid()};this.run('INSERT INTO cp_mail_conversations VALUES(?,?,?,?)',thread.id,...pair,this.now());}
+  const existing=this.pair(thread.id);
+  if(existing?.revoked_at&&invite.created_at<=existing.revoked_at)fail(409,'Connection ended after this invitation. Create a new invitation.');
+  if(!this.active(existing)){
+   const aFirst=pair[0]===a.id;
+   this.run(`INSERT INTO cp_agent_pair_connections(conversation,first_owner,second_owner,first_policy,second_policy,created_at) VALUES(?,?,?,?,?,?)
+    ON CONFLICT(conversation) DO UPDATE SET first_policy=excluded.first_policy,second_policy=excluded.second_policy,revoked_at=NULL,revoked_by=NULL`,thread.id,aFirst?a.owner:owner,aFirst?owner:a.owner,JSON.stringify(aFirst?firstPolicy:policy),JSON.stringify(aFirst?policy:firstPolicy),this.now());
+  }else{
+   // Accepting another invitation must respect the newly selected restrictions
+   // as well as the active grant. Never silently keep a wider old boundary.
+   const narrow=(before,after)=>{
+    const topic=before.topic===after.topic?before.topic:before.topic+'\nAdditional restrictions (both apply): '+after.topic;
+    if(topic.length>2000)fail(409,'Combined boundaries are too long. End this connection before establishing different boundaries.');
+    return {expiresAt:Math.min(before.expiresAt,after.expiresAt),topic};
+   };
+   const aFirst=pair[0]===a.id;
+   this.run('UPDATE cp_agent_pair_connections SET first_policy=?,second_policy=? WHERE conversation=?',JSON.stringify(narrow(JSON.parse(existing.first_policy),aFirst?firstPolicy:policy)),JSON.stringify(narrow(JSON.parse(existing.second_policy),aFirst?policy:firstPolicy)),thread.id);
+  }
+  this.run('UPDATE cp_agent_pair_invites SET accepted_by=?,accepted_agent=?,conversation=? WHERE id=?',owner,b.id,thread.id,invite.id);
+  return this.view(this.pair(thread.id));
+ });}
+ list(owner){
+  const connections=this.all('SELECT p.*,t.first_agent,t.second_agent FROM cp_agent_pair_connections p JOIN cp_mail_conversations t ON t.id=p.conversation WHERE p.first_owner=? OR p.second_owner=? ORDER BY p.created_at DESC',owner,owner).map(r=>{
+   const last=this.get('SELECT body,created_at FROM cp_mail_messages WHERE conversation=? ORDER BY seq DESC LIMIT 1',r.conversation);
+   return {...this.view(r),preview:last?.body.slice(0,300)||'',updatedAt:last?.created_at||r.created_at};
+  });
+  const agents=this.all('SELECT a.id FROM cp_agent_addresses a JOIN cp_agent_bindings b ON b.agent=a.id JOIN cp_devices d ON d.id=b.device WHERE a.owner=? AND a.revoked_at IS NULL AND d.revoked=0 ORDER BY b.label',owner).flatMap(r=>{let a;try{a=this.agent(r.id,owner);}catch{return [];}return [{...a,activeConnections:connections.filter(c=>c.state==='active'&&c.participants.some(p=>p.id===a.id)).length}];});
+  return {agents,connections};
+ }
+ read(owner,input){
+  const row=this.owned(owner,input.conversationId),before=input.before??Number.MAX_SAFE_INTEGER;
+  if(!Number.isSafeInteger(before)||before<1)fail(400,'Invalid message cursor.');
+  const messages=this.all('SELECT m.seq,m.id,m.sender,m.body AS text,m.created_at AS at,d.state AS delivery FROM cp_mail_messages m LEFT JOIN cp_mail_deliveries d ON d.message=m.id WHERE m.conversation=? AND m.seq<? ORDER BY m.seq DESC LIMIT 101',row.conversation,before),hasMore=messages.length>100;
+  messages.splice(100);messages.reverse();return {...this.view(row),messages,hasMore,nextBefore:hasMore?messages[0].seq:null};
+ }
+ sever(owner,input){return this.mail.tx(()=>{
+  const row=this.owned(owner,input.conversationId);
+  this.run('UPDATE cp_agent_pair_connections SET revoked_at=coalesce(revoked_at,?),revoked_by=coalesce(revoked_by,?) WHERE conversation=?',this.now(),owner,row.conversation);
+  // A host may already have accepted dispatching/uncertain work. Preserve its
+  // receipt for reconciliation; only work not handed to the host is blocked.
+  this.run("UPDATE cp_mail_deliveries SET state='blocked',claim=NULL,lease_until=0 WHERE message IN (SELECT id FROM cp_mail_messages WHERE conversation=?) AND state IN ('pending','claimed')",row.conversation);
+  return this.view(this.pair(row.conversation));
+ });}
+}
