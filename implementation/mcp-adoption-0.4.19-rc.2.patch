diff --git a/apps/commonplace-account/drizzle/0044_agent_pair_connections.sql b/apps/commonplace-account/drizzle/0044_agent_pair_connections.sql
new file mode 100644
index 0000000000000000000000000000000000000000..dc4a496979fe8bb11bf8170bcfe685953ad0bc0b
--- /dev/null
+++ b/apps/commonplace-account/drizzle/0044_agent_pair_connections.sql
@@ -0,0 +1,24 @@
+-- Opt-in pair connections. Legacy grants/threads keep their original audience.
+CREATE TABLE IF NOT EXISTS cp_agent_pair_connections (
+ conversation TEXT PRIMARY KEY REFERENCES cp_mail_conversations(id),
+ first_owner TEXT NOT NULL REFERENCES cp_profiles(id),
+ second_owner TEXT NOT NULL REFERENCES cp_profiles(id),
+ first_policy TEXT NOT NULL,
+ second_policy TEXT NOT NULL,
+ created_at INTEGER NOT NULL,
+ revoked_at INTEGER,
+ revoked_by TEXT
+);
+CREATE TABLE IF NOT EXISTS cp_agent_pair_invites (
+ id TEXT PRIMARY KEY,
+ owner TEXT NOT NULL REFERENCES cp_profiles(id),
+ agent TEXT NOT NULL REFERENCES cp_agent_addresses(id),
+ token_hash TEXT NOT NULL UNIQUE,
+ direction TEXT NOT NULL CHECK(direction IN ('request','delegate')),
+ policy TEXT NOT NULL,
+ created_at INTEGER NOT NULL,
+ expires_at INTEGER NOT NULL,
+ accepted_by TEXT,
+ accepted_agent TEXT,
+ conversation TEXT REFERENCES cp_mail_conversations(id)
+);
