new file mode 100644
index 0000000000000000000000000000000000000000..e747be8de7e7eaafdbb82fff7e6e87e034cce122
--- /dev/null
+++ b/scripts/build-mcp.mjs
@@ -0,0 +1,28 @@
+import {copyFile,readFile,writeFile,readdir} from 'node:fs/promises';
+import path from 'node:path';
+import {createHash} from 'node:crypto';
+import {build} from 'esbuild';
+import {fileURLToPath} from 'node:url';
+const root=fileURLToPath(new URL('../',import.meta.url)),source='apps/commonplace/server/mcp-adapter-source.mjs';
+const digest=createHash('sha256').update(await readFile(path.join(root,source))).digest('hex');
+const result=await build({absWorkingDir:root,entryPoints:[source],metafile:true,
+ outfile:'apps/commonplace/server/mcp-adapter.mjs',bundle:true,platform:'node',format:'esm',target:'node22',
+ minify:true,legalComments:'inline',banner:{js:'// Generated by npm run build:mcp. Edit mcp-adapter-source.mjs, not this file.\n// Source-SHA256: '+digest+'\n// Third-party licenses: mcp-adapter.LICENSE.txt\nimport {createRequire as __createRequire} from "node:module"; const require=__createRequire(import.meta.url);'}});
+const packages=new Map();
+for(const input of Object.keys(result.metafile.inputs)){
+ if(!input.startsWith('node_modules/'))continue;
+ let dir=path.dirname(path.join(root,input));
+ while(dir!==root){
+  try{const pkg=JSON.parse(await readFile(path.join(dir,'package.json'),'utf8'));if(pkg.name){packages.set(dir,pkg);break;}}catch{}
+  const parent=path.dirname(dir);if(parent===dir)break;dir=parent;
+ }
+}
+let licenses='Bundled dependency notices for the Meet Proxy MCP adapter.\n';
+for(const [dir,pkg] of [...packages].sort((a,b)=>a[1].name.localeCompare(b[1].name))){
+ licenses+='\n=== '+pkg.name+' '+pkg.version+' ('+pkg.license+') ===\n';
+ const files=(await readdir(dir)).filter(n=>/^(licen[cs]e|notice|copyright)(\..*)?$/i.test(n)).sort();
+ if(!files.length)throw Error('Missing license for '+pkg.name);
+ for(const file of files)licenses+='\n'+await readFile(path.join(dir,file),'utf8')+'\n';
+}
+await writeFile(root+'apps/commonplace/server/mcp-adapter.LICENSE.txt',licenses);
+for(const name of ['mcp-adapter.mjs','mcp-adapter.LICENSE.txt'])await copyFile(root+'apps/commonplace/server/'+name,root+'apps/commonplace-account/server/'+name);
