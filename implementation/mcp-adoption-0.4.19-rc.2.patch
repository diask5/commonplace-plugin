+ work.run('INSERT INTO cp_mail_messages(id,conversation,sender,recipient,body,response_requested,nonce,created_at) VALUES(?,?,?,?,?,0,?,?)',message,conversation,a.id,b.id,'Retained audit message',uid(),Date.now());
