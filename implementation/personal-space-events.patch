diff --git a/apps/commonplace/server/personal-space.mjs b/apps/commonplace/server/personal-space.mjs
new file mode 100644
index 0000000..c2a7109
--- /dev/null
+++ b/apps/commonplace/server/personal-space.mjs
@@ -0,0 +1,17 @@
+import {randomBytes} from 'node:crypto';
+import {accountChatAllowed} from './account-profiles.mjs';
+
+// Publish only fixed lifecycle observations. Never send a hook prompt, tool
+// arguments, a transcript file path, or a hidden host payload as progress.
+export async function reportPersonalSpace({client,session,event,observedAt=Date.now(),allowed=async()=>true}){
+ if(!session?.verified||!['SessionStart','UserPromptSubmit','PostToolUse','Stop'].includes(event)||!await accountChatAllowed(client.dir,session,{history:true})||!await allowed())return {recorded:false,reason:'scope'};
+ const call=async(name,args={})=>{
+  const r=await client.request('local/mcp',{jsonrpc:'2.0',id:'personal-space',method:'tools/call',_commonplaceSession:session,params:{name,arguments:args}},10000);
+  if(r?.error||r?.result?.isError)throw Error('Personal space observation unavailable.');
+  return JSON.parse(r.result.content.find(c=>c.type==='text').text);
+ };
+ const registration=await call('_mailbox_register');
+ if(!registration.personalSpace?.supported)return {recorded:false,reason:'unsupported-server'};
+ if(!await accountChatAllowed(client.dir,session,{history:true})||!await allowed())return {recorded:false,reason:'scope-changed'};
+ return call('_personal_space_observe',{event,observedAt,nonce:randomBytes(12).toString('hex')});
+}
