new file mode 100644
index 0000000..45bc9c9
--- /dev/null
+++ b/apps/commonplace-account/server/space-resources.mjs
@@ -0,0 +1,40 @@
+// Space events share their authorization and durable cursor with tools. Only a
+// URI is pushed; transcript bytes always require a separate authorized read.
+export function createSpaceResources({context,call,scope,available=async()=>true,intervalMs=15000}){
+ const parse=uri=>{
+  const match=typeof uri==='string'&&uri.match(/^meetproxy:\/\/spaces\/([a-f0-9]{24})(?:\/agents\/([a-f0-9]{24}))?\/events(?:\?after=(\d+)(?:&through=(\d+))?)?$/);
+  if(!match)throw Error('Choose a space event resource.');
+  const [,groupId,agentId,after,through]=match;
+  if([after,through].some(v=>v!==undefined&&!Number.isSafeInteger(Number(v))))throw Error('Invalid event cursor.');
+  return {groupId,...(agentId?{agentId}:{}),...(after!==undefined?{after:Number(after)}:{}),...(through!==undefined?{through:Number(through)}:{})};
+ };
+ const authorized=async(args,identity)=>{
+  if(!await available()||await scope()!==identity)throw Error('Space subscription scope changed.');
+  const result=await call('read_space_events',args);
+  if(!await available()||await scope()!==identity)throw Error('Space subscription scope changed.');
+  return result;
+ };
+ const baseUri=args=>'meetproxy://spaces/'+args.groupId+(args.agentId?'/agents/'+args.agentId:'')+'/events';
+ return {
+  list:params=>context.list(params),
+  templates:async()=>{const r=await context.templates();return !await available()?r:{...r,resourceTemplates:[...r.resourceTemplates,{uriTemplate:'meetproxy://spaces/{groupId}/events',name:'Space event stream',mimeType:'application/json',description:'Use a current space ID from list_context_spaces. Resume with ?after=cursor; pin &through while paging.'},{uriTemplate:'meetproxy://spaces/{groupId}/agents/{agentId}/events',name:'Personal agent events',mimeType:'application/json',description:'An agent on your own verified account, within your Personal space only.'}]};},
+  read:async uri=>{
+   if(!uri.startsWith('meetproxy://spaces/'))return context.read(uri);
+   const args=parse(uri),result=await authorized(args,await scope());
+   return {contents:[{uri,mimeType:'application/json',text:JSON.stringify({...result,nextResourceUri:baseUri(args)+'?after='+result.cursor+(result.hasMore?'&through='+result.through:'')})}]};
+  },
+  watch:async(uri,notify)=>{
+   const args=parse(uri);if(args.after!==undefined||args.through!==undefined)throw Error('Subscribe to the stable space events URI without cursors.');
+   const identity=await scope();let seen=(await authorized({...args,headOnly:true},identity)).cursor,stopped=false,running=false;
+   const timer=setInterval(async()=>{
+    if(stopped||running)return;running=true;
+    try{
+     const result=await authorized({...args,headOnly:true},identity);if(stopped)return;
+     if(result.cursor!==seen){await notify(uri);seen=result.cursor;}
+    }catch{stop();}finally{running=false;}
+   },intervalMs);timer.unref?.();
+   function stop(){stopped=true;clearInterval(timer);}
+   return stop;
+  },
+ };
+}
diff --git a/apps/commonplace-account/server/space-subscriptions.mjs b/apps/commonplace-account/server/space-subscriptions.mjs
new file mode 100644
index 0000000..9e1e93b
--- /dev/null
+++ b/apps/commonplace-account/server/space-subscriptions.mjs
@@ -0,0 +1,31 @@
+// Modern MCP owns SSE framing/filters. Each authenticated listen request has
+// bounded, reauthorized space watchers; the durable workspace cursor handles
+// reconnects. Nothing here starts a model or pushes transcript bodies.
+const active=new WeakMap();
+export async function serveSpaceSubscriptions(request,handler,resources,service,device){
+ let message;try{message=await request.clone().json();}catch{return handler.fetch(request).finally(()=>handler.close());}
+ if(message.method!=='subscriptions/listen')return handler.fetch(request).finally(()=>handler.close());
+ const uris=message.params?.notifications?.resourceSubscriptions;
+ if(!Array.isArray(uris)||uris.length<1||uris.length>8||uris.some(u=>typeof u!=='string')){await handler.close();return Response.json({jsonrpc:'2.0',id:message.id,error:{code:-32602,message:'Subscribe to one through eight explicit space event resources.'}});}
+ let counts=active.get(service);if(!counts){counts=new Map();active.set(service,counts);}
+ if((counts.get(device.id)||0)>=2){await handler.close();return Response.json({jsonrpc:'2.0',id:message.id,error:{code:-32603,message:'At most two event streams per installation.'}});}
+ counts.set(device.id,(counts.get(device.id)||0)+1);
+ const stops=[];let closed=false,timer;
+ const cleanup=async()=>{if(closed)return;closed=true;clearTimeout(timer);request.signal.removeEventListener('abort',cleanup);for(const stop of stops)stop();const count=counts.get(device.id)-1;if(count)counts.set(device.id,count);else counts.delete(device.id);await handler.close();};
+ request.signal.addEventListener('abort',cleanup,{once:true});
+ try{
+  for(const uri of new Set(uris)){
+   const stop=await resources.watch(uri,u=>handler.notify.resourceUpdated(u));if(closed){stop();throw Error('Event stream ended.');}stops.push(stop);
+  }
+  if(request.signal.aborted)throw Error('Event stream ended.');
+  const response=await handler.fetch(request);
+  if(!response.ok||!response.headers.get('content-type')?.includes('text/event-stream')){await cleanup();return response;}
+  timer=setTimeout(()=>void cleanup(),15*60000);timer.unref?.();
+  const reader=response.body.getReader();
+  const body=new ReadableStream({
+   async pull(controller){try{const part=await reader.read();if(part.done){controller.close();await cleanup();}else controller.enqueue(part.value);}catch(error){controller.error(error);await cleanup();}},
+   async cancel(reason){try{await reader.cancel(reason);}finally{await cleanup();}},
+  });
+  return new Response(body,{status:response.status,headers:response.headers});
+ }catch{await cleanup();return Response.json({jsonrpc:'2.0',id:message.id,error:{code:-32602,message:'Space subscription unavailable. Check current access and the space events URI.'}});}
+}
