+  if(headOnly){const watched=agentId?this.get(`SELECT coalesce(max(seq),0) AS n FROM (SELECT c.seq FROM cp_workspace_messages m JOIN cp_workspace_changes c ON c.workspace=m.workspace AND c.type='message' AND c.id=m.id WHERE m.workspace=? AND m.agent_id=? UNION ALL SELECT seq FROM cp_workspace_changes WHERE workspace=? AND type='transcript' AND json_extract(value,'$.agentId')=?)`,groupId,agentId,groupId,agentId).n:high;return {...base,cursor:watched,events:[],hasMore:false};}
