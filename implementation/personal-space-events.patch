new file mode 100644
index 0000000..4e569ef
--- /dev/null
+++ b/apps/commonplace-account/drizzle/0046_personal_space.sql
@@ -0,0 +1,42 @@
+-- Personal spaces reuse group membership, message history and archive access.
+CREATE TABLE cp_personal_spaces (
+ owner TEXT PRIMARY KEY REFERENCES cp_profiles(id),
+ workspace TEXT NOT NULL UNIQUE REFERENCES cp_groups(workspace)
+);
+ALTER TABLE cp_workspace_messages ADD COLUMN agent_id TEXT;
+ALTER TABLE cp_workspace_messages ADD COLUMN agent_generation INTEGER;
+ALTER TABLE cp_workspace_messages ADD COLUMN agent_metadata TEXT;
+CREATE INDEX cp_workspace_agent_messages ON cp_workspace_messages(agent_id,agent_generation,seq);
+-- Defend every legacy membership/invitation route, not only the browser UI.
+CREATE TRIGGER cp_personal_member_insert BEFORE INSERT ON cp_workspace_members
+ WHEN EXISTS(SELECT 1 FROM cp_personal_spaces WHERE workspace=NEW.workspace AND owner!=NEW.person)
+ BEGIN SELECT RAISE(ABORT,'Personal spaces cannot add other people'); END;
+CREATE TRIGGER cp_personal_member_update BEFORE UPDATE ON cp_workspace_members
+ WHEN EXISTS(SELECT 1 FROM cp_personal_spaces WHERE workspace=NEW.workspace AND owner!=NEW.person)
+ BEGIN SELECT RAISE(ABORT,'Personal spaces cannot add other people'); END;
+CREATE TRIGGER cp_personal_invite BEFORE INSERT ON cp_workspace_invites
+ WHEN EXISTS(SELECT 1 FROM cp_personal_spaces WHERE workspace=NEW.workspace)
+ BEGIN SELECT RAISE(ABORT,'Use a shared space to invite people'); END;
+-- Extend the existing durable workspace change stream; no parallel event store.
+CREATE TRIGGER cp_space_transcript_insert AFTER INSERT ON cp_context_origins
+ WHEN NEW.state='current' BEGIN
+ INSERT INTO cp_workspace_changes(workspace,type,id,value)
+ SELECT p.workspace,'transcript',s.id,json_object('agentId',NEW.agent,'generation',NEW.generation)
+ FROM cp_context_streams s JOIN cp_personal_spaces p ON p.owner=s.owner
+ WHERE s.id=NEW.stream AND s.excluded=0;
+END;
+CREATE TRIGGER cp_space_transcript_update AFTER UPDATE ON cp_context_origins
+ WHEN NEW.state='current' AND (OLD.state!='current' OR NEW.digest IS NOT OLD.digest) BEGIN
+ INSERT INTO cp_workspace_changes(workspace,type,id,value)
+ SELECT p.workspace,'transcript',s.id,json_object('agentId',NEW.agent,'generation',NEW.generation)
+ FROM cp_context_streams s JOIN cp_personal_spaces p ON p.owner=s.owner
+ WHERE s.id=NEW.stream AND s.excluded=0;
+END;
+-- An exclusion erases copied message data in the existing change log as well.
+CREATE TRIGGER cp_personal_progress_delete BEFORE DELETE ON cp_workspace_messages
+ WHEN OLD.agent_id IS NOT NULL AND EXISTS(SELECT 1 FROM cp_personal_spaces WHERE workspace=OLD.workspace) BEGIN
+ UPDATE cp_workspace_changes SET value=NULL WHERE workspace=OLD.workspace AND type='message' AND id=OLD.id;
+ INSERT INTO cp_workspace_changes(workspace,type,id,value) VALUES(OLD.workspace,'message',OLD.id,NULL);
+END;
+CREATE INDEX cp_space_change_reference ON cp_workspace_changes(workspace,type,id,seq);
+CREATE INDEX cp_space_transcript_agent ON cp_workspace_changes(workspace,json_extract(value,'$.agentId'),seq) WHERE type='transcript';
