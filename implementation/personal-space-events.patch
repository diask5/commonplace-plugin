+  for(const row of page){
+   let kind,reference,authorAgent;
+   if(row.type==='message'){
+    const m=this.get('SELECT id,agent_id,agent_generation,agent_metadata FROM cp_workspace_messages WHERE workspace=? AND id=?',groupId,row.id);if(!m)continue;
+    authorAgent=m.agent_id;
