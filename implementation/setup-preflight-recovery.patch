+export function contextActivationRequest({app,origin,account,space,token}){
+ if(!Object.hasOwn(setupApps,app)||!account||!/^commonplace-context:[A-Za-z0-9_-]{43}$/.test(token||''))return '';
+ return 'Finish Meet Proxy setup in THIS new '+(app==='claude'?'Claude Desktop Code':setupApps[app])+' chat at '+origin+'. I signed in as '+(account.email||account.name)+'. I selected this new chat to finish the installation I requested'+(space?.type==='group'?' for space '+space.id:'')+'.\n\n'
+ +'Use the installed Meet Proxy tools. Check setup_status first. If the configured account or server differs, stop and name the mismatch; preserve the existing connection. Do not disconnect, replace credentials, or read another account’s context. If the tools are still absent, report that this new session has not loaded the installation and the supported host setup action needed. Do not repeat installation, invent a reload command, or use shell/HTTP instead of missing or denied tools.\n\n'
+ +'With the correct account and server, call finish_context_setup with token '+token+'. This carries my verified sign-in and authorizes automatic private collection of supported visible work chats; existing exclusions stay in force. Do not call connect_account or ask for another Google login. After a successful claim, check context_sync_status and this installation’s collection receipts, then verify a fresh successful source read. Cached counts or an opened app do not prove completion.\n\n'
+ +'If expired or already claimed by another chat, stop and use the browser’s setup status; never move that chat silently. Respect host approvals; opening a new chat does not clear a denial. Do not store the token in files or memory. Do not enable cloud inference or share my private archive with others. Give a short result; the browser confirms actual progress.';
+}
