-const claudeInstall='For Claude Code, inspect the installed plugins first. Reuse a working meet-proxy/commonplace alias. If installation is needed, use the supported plugin manager: claude plugin marketplace add diask5/commonplace-plugin, then claude plugin install meet-proxy@commonplace. Update the existing alias when present; keep only one enabled. The plugin includes its MCP server: do not add a second MCP entry. Reload using host controls if required.';
+const claudeInstall='For Claude Code, resolve the installer before invoking plugin commands. Prefer this chat’s executable from CLAUDE_CODE_EXECPATH when present and executable; quote its full path, including spaces. Otherwise resolve the host’s Claude executable. Check --version and top-level --help first: it must list the plugin command. An older PATH executable may treat plugin arguments as a model prompt. Never run plugin subcommands through that executable or change models to make installation work. Use the verified executable for every plugin command: plugin list, plugin marketplace list, then plugin marketplace update commonplace if already registered (otherwise plugin marketplace add diask5/commonplace-plugin). Reuse a working meet-proxy/commonplace alias; update it with plugin update. If absent, run plugin install meet-proxy@commonplace. Keep only one alias enabled. The plugin includes its MCP server: do not add a second MCP entry. Use the supported host installer when no compatible executable is available; do not launch a model to install a plugin.';
 const codexInstall='For Codex, reuse a working Meet Proxy MCP installation. Otherwise get the latest published Meet Proxy ZIP from https://github.com/diask5/commonplace-plugin/releases, verify its published SHA-256, extract to a permanent folder and run its server/configure-codex.mjs with the bundled OS runtime from this actual chat shell. The helper configures MCP and preserves existing settings. Never invent native identity variables.';
 export function contextSetupRequest({app,origin,account,space,token}){
  if(!Object.hasOwn(setupApps,app)||!account||!/^commonplace-context:[A-Za-z0-9_-]{43}$/.test(token||''))return '';
  const install=app==='claude'?claudeInstall:app==='codex'?codexInstall:'Use the installer for this Conductor chat’s actual provider. '+claudeInstall+' '+codexInstall;
  return 'Set up Meet Proxy in THIS '+(app==='claude'?'Claude Code':setupApps[app])+' chat at '+origin+'. Do the setup now, rather than giving me a list of steps. I already signed in as '+(account.email||account.name)+'.\n\n'
  +'I authorize routine plugin installation/configuration, automatic private collection of supported visible work chats'+(space?.type==='group'?', and using THIS chat for space '+space.id:'')+'. Existing exclusions stay in force.\n\n'
- +'First use setup_status if loaded. If finish_context_setup is already available and the server/account match, skip installation. '+install+'\n\n'
- +'Verify the exact server origin before continuing; preserve and report any existing server or account mismatch. Call finish_context_setup with token '+token+'. This private 30-minute handoff carries my verified sign-in; do not call connect_account or request a second Google login. It starts collection automatically. Check context_sync_status; the browser confirms progress.\n\n'
- +'Respect host approvals. If blocked, stop that action and explain the exact approval/reload needed; never change permissions or substitute shell/HTTP for a denied tool. If the latest release lacks finish_context_setup, report the missing release capability. Keep this chat and its real identity. Do not enable cloud inference or share my private archive with other members.';
+ +'1. Check the account before installing or claiming this request. First use setup_status if loaded. Otherwise, if an existing Meet Proxy profile is present, inspect only session.origin and session.humanAccount.email from account-client.json in the configured COMMONPLACE_DATA_DIR or ~/.commonplace. Do not print the file, tokens, credentials or unrelated settings. An absent profile is a fresh setup, not a mismatch. Compare any existing linked account and configured origin with the exact server and signed-in email above. If an existing account or origin differs, stop setup before installation or finish_context_setup and clearly name the mismatch. Preserve the existing account. Browser sign-in does not switch an installed account. Offer signing in here with that existing account, or using a separate computer/OS user profile for the work account. This setup flow does not support replacing a linked account: do not invent an account-switch tool, delete credentials, or call internal disconnect/revoke routes. Do not read another account’s synced chats to demonstrate progress.\n\n'
+ +'2. If finish_context_setup is already available and the server/account match, skip installation. '+install+'\n\n'
+ +'3. If installation succeeds but finish_context_setup is not available in this session, return to the signed-in browser setup and select “Plugin installed? Finish in a new chat”. That action prepares an activation prompt carrying this same account, space and unclaimed handoff into the new chat the user chooses. Claude Desktop opens a new Code composer; Conductor needs a new chat in the same workspace. The user still sends the prompt. Do not prescribe /reload-plugins in Conductor or Claude Desktop, claim MCP status refresh mounts tools into an existing conversation, or keep probing missing tools. A terminal-only reload command is not a GUI setup step. Do not silently open or move conversations. Do not create memory files or save the token elsewhere.\n\n'
+ +'4. Call finish_context_setup with token '+token+'. This private 30-minute handoff carries my verified sign-in; do not call connect_account or request a second Google login. It starts collection automatically. Only after a successful matching-account claim, check context_sync_status and verify this installation’s collection receipts and a fresh successful source read. Cached conversation counts are not proof that this setup or collector works. The browser confirms progress. If the token expired, copy a fresh request from the still-signed-in setup page; no second Google login is needed.\n\n'
+ +'Respect host approvals. If blocked, stop that action and explain the exact required host action; never change permissions or substitute shell/HTTP for a denied tool. Opening a new chat does not clear a host denial. Report an unavailable companion or old background runtime accurately; do not promise that another reload will fix it, force-kill it, or inspect unrelated secrets. Keep this chat and its real identity. Do not enable cloud inference or share my private archive with other members. Finish with a short result and only the next action actually required.';
 }
 export function contextSetupLink(app,prompt){return ({claude:'claude://code/new?q=',codex:'codex://threads/new?prompt=',conductor:'conductor://prompt='})[app]+encodeURIComponent(prompt);}
+
