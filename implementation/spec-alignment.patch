@@ -35,7 +35,7 @@ export function pluginResponse(request, response) {
   if (request.method === 'initialize' && response?.result) {
     response.result.instructions += ' read_chat_link returns per-message delivery receipts: queued, received by plugin, submitted to chat, read, or replied. Submission does not prove reading; peer presence does not prove receipt. Report the exact delivery.state and delivery.waitingReason when delivery is uncertain. Direct tool reads record read receipts; background prefetches do not.';
     response.result.instructions += ' When the owner says add a person to this chat and they already share a conversation, resolve the accepted person using list_connections and call add_person_to_chat with personId. If multiple conversations are returned, ask which one, then repeat with linkId. Reuse the existing conversation; do not create another invitation or sign-in. This explicitly moves only the owner’s receiving side here; the teammate independently controls their destination. Use that linkId for messages.';
