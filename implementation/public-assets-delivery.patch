+import base64
+import hashlib
+import importlib.util
+import json
+import re
+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+SERVER = ROOT / 'apps/commonplace-account/server'
+PREFIX = 'dist/standalone/account-runtime/context-assets/'
+
+
+def load_builder():
+    spec = importlib.util.spec_from_file_location('build_runtime_update', ROOT / 'scripts/build-runtime-update.py')
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def node_json(script):
+    base = SERVER.as_uri() + '/'
+    out = subprocess.run(['node', '--input-type=module', '-e', script, base], check=True, capture_output=True, cwd=ROOT)
+    return json.loads(out.stdout)
+
+
+class RuntimePublicAssetsTest(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.tmp = tempfile.TemporaryDirectory()
+        cls.output = Path(cls.tmp.name)
+        cls.manifest = load_builder().build(cls.output)
+        cls.bundle = json.loads((cls.output / 'runtime-update.json').read_text())
+        cls.source = node_json(
+            "const b=process.argv[1];const {assetTypes}=await import(b+'context-http.mjs');"
+            "const {uiCss}=await import(b+'ui-system.mjs');process.stdout.write(JSON.stringify({assetTypes,uiCss}));")
+
+    @classmethod
+    def tearDownClass(cls):
+        cls.tmp.cleanup()
+
+    def test_existing_manifest_fields_unchanged(self):
+        self.assertEqual({'bundle', 'sha256', 'files', 'publicAssets'}, set(self.manifest))
+        self.assertEqual('runtime-update.json', self.manifest['bundle'])
+        self.assertEqual(hashlib.sha256((self.output / 'runtime-update.json').read_bytes()).hexdigest(), self.manifest['sha256'])
+        self.assertEqual(json.loads((self.output / 'runtime-update-manifest.json').read_text()), self.manifest)
+        for name, digest in self.manifest['files'].items():
+            self.assertEqual(digest, hashlib.sha256(base64.b64decode(self.bundle[name])).hexdigest())
+
+    def test_ui_css_matches_actual_source_bytes(self):
+        data = base64.b64decode(self.bundle[PREFIX + 'ui.css'])
+        self.assertEqual(self.source['uiCss'].encode('utf-8'), data)
+        self.assertEqual(hashlib.sha256(data).hexdigest(), self.manifest['publicAssets']['ui.css']['sha256'])
+
+    def test_all_registered_files_and_ui_css_match_contract(self):
+        types = self.source['assetTypes']
+        self.assertEqual(30, len(types))
+        assets = self.manifest['publicAssets']
+        self.assertEqual(set(types) | {'ui.css'}, set(assets))
+        for name, entry in assets.items():
+            self.assertEqual({'path', 'contentType', 'sha256'}, set(entry))
+            self.assertEqual('text/css' if name == 'ui.css' else types[name], entry['contentType'])
+            if name != 'ui.css':
+                source = SERVER / 'context-assets' / name
+                self.assertTrue(source.is_file() and not source.is_symlink())
+                self.assertEqual(source.read_bytes(), base64.b64decode(self.bundle[entry['path']]))
+
+    def test_paths_mime_and_digests_are_safe(self):
+        for name, entry in self.manifest['publicAssets'].items():
+            self.assertRegex(name, r'^[A-Za-z0-9][A-Za-z0-9._-]*$')
+            self.assertEqual(PREFIX + name, entry['path'])
+            self.assertNotIn('..', entry['path'].split('/'))
+            self.assertIn(entry['contentType'], {'text/javascript', 'text/css', 'font/woff2', 'text/plain'})
+            self.assertRegex(entry['sha256'], r'^[0-9a-f]{64}$')
+            self.assertEqual(entry['sha256'], self.manifest['files'][entry['path']])
+            self.assertEqual(entry['sha256'], hashlib.sha256(base64.b64decode(self.bundle[entry['path']])).hexdigest())
+
+    def test_rejects_unsafe_advertised_names(self):
+        builder = load_builder()
+        files = {PREFIX + 'x': b'x'}
+        for bad in ['../x', 'a/b', '.hidden', '']:
+            with self.assertRaises(ValueError):
+                builder.public_assets({**files, PREFIX + bad: b'x'}, {bad: 'text/plain'})
+        with self.assertRaises(ValueError):
+            builder.public_assets({PREFIX + 'ui.css': b'x'}, {'x': 'application/x-evil'})
+
+
+if __name__ == '__main__':
+    unittest.main()
