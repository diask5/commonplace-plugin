+    p.add_argument('--release-root', default=RELEASE_ROOT)
+    p.add_argument('--backup-dir', default=BACKUP_DIR)
+    p.add_argument('--nginx-bin', default='nginx')
+    a = p.parse_args(argv)
+    result = execute(a)
+    print(json.dumps(result, indent=2, sort_keys=True))
+    return 0 if result['status'] in ('dry-run', 'unchanged', 'applied') else 1
+
