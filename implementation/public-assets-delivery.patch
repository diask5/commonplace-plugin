+++ b/scripts/deploy-public-assets.py
@@ -0,0 +1,387 @@
+#!/usr/bin/env python3
+"""Install a public-only Nginx include for Commonplace context assets.
+
+Dry-run by default: reads the manifest, release assets and Nginx site file, and
+prints a JSON plan without writing files or running commands.  With --apply (and
+a matching --expected-config-sha256) it writes the generated include, inserts one
+include line directly after the main TLS server's commonplace-files marker, runs
+`nginx -t`, reloads, and rolls both files back if validation or reload fails.
+"""
+import argparse, fcntl, hashlib, json, os, re, stat, subprocess, sys, tempfile, time
+from pathlib import Path
+
+MARKER_LINE = 'include /etc/nginx/commonplace-files.conf;'
+INCLUDE_PATH = '/etc/nginx/commonplace-public-assets.conf'
+INCLUDE_LINE = f'include {INCLUDE_PATH};'
+SITE_LINK = '/etc/nginx/sites-enabled/commonplace'
+RELEASE_ROOT = '/opt/commonplace/current'
+ASSET_SUBDIR = 'dist/standalone/account-runtime/context-assets'
+ALIAS_ROOT = f'{RELEASE_ROOT}/{ASSET_SUBDIR}'
+BACKUP_DIR = '/var/backups/commonplace-public-assets'
+FALLBACK = '@commonplace_public_assets_app'
+HEADER = '# Managed by deploy-public-assets.py; public-only static assets. Do not edit.'
+# Mirrors assetTypes in apps/commonplace-account/server/context-http.mjs plus generated ui.css.
+CANONICAL = {name: 'text/javascript' for name in (
+    'personal-assistant-setup.mjs', 'mcp-resource-source-setup.mjs', 'context-setup-request.mjs',
+    'context-space-invitations.mjs', 'context-native-setup.mjs', 'context-space-rules.mjs',
+    'context-space-files.mjs', 'context-spaces.mjs', 'context-conversations.mjs', 'context-product.mjs',
+    'agent-connections.mjs', 'context-search.mjs', 'context-coverage.mjs', 'groups.mjs', 'shared-chats.mjs',
+    'invitations.mjs', 'agent-setup.mjs', 'social.mjs', 'activity.mjs', 'ui.mjs', 'work-agent.mjs',
+    'context.mjs', 'import-worker.mjs', 'export-file.mjs', 'chatgpt-format.mjs', 'fflate.mjs')}
+CANONICAL.update({'manrope-latin.woff2': 'font/woff2', 'manrope-LICENSE.txt': 'text/plain',
+                  'context.css': 'text/css', 'fflate-LICENSE.txt': 'text/plain', 'ui.css': 'text/css'})
+SAFE_NAME = re.compile(r'^[A-Za-z0-9][A-Za-z0-9._-]*$')
+SHA = re.compile(r'^[0-9a-f]{64}$')
+
+
+class Refusal(Exception):
+    def __init__(self, code, detail=''):
+        super().__init__(code)
+        self.code, self.detail = code, detail
+
+
+def sha256(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def load_manifest(path, expected_sha):
+    raw = Path(path).read_bytes()
+    if expected_sha and sha256(raw) != expected_sha:
+        raise Refusal('manifest-hash-mismatch')
+    try:
+        assets = json.loads(raw)['publicAssets']
+    except (ValueError, KeyError, TypeError):
+        raise Refusal('manifest-invalid', 'publicAssets missing or unreadable')
+    if not isinstance(assets, dict) or not assets:
+        raise Refusal('manifest-invalid', 'publicAssets must be a non-empty object')
+    out = {}
+    for name, entry in assets.items():
+        if not isinstance(name, str) or not SAFE_NAME.match(name) or name not in CANONICAL:
+            raise Refusal('asset-not-allowlisted', 'a manifest name is outside the canonical public list')
+        if not isinstance(entry, dict) or set(entry) != {'path', 'contentType', 'sha256'}:
+            raise Refusal('manifest-invalid', f'{name}: entry shape')
+        if entry['path'] != f'{ASSET_SUBDIR}/{name}':
+            raise Refusal('asset-path-invalid', name)
+        if entry['contentType'] != CANONICAL[name]:
+            raise Refusal('asset-content-type-invalid', name)
+        if not isinstance(entry['sha256'], str) or not SHA.match(entry['sha256']):
+            raise Refusal('asset-digest-invalid', name)
+        out[name] = entry
+    return out
+
+
+def verify_assets(assets, release_root):
+    """Each asset is a regular file, with no symlink below the release root, inside the asset root, matching its digest."""
+    root = Path(release_root)
+    real_asset_root = os.path.realpath(root / ASSET_SUBDIR)
+    current = root
+    for part in ASSET_SUBDIR.split('/'):
+        current = current / part
+        if current.is_symlink():
+            raise Refusal('asset-root-symlink')
+    for name, entry in sorted(assets.items()):
+        path = root / entry['path']
+        try:
+            info = os.lstat(path)
+        except OSError:
+            raise Refusal('asset-missing', name)
+        if not stat.S_ISREG(info.st_mode):
+            raise Refusal('asset-not-regular-file', name)
+        if os.path.dirname(os.path.realpath(path)) != real_asset_root:
+            raise Refusal('asset-outside-root', name)
+        if sha256(path.read_bytes()) != entry['sha256']:
+            raise Refusal('asset-digest-mismatch', name)
+
+
+def render_include(assets, proxy_body):
+    """proxy_body is the exact text between the braces of the live main-TLS `location /` block."""
+    blocks = [HEADER, '# Exact-match locations only; every other /context path stays on the proxied app.',
+              '# A file missing on disk (e.g. after a rollback) falls back to a copy of the live `location /` block.']
+    for name in sorted(assets):
+        blocks += [
+            f'location = /context/assets/{name} {{',
+            f'    alias {ALIAS_ROOT}/{name};',
+            f'    error_page 404 = {FALLBACK};',
+            '    limit_except GET {',
+            '        deny all;',
+            '    }',
+            '    types { }',
+            f'    default_type {assets[name]["contentType"]};',
+            '    add_header Cache-Control "no-store" always;',
+            '    add_header X-Content-Type-Options "nosniff" always;',
+            '    add_header Referrer-Policy "no-referrer" always;',
+            '    add_header X-Frame-Options "DENY" always;',
+            '}']
+    blocks.append(f'location {FALLBACK} {{{proxy_body}}}')
+    return ('\n'.join(blocks) + '\n').encode()
+
+
+def blank_comments_and_strings(text):
+    """Same-length copy with comments and quoted strings blanked so offsets still match."""
+    out, i, n = [], 0, len(text)
+    while i < n:
+        c = text[i]
+        if c == '#':
+            while i < n and text[i] != '\n':
+                out.append(' '); i += 1
+        elif c in '"\'':
+            q = c; out.append(' '); i += 1
+            while i < n and text[i] != q:
+                out.append('\n' if text[i] == '\n' else ' '); i += 1
+            if i < n:
+                out.append(' '); i += 1
+        else:
+            out.append(c); i += 1
+    return ''.join(out)
+
+
+def extract_proxy_body(text, code, start, end):
+    """Exact body of the single simple `location /` directly inside the server block code[start:end]."""
+    block = code[start:end]
+    found = list(re.finditer(r'(?<![\w@.$/-])location\s+/\s*\{', block))
+    if not found:
+        raise Refusal('proxy-location-missing')
+    if len(found) != 1 or block[:found[0].start()].count('{') - block[:found[0].start()].count('}') != 1:
+        raise Refusal('proxy-location-ambiguous')
+    body_start = start + found[0].end()
+    close = code.find('}', body_start)
+    if close < 0 or '{' in code[body_start:close]:
+        raise Refusal('proxy-location-not-simple')
+    body_code = code[body_start:close]
+    targets = re.findall(r'(?<![\w$-])proxy_pass\s+([^\s;]+)\s*;', body_code)
+    if len(targets) != 1 or len(re.findall(r'\bproxy_pass\b', body_code)) != 1:
+        raise Refusal('proxy-pass-not-single')
+    if not re.match(r'^\w+://(?:[^/\s]+|unix:[^:\s]+)$', targets[0]):
+        raise Refusal('proxy-pass-uri-unsupported')
+    return text[body_start:close]
+
+
+def plan_config(config_bytes):
+    """Return (new_bytes, state, proxy_body); state is 'insert' or 'present'; raise Refusal if ambiguous."""
+    try:
+        text = config_bytes.decode('utf-8')
+    except UnicodeDecodeError:
+        raise Refusal('config-not-utf8')
+    code = blank_comments_and_strings(text)
+    if FALLBACK.lstrip('@') in text:
+        raise Refusal('named-location-exists')
+    marker_re = re.compile(r'(?<![\w./-])include\s+/etc/nginx/commonplace-files\.conf\s*;')
+    markers = list(marker_re.finditer(code))
+    if len(markers) != 1 or text.count('commonplace-files.conf') != 1 or text.count(MARKER_LINE) != 1:
+        raise Refusal('marker-not-unique')
+    marker = markers[0]
+    include_re = re.compile(r'(?<![\w./-])include\s+/etc/nginx/commonplace-public-assets\.conf\s*;')
+    includes = list(include_re.finditer(code))
+    if text.count('commonplace-public-assets') != len(includes) or len(includes) > 1:
+        raise Refusal('include-reference-ambiguous')
+    # innermost enclosing block of the marker must be a server block
+    stack = []
+    for m in re.finditer(r'[{}]', code[:marker.start()]):
+        if m.group() == '{':
+            stack.append(m.start())
+        elif stack:
+            stack.pop()
+    if not stack or not re.search(r'(?:^|[;{}\s])server\s*$', code[:stack[-1]]):
+        raise Refusal('marker-not-in-server-block')
+    depth, end = 1, stack[-1] + 1
+    while end < len(code) and depth:
+        depth += {'{': 1, '}': -1}.get(code[end], 0); end += 1
+    block = code[stack[-1]:end]
+    if not re.search(r'\blisten\s+[^;]*\b443\b[^;]*\bssl\b', block) or not re.search(r'\bssl_certificate\b', block):
+        raise Refusal('marker-not-in-main-tls-server')
+    if includes and (includes[0].start() < marker.end() or text[marker.end():includes[0].start()].strip(' \t\r\n')):
+        raise Refusal('include-misplaced')
+    after = includes[0].end() if includes else marker.end()
+    if not re.match(r'\s*location\s+\^~\s+/downloads/\s*\{', code[after:]) or \
+            not re.search(r'\blocation\s+/\s*\{[^{}]*proxy_pass', code[after:end]):
+        raise Refusal('marker-neighbourhood-unexpected')
+    proxy_body = extract_proxy_body(text, code, stack[-1], end)
+    if includes:
+        return config_bytes, 'present', proxy_body
+    line_start = text.rfind('\n', 0, marker.start()) + 1
+    indent = text[line_start:marker.start()]
+    if indent.strip():
+        raise Refusal('marker-shares-line')
+    nl = text.find('\n', marker.end())
+    if nl < 0 or text[marker.end():nl].strip():
+        raise Refusal('marker-line-unexpected')
+    eol = '\r\n' if text[nl - 1] == '\r' else '\n'
+    insert_at = nl + 1
+    new = text[:insert_at] + indent + INCLUDE_LINE + eol + text[insert_at:]
+    return new.encode(), 'insert', proxy_body
+
+
+def plan_include(path, wanted):
+    try:
+        current = Path(path).read_bytes()
+    except FileNotFoundError:
+        return 'create', None
+    except OSError:
+        raise Refusal('include-unreadable')
+    if current == wanted:
+        return 'unchanged', current
+    if not current.startswith(HEADER.encode() + b'\n'):
+        raise Refusal('include-exists-unmanaged')
+    return 'update', current
+
+
+def atomic_write(path, data, mode, owner=None):
+    directory = os.path.dirname(path)
+    fd, tmp = tempfile.mkstemp(prefix='.public-assets-', dir=directory)
+    try:
+        with os.fdopen(fd, 'wb') as handle:
+            handle.write(data); handle.flush(); os.fsync(handle.fileno())
+            os.fchmod(handle.fileno(), mode)
+            if owner:
+                try:
+                    os.fchown(handle.fileno(), *owner)
+                except PermissionError:
+                    pass
+        os.replace(tmp, path)
+    except BaseException:
+        try: os.unlink(tmp)
+        except OSError: pass
+        raise
+
+
+def run(argv):
+    try:
+        done = subprocess.run(argv, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=60)
+        return done.returncode
+    except (OSError, subprocess.TimeoutExpired):
+        return -1
+
+
+def restore(site, config_original, config_mode, owner, include, include_original, include_mode):
+    state = {}
+    try:
+        atomic_write(site, config_original, config_mode, owner)
+        state['config'] = 'restored' if Path(site).read_bytes() == config_original else 'restore-mismatch'
+    except OSError:
+        state['config'] = 'restore-failed'
+    try:
+        if include_original is None:
+            if os.path.lexists(include):
+                os.unlink(include)
+            state['include'] = 'removed'
+        else:
+            atomic_write(include, include_original, include_mode)
+            state['include'] = 'restored' if Path(include).read_bytes() == include_original else 'restore-mismatch'
+    except OSError:
+        state['include'] = 'restore-failed'
+    return state
+
+
+def execute(a):
+    result = {'mode': 'apply' if a.apply else 'dry-run'}
+    lock = None
+    try:
+        assets = load_manifest(a.manifest, a.expected_manifest_sha256)
+        verify_assets(assets, a.release_root)
+        result['assets'] = sorted(assets)
+        site = os.path.realpath(a.site)
+        config = Path(site).read_bytes()
+        config_hash = sha256(config)
+        result['configSha256'] = config_hash
+        if a.apply and not a.expected_config_sha256:
+            raise Refusal('expected-config-sha256-required')
+        if a.expected_config_sha256 and config_hash != a.expected_config_sha256:
+            raise Refusal('config-stale')
+        new_config, config_state, proxy_body = plan_config(config)
+        include_bytes = render_include(assets, proxy_body)
+        include_state, include_original = plan_include(a.include_path, include_bytes)
+        result.update(configAction=config_state, includeAction=include_state, includeSha256=sha256(include_bytes),
+                      newConfigSha256=sha256(new_config))
+        if config_state == 'present' and include_state == 'unchanged':
+            result['status'] = 'unchanged'
+            return result
+        if not a.apply:
+            result['status'] = 'dry-run'
+            return result
+        os.makedirs(a.backup_dir, mode=0o700, exist_ok=True)
+        os.chmod(a.backup_dir, 0o700)
+        lock = open(os.path.join(a.backup_dir, '.lock'), 'a')
+        try:
+            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except OSError:
+            raise Refusal('another-install-running')
+        if Path(site).read_bytes() != config:
+            raise Refusal('config-stale')
+        try:
+            include_now = Path(a.include_path).read_bytes()
+        except FileNotFoundError:
+            include_now = None
+        if include_now != include_original:
+            raise Refusal('include-stale')
+        info = os.stat(site)
+        config_mode, owner = stat.S_IMODE(info.st_mode), (info.st_uid, info.st_gid)
+        include_mode = stat.S_IMODE(os.stat(a.include_path).st_mode) if include_original is not None else 0o644
+        backup = os.path.join(a.backup_dir, time.strftime('%Y%m%dT%H%M%S') + '-' + config_hash[:12])
+        os.makedirs(backup, mode=0o700)
+        atomic_write(os.path.join(backup, 'site.conf'), config, 0o600)
+        if include_original is not None:
+            atomic_write(os.path.join(backup, 'public-assets.conf'), include_original, 0o600)
+        atomic_write(os.path.join(backup, 'receipt.json'), json.dumps({
+            'site': site, 'siteSha256': config_hash, 'siteMode': oct(config_mode), 'include': a.include_path,
+            'includeSha256': sha256(include_original) if include_original is not None else None}).encode(), 0o600)
+        result['backup'] = backup
+        written = {'include': False, 'config': False}
+        failure = None
+        try:
+            if include_state != 'unchanged':
+                atomic_write(a.include_path, include_bytes, include_mode); written['include'] = True
+            if config_state == 'insert':
+                atomic_write(site, new_config, config_mode, owner); written['config'] = True
+            if run([a.nginx_bin, '-t']) != 0:
+                failure = 'nginx-test-failed'
+            else:
+                result['nginxTest'] = 'passed'
+                if run([a.nginx_bin, '-s', 'reload']) != 0:
+                    failure = 'nginx-reload-failed'
+                else:
+                    result['reload'] = 'sent'
+        except OSError:
+            failure = 'write-failed'
+        if failure:
+            result.update(status='rolled-back', failure=failure,
+                          rollback=restore(site, config, config_mode, owner, a.include_path, include_original, include_mode),
+                          written=written)
+            if failure == 'nginx-reload-failed':
+                result['rollbackReload'] = 'sent' if run([a.nginx_bin, '-s', 'reload']) == 0 else 'failed'
+            if any(v in ('restore-failed', 'restore-mismatch') for v in result['rollback'].values()):
+                result['status'] = 'rollback-incomplete'
+            return result
+        result['status'] = 'applied'
+        return result
+    except Refusal as refusal:
+        result.update(status='refused', reason=refusal.code)
+        if refusal.detail:
+            result['detail'] = refusal.detail
+        return result
+    except OSError as error:
+        result.update(status='refused', reason='io-error', detail=type(error).__name__)
+        return result
+    finally:
+        if lock is not None:
+            lock.close()
