+def main(argv=None):
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--manifest', type=Path, required=True, help='build-runtime-update-manifest.json with publicAssets.')
+    p.add_argument('--expected-manifest-sha256', help='Optional digest gate for the manifest file.')
+    p.add_argument('--expected-config-sha256', help='Digest of the current resolved site file; required with --apply.')
+    p.add_argument('--apply', action='store_true', help='Write, test and reload. Default is dry-run.')
