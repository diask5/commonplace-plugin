+ // An old search/page revision is already unusable after collection changes.
+ // Reject it before joining a potentially slow rebuild; otherwise a small
+ // stale read can exhaust the native transport timeout just to say restart.
+ if(input.revision!==undefined){
+  const revision=service.db.sqlite.prepare('SELECT revision FROM cp_cloud_archive_state WHERE owner=?').get(owner)?.revision??0;
+  if(input.revision!==revision)return {changed:true,revision,restart:true};
+ }
  const snapshot=await archive.prepare(owner,{reuseCurrent:true});
