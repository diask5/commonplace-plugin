+// Archive workers preserve static validation messages but not HTTP status.
+// Expose only these exact, reviewed input/lookup failures as correction replies;
+// integrity, transport and arbitrary exception text retain their error path.
+const archiveInputErrors=new Map([
+ ['Conversation is not in this account archive.','Conversation is not in this account archive. Search or list current documents and use an ID returned there.'],
+ ['Invalid page offset or size.','Invalid page offset or size. Start at offset 0 or use nextOffset from a successful read. Omit limit for the default page (maximum 16000).'],
+ ['Use a search phrase of 1–300 characters.','Use a search phrase of 1–300 characters.'],
+]);
 const taskTools=[
  ['run_cloud_task',{prompt:{type:'string',minLength:1,maxLength:16000},nonce:{type:'string',pattern:'^[a-f0-9]{24}$'},targetAgentId:{type:'string'}},['prompt','nonce'],false,'Create an owner-authorized durable task. Reuse nonce only for identical retries.'],
  ['read_cloud_task',{id:{type:'string'}},['id'],true,'Read this owner’s task and its current status.'],
@@ -44,6 +52,8 @@ export async function remoteMcp(request,service,{device,authorize,tools}){
    const input=generatesNonce?{...args,nonce:args.nonce??randomBytes(12).toString('hex')}:args;
    try{const value=await call(name,input);return {content:[{type:'text',text:JSON.stringify(generatesNonce?{...value,retryNonce:input.nonce}:value)}]};}
    catch(error){
+    const correction=archiveTools.some(tool=>tool.name===name)&&archiveInputErrors.get(error.message);
+    if(correction)return {isError:true,content:[{type:'text',text:correction}]};
     if(!generatesNonce&&! [400,401,403,404,409,413,429].includes(error.status))throw error;
     const checking=error.status===409&&error.message==='This request is still checking. Refresh the board.';
