+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {DatabaseSync} from 'node:sqlite';
+import {mkdtemp,mkdir,symlink,chmod,readdir,stat,rm} from 'node:fs/promises';
+import {tmpdir} from 'node:os';
+import path from 'node:path';
+import {fileURLToPath} from 'node:url';
+import {execFile} from 'node:child_process';
+import {promisify} from 'node:util';
+
+const exec=promisify(execFile);
+const entrypoint=fileURLToPath(new URL('../apps/commonplace-account/server/backup.mjs',import.meta.url));
+// Run the real entrypoint in an isolated process. Every fetch is intercepted;
+// the snapshot, integrity verification and upload body use real synthetic SQLite.
+const runner=String.raw`
+import assert from 'node:assert/strict';
+import {DatabaseSync} from 'node:sqlite';
+import {readdir,stat} from 'node:fs/promises';
+import {pathToFileURL} from 'node:url';
+import path from 'node:path';
+const [entrypoint,physical,configured,status]=process.argv.slice(1);
+const logs=[],calls=[],snapshots=[];
+const print=console.log.bind(console);
+console.log=(...args)=>logs.push(args.join(' '));
+globalThis.fetch=async(url,options={})=>{
+ calls.push(url);
+ if(url==='http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token'){
+  assert.equal(options.headers['Metadata-Flavor'],'Google');
+  assert.equal(logs.at(-1),'Consistent database snapshot verified; uploading.');
+  return new Response(JSON.stringify({access_token:'synthetic-token'}));
+ }
+ const upload=new URL(url);
+ assert.equal(upload.origin,'https://storage.googleapis.com');
+ assert.equal(upload.pathname,'/upload/storage/v1/b/synthetic-backup-bucket/o');
+ assert.equal(upload.searchParams.get('uploadType'),'media');
+ assert.equal(upload.searchParams.get('ifGenerationMatch'),'0');
+ assert.equal(options.method,'POST');
+ assert.equal(options.headers.Authorization,'Bearer synthetic-token');
+ const name=upload.searchParams.get('name');
+ assert.match(name,/^commonplace-.*\.sqlite$/);
+ const body=Buffer.from(await options.body.arrayBuffer());
+ assert.equal(body.subarray(0,16).toString(),'SQLite format 3\0');
+ for(const directory of new Set([path.join(path.dirname(physical),'backups'),path.join(path.dirname(configured),'backups')])){
+  const names=await readdir(directory).catch(error=>{if(error.code==='ENOENT')return [];throw error;});
+  if(!names.includes(name))continue;
+  const filename=path.join(directory,name),db=new DatabaseSync(filename,{readOnly:true});
+  try{
+   snapshots.push({directory,name,bytes:body.length,fileMode:(await stat(filename)).mode&0o777,
+    directoryMode:(await stat(directory)).mode&0o777,integrity:db.prepare('PRAGMA integrity_check').get().integrity_check,
+    values:db.prepare('SELECT value FROM synthetic_records ORDER BY value').all().map(row=>row.value)});
+  }finally{db.close();}
+ }
+ assert.equal(snapshots.length,1);
+ return new Response('',{status:Number(status)});
+};
+let error=null;
+try{await import(pathToFileURL(entrypoint).href);}catch(failure){error=failure.message;}
+print(JSON.stringify({error,logs,calls,snapshots}));
+`;
+
+async function fixture(t,linked){
+ const root=await mkdtemp(path.join(tmpdir(),'backup-location-'));
+ const physicalDirectory=path.join(root,'balanced'),logicalDirectory=path.join(root,'logical');
+ await mkdir(physicalDirectory);await mkdir(logicalDirectory);
+ const physical=path.join(physicalDirectory,'account.sqlite');
+ const configured=linked?path.join(logicalDirectory,'account.sqlite'):physical;
+ const writer=new DatabaseSync(physical);
+ writer.exec("PRAGMA journal_mode=WAL; CREATE TABLE synthetic_records(value TEXT); INSERT INTO synthetic_records VALUES('committed-in-wal');");
+ await chmod(physical,0o600);
+ t.after(async()=>{writer.close();await rm(root,{recursive:true,force:true});});
+ if(linked)await symlink(path.relative(logicalDirectory,physical),configured);
+ return {root,physical,configured,physicalDirectory,logicalDirectory,writer};
+}
+
+for(const linked of [true,false])for(const uploadStatus of [200,503]){
+ test(`${linked?'symlink':'regular'} database uses its physical backup directory and ${uploadStatus===200?'removes the uploaded snapshot':'retains the verified snapshot after upload failure'}`,{timeout:15000},async t=>{
+  const f=await fixture(t,linked);
+  const {stdout}=await exec(process.execPath,['--input-type=module','-e',runner,entrypoint,f.physical,f.configured,String(uploadStatus)],{
+   env:{...process.env,COMMONPLACE_DB:f.configured,COMMONPLACE_BACKUP_BUCKET:'synthetic-backup-bucket'},timeout:12000,
+  });
+  const result=JSON.parse(stdout.trim());
+  assert.equal(result.calls.length,2,'only mocked metadata and upload requests occur');
+  assert.equal(result.snapshots.length,1);
+  const snapshot=result.snapshots[0],expectedDirectory=path.join(f.physicalDirectory,'backups');
+  assert.equal(snapshot.directory,expectedDirectory,'snapshot and integrity verification stay beside the actual database');
+  assert.equal(snapshot.directoryMode,0o700);assert.equal(snapshot.fileMode,0o600);
+  assert.equal(snapshot.integrity,'ok');assert.deepEqual(snapshot.values,['committed-in-wal']);assert.ok(snapshot.bytes>0);
+  assert.deepEqual(f.writer.prepare('SELECT value FROM synthetic_records').all().map(row=>row.value),['committed-in-wal']);
+  if(linked)await assert.rejects(stat(path.join(f.logicalDirectory,'backups')),{code:'ENOENT'});
+  const names=await readdir(expectedDirectory);
+  assert.ok(!names.some(name=>name.endsWith('.partial')));
+  const databaseNames=names.filter(name=>name.endsWith('.sqlite'));
+  if(uploadStatus===200){
+   assert.equal(result.error,null);assert.deepEqual(databaseNames,[]);
+   await assert.rejects(stat(path.join(expectedDirectory,snapshot.name)),{code:'ENOENT'});
+   assert.equal(result.logs.at(-1),'Database backup verified and saved.');
+  }else{
+   assert.match(result.error,/Backup upload failed \(503\); verified local backup retained/);
+   assert.deepEqual(databaseNames,[snapshot.name]);
+   assert.equal(result.logs.at(-1),'Consistent database snapshot verified; uploading.');
+   const retained=new DatabaseSync(path.join(expectedDirectory,snapshot.name),{readOnly:true});
+   try{
+    assert.equal(retained.prepare('PRAGMA integrity_check').get().integrity_check,'ok');
+    assert.equal(retained.prepare('SELECT value FROM synthetic_records').get().value,'committed-in-wal');
+   }finally{retained.close();}
+  }
+ });
+}
