+// One bounded burst, with synthetic accounts and candidate injection.
+// Real SpaceContext authority/persistence and real Perplexity classification.
+import {writeFile,mkdir} from 'node:fs/promises';
+import path from 'node:path';
+import {randomBytes} from 'node:crypto';
+import {configuredDecider} from './policy-sharing-config.mjs';
+import {startContextPreview} from './preview-context-product.mjs';
+import {SpaceContext} from '../apps/commonplace-account/server/space-context.mjs';
+import {POLICY_THRESHOLD} from '../apps/commonplace-account/server/policy-context.mjs';
+const output=process.argv[2]||'.context/sharing-stress/real-load.json',uid=()=>randomBytes(12).toString('hex');
+const p=await startContextPreview(),provider=await configuredDecider();
+try{
+ if(!provider.configured||provider.local)throw new Error('Hosted Decisions configuration required.');
