+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {randomBytes} from 'node:crypto';
+import {setTimeout as delay} from 'node:timers/promises';
+import {startContextPreview} from '../scripts/preview-context-product.mjs';
+import {SpaceContext} from '../apps/commonplace-account/server/space-context.mjs';
+import {SpaceInvitations} from '../apps/commonplace-account/server/space-invitations.mjs';
+
+// Authority/load tests, deliberately NOT evidence of classifier semantics.
+const uid=()=>randomBytes(12).toString('hex');
+const rules=[{id:'scope',text:'Share public launch facts with every current and future space member.'},{id:'private',text:'Never share private budgets, credentials or audit markers.'}];
+const noPrivate=value=>assert.doesNotMatch(JSON.stringify(value),/PRIVATE_CANARY|privateChecks|probability|ruleId|sourceOffset|private-source|private-title/);
+async function fixture(t,count=10){
+ const p=await startContextPreview();t.after(()=>p.close());const people=[];
+ for(let i=0;i<count;i++)people.push((await p.service.profile({userId:'synthetic:sharing-stress:'+i,email:'stress'+i+'@example.test',displayName:i===0?'Zane':i===1?'Sam':'Member '+i})).id);
+ // Disposable accepted contacts, seeded only inside this isolated database.
+ for(const person of people.slice(1))p.work.run('INSERT INTO cp_connections(id,first_owner,second_owner) VALUES(?,?,?)',uid(),people[0],person);
+ const group=p.spaces.groups.create(people[0],{name:'Lumen launch',personIds:people.slice(1),nonce:uid()});
+ const stats={calls:0,active:0,peak:0,perOwner:new Map(),peakPerOwner:new Map()}, state={count:32,hold:null,entered:null,error:null};
+ p.service.spaceContextOptions={candidates:async owner=>Array.from({length:state.count},(_,i)=>({id:'private-source-'+owner+'-'+i,ownerId:owner,excluded:false,title:'Shared excerpt',text:i%2?'PRIVATE_CANARY_'+owner+'_'+i:'Public launch '+owner+' '+i,context:'private-title-'+owner,revision:0})),decider:{configured:true,model:'deterministic-test-only',decide:async({candidate,rule,rules:fullRules,signal})=>{
+  assert.ok(fullRules.includes(rule));assert.ok(signal);
+  stats.calls++;stats.active++;stats.peak=Math.max(stats.peak,stats.active);
+  const owner=candidate.ownerId,n=(stats.perOwner.get(owner)||0)+1;stats.perOwner.set(owner,n);stats.peakPerOwner.set(owner,Math.max(n,stats.peakPerOwner.get(owner)||0));state.entered?.();
+  try{if(state.hold)await state.hold;await delay(2);if(state.error)throw state.error;return {probability:rule.includes('Never')&&candidate.text.includes('PRIVATE_CANARY')?0:1};}
+  finally{stats.active--;stats.perOwner.set(owner,stats.perOwner.get(owner)-1);}
+ }}};
+ const s=new SpaceContext(p.service);for(const owner of people)s.save(owner,{groupId:group.id,expectedRevision:0,enabled:true,rules});
+ const input=(contributorId=people[0],extra={})=>({groupId:group.id,contributorId,query:'launch',nonce:uid(),...extra});
+ return {p,s,people,groupId:group.id,stats,state,input,request:(extra={},who=people[1])=>s.request(who,input(people[0],extra))};
+}
+
+test('ten people can share concurrently with owner isolation and bounded per-request classification',async t=>{
+ const f=await fixture(t),started=performance.now();
+ const results=await Promise.all(f.people.map(async(owner,i)=>{
+  const requester=f.people[(i+1)%10],base=f.input(owner);let page=await f.s.request(requester,base),excerpts=[...page.excerpts],pages=1;
+  assert.equal(page.state,'shared');
+  while(page.nextCursor){page=await f.s.request(requester,{...base,nonce:uid(),cursor:page.nextCursor});excerpts.push(...page.excerpts);pages++;assert.ok(pages<=3);}
+  assert.equal(excerpts.length,16);assert.equal(new Set(excerpts.map(e=>e.text)).size,16);assert.ok(excerpts.every(e=>e.text.startsWith('Public launch '+owner+' ')));noPrivate(excerpts);
+  return {pages,excerpts:excerpts.length};
+ }));
+ assert.equal(f.stats.calls,640);assert.equal(f.stats.active,0);assert.ok([...f.stats.peakPerOwner.values()].every(n=>n<=8));assert.ok(f.stats.peak>8,'ceiling is per request, not global');
+ for(const person of f.people){const events=f.s.board(person,{groupId:f.groupId}).events;for(const event of events){if(event.contributor===person){if(event.privateChecks)assert.equal(event.privateChecks.audit.length,32);}else noPrivate(event);}}
+ t.diagnostic(JSON.stringify({owners:10,requests:30,approvedExcerpts:160,providerCalls:f.stats.calls,peakProviderCalls:f.stats.peak,perOwnerPeak:[...f.stats.peakPerOwner.values()],elapsedMs:Math.round(performance.now()-started),results}));
+});
+
+test('forty simultaneous requests serialize one contributor across spaces without lost locks or replay leaks',async t=>{
+ const f=await fixture(t,3);f.state.count=2;let release,start;
+ f.state.hold=new Promise(r=>release=r);const entered=new Promise(r=>start=r);f.state.entered=start;
+ const second=f.p.spaces.groups.create(f.people[0],{name:'Second space',personIds:f.people.slice(1),nonce:uid()});f.s.save(f.people[0],{groupId:second.id,expectedRevision:0,enabled:true,rules});
+ const base=f.input(),first=f.s.request(f.people[1],base);await entered;
+ const attempts=await Promise.all(Array.from({length:39},(_,i)=>f.request(i%2?{groupId:second.id}:{},f.people[1+i%2]).then(value=>({value}),error=>({status:error.status}))));
+ assert.ok(attempts.every(a=>a.status===429));assert.equal(f.stats.calls,4);
+ await assert.rejects(f.s.request(f.people[1],base),e=>e.status===409);
+ release();const original=await first;f.state.hold=null;f.state.entered=null;assert.equal(original.state,'shared');
+ const before=f.stats.calls;assert.equal((await f.s.request(f.people[1],base)).replayed,true);assert.equal(f.stats.calls,before);
+ for(const altered of [{...base,query:'private'},{...base,groupId:second.id},{...base,contributorId:f.people[2]}])await assert.rejects(f.s.request(f.people[1],altered),e=>e.status===409);
+ await assert.rejects(f.s.request(f.people[2],base),e=>e.status===409);
+ assert.equal((await f.request()).state,'shared');assert.equal(f.s.get("SELECT count(*) AS n FROM cp_space_exchanges WHERE state='checking'").n,0);
+});
+
+test('each owner and space has separate opt-in, audit and rules; provider errors do not leak or strand work',async t=>{
+ const f=await fixture(t,3);f.state.count=2;const [zane,sam,third]=f.people;
+ const second=f.p.spaces.groups.create(zane,{name:'No sharing yet',personIds:[sam,third],nonce:uid()});
+ const before=f.stats.calls;assert.equal((await f.request({groupId:second.id})).state,'unavailable');assert.equal(f.stats.calls,before);
+ f.s.save(sam,{groupId:second.id,expectedRevision:0,enabled:true,rules});assert.equal(f.s.policy(zane,{groupId:second.id}).enabled,false);
+ assert.equal((await f.s.request(zane,f.input(sam,{groupId:second.id}))).state,'shared');
+ for(const code of ['provider_http_429','provider_http_500','invalid_provider_response','provider_timeout']){
+  f.state.error=Object.assign(new Error('PRIVATE_CANARY provider body'),{code});const result=await f.request();assert.equal(result.state,'no_context');assert.deepEqual(result.excerpts,[]);noPrivate(result);
+  const event=f.s.board(zane,{groupId:f.groupId}).events.at(-1);assert.ok(event.privateChecks.audit.every(a=>a.checks.every(c=>c.reason===code)));
+ }
+ f.state.error=null;assert.equal((await f.request()).state,'shared');assert.equal(f.s.get("SELECT count(*) AS n FROM cp_space_exchanges WHERE state='checking'").n,0);noPrivate(f.s.board(sam,{groupId:f.groupId}));
+});
+
+for(const mutation of ['pause','rules','expiry','remove-requester','remove-contributor','archive-space','new-member','receiver-generation'])test('in-flight '+mutation+' prevents every pending excerpt and retry',async t=>{
+ const f=await fixture(t,3);f.state.count=12;let release,start;f.state.hold=new Promise(r=>release=r);const entered=new Promise(r=>start=r);f.state.entered=start;
+ t.after(()=>release());const base=f.input(mutation==='remove-contributor'?f.people[2]:f.people[0]),pending=f.s.request(f.people[1],base);await entered;const [zane,sam,third]=f.people;
+ if(mutation==='pause'||mutation==='rules')f.s.save(zane,{groupId:f.groupId,expectedRevision:1,enabled:mutation==='rules',rules:mutation==='rules'?[{id:'none',text:'Share nothing.'}]:rules});
+ if(mutation==='expiry')f.s.run('UPDATE cp_space_policy_limits SET expires_at=1 WHERE owner=? AND workspace=?',zane,f.groupId);
+ if(mutation==='remove-requester')f.p.spaces.groups.remove(zane,{groupId:f.groupId,personId:sam});
+ if(mutation==='remove-contributor')f.p.spaces.groups.remove(zane,{groupId:f.groupId,personId:third});
+ if(mutation==='archive-space')f.p.spaces.groups.archive(zane,{groupId:f.groupId});
+ if(mutation==='new-member'){const person=await f.p.service.profile({userId:'synthetic:new-member',email:'new@example.test',displayName:'New member'}),invites=new SpaceInvitations(f.p.service),code=randomBytes(32).toString('base64url');invites.create(zane,{groupId:f.groupId,code});invites.accept(person.id,{code});}
+ if(mutation==='receiver-generation')f.s.run('UPDATE cp_group_receivers SET generation=generation+1 WHERE workspace=? AND owner=?',f.groupId,third);
+ release();const result=await pending;assert.equal(result.state,'unavailable');assert.deepEqual(result.excerpts,[]);
+ const retry=await f.s.request(sam,base).catch(e=>({status:e.status}));assert.ok(retry.status===404||retry.state==='unavailable');assert.equal(f.s.get("SELECT count(*) AS n FROM cp_space_exchanges WHERE state='checking'").n,0);
+});
+
+test('invitation acceptance does not opt in; removal stops activity and old links; rejoin does not restore old sharing',async t=>{
+ const f=await fixture(t,3),[zane,sam]=f.people,invites=new SpaceInvitations(f.p.service),code=randomBytes(32).toString('base64url');
+ const group=f.p.spaces.groups.create(zane,{name:'Sam and Zane',personIds:[],nonce:uid()});invites.create(zane,{groupId:group.id,code});invites.accept(sam,{code});
+ assert.equal(f.s.policy(sam,{groupId:group.id}).enabled,false);assert.equal(f.s.policy(zane,{groupId:group.id}).enabled,false);
+ f.s.save(sam,{groupId:group.id,expectedRevision:0,enabled:true,rules});await delay(2);f.p.spaces.groups.remove(zane,{groupId:group.id,personId:sam});
+ assert.throws(()=>invites.accept(sam,{code}),e=>e.status===403);assert.throws(()=>f.s.board(sam,{groupId:group.id}),e=>e.status===404);
+ await assert.rejects(f.s.request(sam,f.input(zane,{groupId:group.id})),e=>e.status===404);
+ f.p.spaces.groups.add(zane,{groupId:group.id,personId:sam});assert.equal(f.s.policy(sam,{groupId:group.id}).enabled,false);
+});
+
+for(const clockDelta of [0,-60000])test('remove and re-add cannot resurrect consent when clock delta is '+clockDelta+'ms',async t=>{
+ const f=await fixture(t,3),[zane,sam]=f.people,originalNow=Date.now,now=originalNow();
+ // Hold wall-clock time constant to exercise the equality edge deterministically.
+ Date.now=()=>now;
+ try{
+  f.s.save(sam,{groupId:f.groupId,expectedRevision:1,enabled:true,rules});
+  f.p.spaces.groups.remove(zane,{groupId:f.groupId,personId:sam});
+  Date.now=()=>now+clockDelta;f.p.spaces.groups.add(zane,{groupId:f.groupId,personId:sam});
+  assert.equal(f.s.policy(sam,{groupId:f.groupId}).enabled,false);
+  assert.throws(()=>f.s.save(sam,{groupId:f.groupId,expectedRevision:2,enabled:true,rules}),e=>e.status===409);
+  assert.equal((await f.s.request(zane,f.input(sam))).state,'unavailable');assert.equal(f.stats.calls,0);
+  const policy=f.s.policy(sam,{groupId:f.groupId});assert.deepEqual(policy.rules,rules);
+  f.s.save(sam,{groupId:f.groupId,expectedRevision:policy.revision,enabled:true,rules});
