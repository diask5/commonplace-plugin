+def write_runtime_file(destination, content):
+    """Replace candidate code without changing a previous release's hardlinks.
+
+    A private deployment runner may use umask 077. Runtime source still needs
+    its existing read mode (or 0644 for a new module) for the service account.
+    Database snapshots and private rollout evidence retain their own modes.
+    """
+    missing = []
+    parent = destination.parent
+    while not parent.exists():
+        missing.append(parent)
+        parent = parent.parent
+    for parent in reversed(missing):
+        parent.mkdir(mode=0o755)
+        parent.chmod(0o755)
+    mode = destination.stat().st_mode & 0o777 if destination.exists() else 0o644
+    if destination.exists() or destination.is_symlink():
+        destination.unlink()
+    with destination.open('xb') as target:
+        target.write(content)
+    destination.chmod(mode)
+
