+    def test_runtime_files_remain_readable_under_restrictive_umask(self):
+        original = self.root / 'original.mjs'
+        original.write_bytes(b'old source')
+        original.chmod(0o644)
+        candidate = self.root / 'candidate.mjs'
+        os.link(original, candidate)
+        previous_umask = os.umask(0o077)
+        try:
+            deploy.write_runtime_file(candidate, b'new source')
+            deploy.write_runtime_file(self.root / 'nested/assets/new.mjs', b'new module')
+        finally:
+            os.umask(previous_umask)
+        self.assertEqual(candidate.stat().st_mode & 0o777, 0o644)
+        self.assertEqual((self.root / 'nested/assets/new.mjs').stat().st_mode & 0o777, 0o644)
+        self.assertEqual((self.root / 'nested').stat().st_mode & 0o777, 0o755)
+        self.assertEqual((self.root / 'nested/assets').stat().st_mode & 0o777, 0o755)
+        self.assertEqual(original.read_bytes(), b'old source')
+        self.assertEqual(original.stat().st_mode & 0o777, 0o644)
+        self.assertNotEqual(original.stat().st_ino, candidate.stat().st_ino)
+
+    def test_runtime_write_does_not_follow_an_inherited_file_symlink(self):
+        original = self.root / 'original.mjs'
+        original.write_bytes(b'old source')
+        original.chmod(0o640)
+        candidate = self.root / 'candidate.mjs'
+        candidate.symlink_to(original)
+        deploy.write_runtime_file(candidate, b'new source')
+        self.assertFalse(candidate.is_symlink())
+        self.assertEqual(candidate.read_bytes(), b'new source')
+        self.assertEqual(candidate.stat().st_mode & 0o777, 0o640)
+        self.assertEqual(original.read_bytes(), b'old source')
+        self.assertEqual(original.stat().st_mode & 0o777, 0o640)
