diff --git a/tests/agent-auth-registration-queue.test.mjs b/tests/agent-auth-registration-queue.test.mjs
new file mode 100644
index 0000000..eb7218f
--- /dev/null
+++ b/tests/agent-auth-registration-queue.test.mjs
@@ -0,0 +1,109 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtemp, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import path from 'node:path';
+import { DatabaseSync } from 'node:sqlite';
+import { createHash } from 'node:crypto';
+import {pathToFileURL} from 'node:url';
+const {AgentConnection}=await import(process.env.COMMONPLACE_TEST_PLUGIN?pathToFileURL(path.resolve(process.env.COMMONPLACE_TEST_PLUGIN,'server/agent-auth-client.mjs')):new URL('../apps/commonplace/server/agent-auth-client.mjs',import.meta.url));
+
+const ORIGIN = 'http://127.0.0.1:9';
+const tick = () => new Promise((resolve) => setTimeout(resolve, 20));
+const settled = (promise) => {
+  const state = { done: false };
+  promise.then(() => { state.done = true; }, () => { state.done = true; });
+  return state;
+};
+
+// Real AgentConnection over a real SQLite sessions table; only the SDK client is faked.
+async function connection(t) {
+  const dir = await mkdtemp(path.join(tmpdir(), 'agent-queue-'));
+  const conn = await AgentConnection.open(dir, ORIGIN);
+  const registrations = [];
+  const held = new Map();
+  const calls = [];
+  conn.client = {
+    async connectAgent({ name }) {
+      registrations.push(name);
+      if (held.has(name)) await held.get(name).promise;
+      return { status: 'active', agentId: `agent-${registrations.length}-${name}` };
+    },
+    async executeCapability({ agentId, arguments: args }) {
+      calls.push({ agentId, path: args.path });
+      return { data: { status: 200, body: { agentId, path: args.path } } };
+    },
+  };
+  const hold = (name) => {
+    let release;
+    const promise = new Promise((resolve) => { release = resolve; });
+    held.set(name, { promise });
+    return release;
+  };
+  const dbFile = path.join(dir, 'agent-auth', createHash('sha256').update(ORIGIN).digest('hex') + '.sqlite');
+  t.after(async () => { conn.close?.(); await rm(dir, { recursive: true, force: true }); });
+  return { conn, registrations, calls, hold, dbFile };
+}
+
+const verified = (sessionId) => ({ verified: true, sessionId, provider: 'codex' });
+
+test('existing companion and verified sessions are served while an unrelated registration is held', async (t) => {
+  const { conn, registrations, calls, hold, dbFile } = await connection(t);
+  const companion = await conn.run(null, () => conn.request('/account/api/a'));
+  const existing = await conn.run(verified('aaaa1111-existing'), () => conn.request('/account/api/b'));
+  assert.equal(registrations.length, 2);
+
+  const release = hold('codex chat bbbb2222');
+  const blocked = conn.run(verified('bbbb2222-slow'), () => conn.request('/account/api/new'));
+  const blockedState = settled(blocked);
+  await tick();
+  assert.equal(registrations.length, 3, 'unrelated registration is in flight');
+
+  const raced = await Promise.race([
+    Promise.all([
+      conn.run(null, () => conn.request('/account/api/a2')),
+      conn.run(verified('aaaa1111-existing'), () => conn.request('/account/api/b2')),
+    ]),
+    tick().then(() => tick()).then(() => 'blocked'),
+  ]);
+  assert.notEqual(raced, 'blocked', 'existing sessions must not wait on the registration queue');
+  const [c, e] = raced;
+  assert.equal(c.agentId, companion.agentId);
+  assert.equal(e.agentId, existing.agentId);
+  assert.equal(registrations.length, 3, 'no extra registrations for existing sessions');
+  assert.equal(blockedState.done, false);
+
+  release();
+  const fresh = await blocked;
+  assert.match(fresh.agentId, /bbbb2222/);
+  const inspect = new DatabaseSync(dbFile,{readOnly:true});
+  try {assert.deepEqual(inspect.prepare('SELECT id FROM sessions ORDER BY id').all().map(r=>r.id), ['aaaa1111-existing', 'bbbb2222-slow', 'companion']);}
+  finally {inspect.close();}
+  assert.equal(calls.at(-1).path, '/account/api/new');
+});
+
+test('concurrent requests for the same new session singleflight and keep their own context', async (t) => {
+  const { conn, registrations, calls, hold } = await connection(t);
+  const release = hold('codex chat cccc3333');
+  const other = hold('Commonplace companion');
+  const same = [1, 2, 3].map((n) => conn.run(verified('cccc3333-same'), () => conn.request(`/account/api/same${n}`)));
+  const companion = conn.run(null, () => conn.request('/account/api/comp'));
+  await tick();
+  release();
+  await tick();
+  other();
+  const results = await Promise.all(same);
+  const comp = await companion;
+  assert.equal(registrations.filter((n) => n.startsWith('codex chat')).length, 1);
+  assert.equal(registrations.filter((n) => n === 'Commonplace companion').length, 1);
+  assert.equal(new Set(results.map((r) => r.agentId)).size, 1);
+  assert.deepEqual(results.map((r) => r.path), ['/account/api/same1', '/account/api/same2', '/account/api/same3']);
+  assert.notEqual(comp.agentId, results[0].agentId);
+  assert.equal(calls.length, 4);
+});
+
+test('unverified context cannot claim a session id and never gets a chat registration', async (t) => {
+  const { conn, registrations } = await connection(t);
+  await conn.run({ verified: false, sessionId: 'spoof', provider: 'codex' }, () => conn.request('/account/api/x'));
+  assert.deepEqual(registrations, ['Commonplace companion']);
+});
diff --git a/tests/archive-short-transaction-authority.test.mjs b/tests/archive-short-transaction-authority.test.mjs
new file mode 100644
index 0000000..1fba9f3
--- /dev/null
+++ b/tests/archive-short-transaction-authority.test.mjs
@@ -0,0 +1,74 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {mkdtemp,rm} from 'node:fs/promises';
+import {tmpdir} from 'node:os';
+import path from 'node:path';
+import {openDatabase} from '../apps/commonplace-account/server/sqlite.mjs';
+import {AccountService} from '../apps/commonplace-account/server/service.mjs';
+import {CloudWork} from '../apps/commonplace-account/server/cloud-work.mjs';
+import {CloudArchive} from '../apps/commonplace-account/server/cloud-archive.mjs';
+import {ContextStore} from '../apps/commonplace-account/server/context-store.mjs';
+import {sharedContext,closeSharedContext} from '../apps/commonplace-account/server/shared-context.mjs';
+import {buildContextFiles} from '../apps/commonplace-account/server/archive-index.mjs';
+
+// The read transaction now ends before the (slow) derived-file build. These
+// tests change authority while that build is waiting and check what leaves.
+async function fixture(t){
+  const dir=await mkdtemp(path.join(tmpdir(),'archive-short-txn-authority-')),previous=process.env.COMMONPLACE_CONTEXT_DIR;
+  process.env.COMMONPLACE_CONTEXT_DIR=path.join(dir,'web');
+  const db=openDatabase(path.join(dir,'db.sqlite'),{migrations:path.resolve('apps/commonplace-account/drizzle')});
+  t.after(async()=>{await closeSharedContext({db});db.close();if(previous===undefined)delete process.env.COMMONPLACE_CONTEXT_DIR;else process.env.COMMONPLACE_CONTEXT_DIR=previous;await rm(dir,{recursive:true,force:true});});
+  const service=new AccountService(db,'https://relay.example'),owner=(await service.profile({userId:'owner',email:'owner@example.test'})).id;
+  const store=new ContextStore(service);
+  store.upsert(owner,{conversation:{id:'conversation-one',title:'Orchid notes',capturedAt:Date.now()},messages:[{id:'message-one',role:'user',text:'Orchid secret-payload',position:0,capturedAt:Date.now()}]});
+  const revision=()=>db.sqlite.prepare('SELECT revision FROM cp_cloud_archive_state WHERE owner=?').get(owner).revision;
+  return {dir,db,service,owner,store,revision};
+}
+// Runs `action` once, after the next build's source reads but before it publishes.
+// sharedContext builds in a worker thread; run the same materialize in-process
+// so the build can be paused deterministically.
+function duringNextBuild(t,action){
+  const original=CloudArchive.prototype.materialize;let armed=true;
+  t.mock.method(CloudArchive.prototype,'materializeInWorker',function(owner){
+    if(armed){armed=false;const build=this.buildFiles;this.buildFiles=async(...args)=>{this.buildFiles=build;await build(...args);action();};}
+    this.background=false;
+    return original.call(this,owner).finally(()=>{this.background=true;});
+  });
+}
+const rawId=id=>id.replace(/^chatgpt-/,"");
+
+test('sharedContext withholds bytes when a source is excluded while the build waits',async t=>{
+  const f=await fixture(t);
+  const head=await sharedContext(f.service,f.owner,'archive-manifest',{}),doc=head.documents[0];
+  assert.match((await sharedContext(f.service,f.owner,'archive-files',{revision:head.revision,paths:[doc.path]})).files[0].text,/secret-payload/);
+  // Force a rebuild, then exclude the source inside it.
+  f.store.upsert(f.owner,{conversation:{id:'conversation-two',title:'Other',capturedAt:Date.now()},messages:[{id:'message-two',role:'user',text:'Other fact',position:0,capturedAt:Date.now()}]});
+  duringNextBuild(t,()=>f.store.remove(f.owner,rawId(doc.id)));
+  const result=await sharedContext(f.service,f.owner,'archive-files',{paths:[doc.path]});
+  assert.equal(result.restart,true);assert.equal(result.changed,true);
+  assert.doesNotMatch(JSON.stringify(result),/secret-payload/);
+  // The next request rebuilds from the new authority and the source is gone.
+  const after=await sharedContext(f.service,f.owner,'archive-manifest',{});
+  assert.ok(!after.documents.some(d=>d.id===doc.id));
+});
+
+test('a revised source during the build is withheld by a revision-pinned read',async t=>{
+  const f=await fixture(t);
+  duringNextBuild(t,()=>f.store.upsert(f.owner,{conversation:{id:'conversation-one',title:'Orchid notes',capturedAt:Date.now()},messages:[{id:'message-one',role:'user',text:'Orchid revised-payload',position:0,capturedAt:Date.now()}]}));
+  const stale=await sharedContext(f.service,f.owner,'archive-manifest',{});
+  assert.equal(stale.restart,true,'manifest from a superseded revision is not released');
+  assert.equal(stale.documents,undefined);
+});
+
+test('prepare can return a snapshot older than the live revision (pre-existing window); callers must fence',async t=>{
+  const f=await fixture(t);
+  const archive=new CloudArchive(new CloudWork(f.service),{directory:path.join(f.dir,'archives'),buildFiles:async(...args)=>{await buildContextFiles(...args);f.store.remove(f.owner,rawId(args[1].documents[0].id));}});
+  const snapshot=await archive.prepare(f.owner);
+  try{
+    assert.ok(snapshot.manifest.revision<f.revision(),'snapshot is behind: prepare alone is not an authority check');
+    assert.equal(f.db.sqlite.prepare('SELECT published_revision<revision AS behind FROM cp_cloud_archive_state WHERE owner=?').get(f.owner).behind,1,'shared state does not claim the stale snapshot is current');
+  }finally{await snapshot.release();}
+  // The next prepare sees needed > manifest.revision and rebuilds without the source.
+  const fresh=await new CloudArchive(new CloudWork(f.service),{directory:path.join(f.dir,'archives')}).prepare(f.owner);
+  try{assert.equal(fresh.manifest.revision,f.revision());assert.equal(fresh.manifest.documents.length,0);}finally{await fresh.release();}
+});
diff --git a/tests/archive-short-transaction.test.mjs b/tests/archive-short-transaction.test.mjs
new file mode 100644
index 0000000..b370710
--- /dev/null
+++ b/tests/archive-short-transaction.test.mjs
@@ -0,0 +1,65 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {mkdtemp,rm,readFile} from 'node:fs/promises';
+import {tmpdir} from 'node:os';
+import path from 'node:path';
+import {DatabaseSync} from 'node:sqlite';
+import {openDatabase} from '../apps/commonplace-account/server/sqlite.mjs';
+import {AccountService} from '../apps/commonplace-account/server/service.mjs';
+import {CloudWork} from '../apps/commonplace-account/server/cloud-work.mjs';
+import {CloudArchive} from '../apps/commonplace-account/server/cloud-archive.mjs';
+import {ContextStore} from '../apps/commonplace-account/server/context-store.mjs';
+import {buildContextFiles} from '../apps/commonplace-account/server/archive-index.mjs';
+
+async function fixture(t){
+  const dir=await mkdtemp(path.join(tmpdir(),'archive-short-txn-'));
+  const file=path.join(dir,'db.sqlite'),db=openDatabase(file,{migrations:path.resolve('apps/commonplace-account/drizzle')});
+  t.after(async()=>{db.close();await rm(dir,{recursive:true,force:true});});
+  const service=new AccountService(db,'https://relay.example'),owner=(await service.profile({userId:'owner',email:'owner@example.test'})).id;
+  new ContextStore(service).upsert(owner,{conversation:{id:'conversation-one',title:'Orchid',capturedAt:Date.now()},messages:[{id:'message-one',role:'user',text:'Orchid fact',position:0,capturedAt:Date.now()}]});
+  return {dir,file,db,service,owner};
+}
+// A WAL TRUNCATE checkpoint reports busy while any reader holds an older
+// snapshot, so it observes whether the archive's read transaction is open.
+function observeReader(file){
+  const writer=new DatabaseSync(file);
+  try{
+    writer.exec('PRAGMA busy_timeout=0');
+    writer.prepare('UPDATE cp_cloud_archive_state SET error=error WHERE 1=0').run();
+    writer.exec("CREATE TABLE IF NOT EXISTS short_txn_probe(n)");writer.exec('INSERT INTO short_txn_probe VALUES(1)');
+    return writer.prepare('PRAGMA wal_checkpoint(TRUNCATE)').get().busy===1;
+  }finally{writer.close();}
+}
+
+test('the archive read transaction is closed before derived files are built',async t=>{
+  const f=await fixture(t);
+  let pinned,stagedManifest;
+  const archive=new CloudArchive(new CloudWork(f.service),{directory:path.join(f.dir,'archives'),buildFiles:async(staging,manifest,options)=>{
+    pinned=observeReader(f.file);stagedManifest=manifest;
+    return buildContextFiles(staging,manifest,options);
+  }});
+  const snapshot=await archive.prepare(f.owner);
+  await snapshot.release();
+  assert.equal(pinned,false,'no read snapshot pinning the WAL during the build');
+  const published=JSON.parse(await readFile(path.join(snapshot.directory,'manifest.json'),'utf8'));
+  assert.equal(published.revision,stagedManifest.revision);
+  assert.equal(published.documents.length,1);
+  assert.ok(published.sources&&Object.keys(published.sources).length>=1);
+  assert.equal(f.db.sqlite.prepare('SELECT published_revision=revision AS ok FROM cp_cloud_archive_state WHERE owner=?').get(f.owner).ok,1);
+});
+
+test('the probe detects an open read transaction (control)',async t=>{
+  const f=await fixture(t);
+  const reader=new DatabaseSync(f.file,{readOnly:true});
+  reader.exec('BEGIN');reader.prepare('SELECT count(*) FROM cp_cloud_archive_state').get();
+  t.after(()=>reader.close());
+  assert.equal(observeReader(f.file),true);
+});
+
+test('a failed index build leaves no published generation and an unchanged published revision',async t=>{
+  const f=await fixture(t);
+  const archive=new CloudArchive(new CloudWork(f.service),{directory:path.join(f.dir,'archives'),buildFiles:async()=>{throw Error('build failed');}});
+  await assert.rejects(archive.prepare(f.owner),/build failed/);
+  assert.equal(await archive.current(f.owner),null);
+  assert.notEqual(f.db.sqlite.prepare('SELECT published_revision=revision AS ok FROM cp_cloud_archive_state WHERE owner=?').get(f.owner).ok,1);
+});
