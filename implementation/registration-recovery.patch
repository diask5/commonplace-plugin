+import test from 'node:test';
+import {execFileSync} from 'node:child_process';
+import assert from 'node:assert/strict';
+import {randomBytes,createHash} from 'node:crypto';
+import {mkdtemp,rm} from 'node:fs/promises';
+import {tmpdir} from 'node:os';
+import path from 'node:path';
+import {openDatabase} from '../apps/commonplace-account/server/sqlite.mjs';
+import {AccountService} from '../apps/commonplace-account/server/service.mjs';
+import {CloudWork} from '../apps/commonplace-account/server/cloud-work.mjs';
+import {CloudArchive} from '../apps/commonplace-account/server/cloud-archive.mjs';
+import {closeSharedContext} from '../apps/commonplace-account/server/shared-context.mjs';
+import {CloudWorker} from '../apps/commonplace-account/server/cloud-worker.mjs';
+import {CredentialVault} from '../apps/commonplace-account/server/subscription-runner.mjs';
+const uid=()=>randomBytes(12).toString('hex');
+const answer=(text,citations=[])=>({kind:'answer',text,citations,targetAgentId:null});
+async function fixture(t){
+  const dir=await mkdtemp(path.join(tmpdir(),'cloud-authority-')),db=openDatabase(path.join(dir,'db.sqlite'),{migrations:path.resolve('apps/commonplace-account/drizzle')});
+  t.after(async()=>{await closeSharedContext({db});db.close();await rm(dir,{recursive:true,force:true});});
+  const service=new AccountService(db,'https://relay.example'),owner=(await service.profile({userId:'owner',email:'owner@example.test'})).id;
+  const work=new CloudWork(service),archive=new CloudArchive(work,{directory:path.join(dir,'archives')}),vault=new CredentialVault(randomBytes(32));
