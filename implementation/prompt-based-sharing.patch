+    if (delayed) {delayed = false; await new Promise(resolve => {release = resolve;});}
+    if (failing) return new Response('Private provider error', {status: 503});
+    const item = sharingCases.find(c => c.candidate.text === body.state.candidate.text && c.candidate.title === body.state.candidate.title);
+    assert.ok(item, 'only fixed synthetic candidates reach provider');
