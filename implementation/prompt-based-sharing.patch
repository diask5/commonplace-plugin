+// Private local experiment. Only fixed synthetic examples can reach the provider.
+import {randomBytes} from 'node:crypto';
+import {PolicyContext} from '../apps/commonplace-account/server/policy-context.mjs';
+import {configuredDecider} from './policy-sharing-config.mjs';
+import {sharingCases, sampleAuthority, sampleRules} from './policy-sharing-fixtures.mjs';
+import {policyPage} from './policy-sharing-page.mjs';
+const prefix = '/preview/rules';
+const examples = new Set(['progress','decision','mixed','finances','private-title','injection','confidential-neighbor','other-project']);
+
+export function policyPreview({getDecider = configuredDecider, maxRuns = 12} = {}) {
+  const token = randomBytes(32).toString('hex'); let busy = false, runs = 0;
+  const authorized = req => (req.headers.cookie || '').split(/;\s*/).includes('policy_preview=' + token);
+  const json = (res, status, body) => {res.writeHead(status, {'Content-Type': 'application/json', 'Cache-Control': 'no-store'}); res.end(JSON.stringify(body));};
+  return {token, async handle(req, res, url) {
+    if (url.pathname !== prefix && !url.pathname.startsWith(prefix + '/')) return false;
+    res.setHeader('Cache-Control', 'no-store'); res.setHeader('Referrer-Policy', 'no-referrer'); res.setHeader('X-Content-Type-Options', 'nosniff');
+    if (url.pathname === prefix + '/open' && req.method === 'GET' && url.searchParams.get('token') === token) {
+      res.writeHead(303, {Location: prefix, 'Set-Cookie': 'policy_preview=' + token + '; HttpOnly; SameSite=Strict; Path=' + prefix + (url.protocol === 'https:' ? '; Secure' : '')}); res.end(); return true;
+    }
+    if (req.method === 'GET' && url.pathname === prefix) {
+      const nonce = randomBytes(18).toString('base64');
+      res.writeHead(200, {'Content-Type': 'text/html; charset=utf-8', 'Content-Security-Policy': "default-src 'none'; script-src 'nonce-" + nonce + "'; style-src 'nonce-" + nonce + "'; font-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"}); res.end(policyPage(nonce)); return true;
+    }
+    if (!authorized(req)) {json(res, 401, {error: 'Open the private test link from your workspace.'}); return true;}
+    if (req.method === 'GET' && url.pathname === prefix + '/status') {
+      try {const d = await getDecider(); json(res, 200, {configured: d.configured, model: d.model, location: d.local ? 'Decider on this computer' : 'Perplexity hosted API', rules: sampleRules});}
+      catch {json(res, 503, {error: 'Check the Perplexity configuration in your workspace.'});} return true;
+    }
+    if (req.method !== 'POST' || url.pathname !== prefix + '/evaluate') {json(res, 404, {error: 'Not found.'}); return true;}
+    if (req.headers.origin !== url.origin || req.headers['content-type']?.split(';')[0] !== 'application/json') {json(res, 403, {error: 'Use the test page on this origin.'}); return true;}
+    if (busy || runs >= maxRuns) {json(res, 429, {error: busy ? 'A test is already running. Wait for it to finish.' : 'This experiment reached its run limit. Restart the local preview to continue.'}); return true;}
+    let body;
+    try {let bytes = 0, text = ''; for await (const part of req) {bytes += part.length; if (bytes > 20000) throw Error(); text += part;} body = JSON.parse(text);
+      if (!body || Array.isArray(body) || Object.keys(body).length !== 1 || typeof body.rules !== 'string' || !body.rules.trim() || body.rules.length > 4000) throw Error();}
+    catch {json(res, 400, {error: 'Write sharing rules of 1–4,000 characters.'}); return true;}
+    // Recheck after reading the body; concurrent requests may have passed the first check.
+    if (busy || runs >= maxRuns) {json(res, 429, {error: 'A test is already running or the run limit was reached.'}); return true;}
+    busy = true;
+    try {
+      const d = await getDecider(); if (!d.configured) {json(res, 503, {error: 'Configure PERPLEXITY_API_KEY, then retry.'}); return true;}
+      runs++;
+      const a = sampleAuthority(body.rules), candidates = sharingCases.filter(c => examples.has(c.id)).map(c => c.candidate);
+      const decider = {model: d.model, decide: async input => {try {return await d.decide(input);} finally {await new Promise(resolve => setTimeout(resolve, 125));}}};
+      const gate = new PolicyContext({decider, getAuthority: async () => a, getCandidates: async () => candidates, isCurrent: async () => true});
+      json(res, 200, await gate.preview({principal: a.ownerId, grantId: a.id}));
+    } catch {json(res, 503, {error: 'The test could not complete. Check the provider configuration and retry.'});}
+    finally {busy = false;}
+    return true;
+  }};
+}
