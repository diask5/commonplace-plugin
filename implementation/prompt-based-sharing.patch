+    await page.goto(preview.origin + preview.policyAccessPath);await page.waitForFunction(() => !document.getElementById('test-rules').disabled);
+    assert.equal(new URL(page.url()).search, '');assert.equal(await page.evaluate(() => document.cookie.includes('policy_preview')), false, 'HttpOnly cookie');
+    const cookie = (await context.cookies()).find(c => c.name === 'policy_preview');
