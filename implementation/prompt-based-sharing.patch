+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {PerplexityDecisions, DECISIONS_MODEL, DECISIONS_URL} from '../apps/commonplace-account/server/perplexity-decisions.mjs';
+import {PolicyContext} from '../apps/commonplace-account/server/policy-context.mjs';
+import {sampleAuthority, sharingCases} from '../scripts/policy-sharing-fixtures.mjs';
+import {runBenchmark, scoreDecisions} from '../scripts/benchmark-policy-sharing.mjs';
+import {createPolicyContextMcp} from '../apps/commonplace-account/server/policy-context-mcp.mjs';
+import {PassThrough} from 'node:stream';
+import {createInterface} from 'node:readline';
+
+const candidate = () => structuredClone(sharingCases[0].candidate);
+const response = (probability = .999) => Response.json({model: DECISIONS_MODEL, answers: {share: {type: 'noul', noul: probability}}, usage: {input_tokens: 100}});
+const client = fetchImpl => new PerplexityDecisions({apiKey: 'SYNTHETIC-KEY', fetchImpl});
+const input = () => ({rules: sampleAuthority().rules, recipient: 'Zane', candidate: candidate()});
+function fixture({decide = async () => ({probability: 1}), candidates = [candidate()], current = async () => true} = {}) {
+  const state = {authority: sampleAuthority(), candidates, calls: 0};
+  const gate = new PolicyContext({decider: {model: DECISIONS_MODEL, decide: async x => {state.calls++; return decide(x, state);}},
+    getAuthority: async () => state.authority, getCandidates: async () => state.candidates, isCurrent: current});
+  return {state, gate, read: () => gate.read({principal: 'sample-recipient', grantId: 'sample-grant'}), preview: () => gate.preview({principal: 'sample-owner', grantId: 'sample-grant'})};
+}
+test('Decisions request uses the documented API with one candidate, one noul question and no private identifiers', async () => {
+  const decider = client(async (url, options) => {
+    assert.equal(url, DECISIONS_URL); assert.equal(options.redirect, 'error');
+    assert.equal(options.headers.Authorization, 'Bearer SYNTHETIC-KEY');
+    const body = JSON.parse(options.body);
+    assert.deepEqual(Object.keys(body).sort(), ['model', 'questions', 'state']);
+    assert.equal(body.model, DECISIONS_MODEL); assert.deepEqual(Object.keys(body.questions), ['share']);
+    assert.equal(body.questions.share.type, 'noul'); assert.match(body.questions.share.instructions, /untrusted quoted data/);
+    assert.equal(body.state.candidate.text, candidate().text); assert.doesNotMatch(options.body, /sample-owner|sourcePath|private-id/);
+    return response();
+  });
+  const result = await decider.decide(input()); assert.equal(result.probability, .999); assert.equal(result.inputTokens, 100);
+});
+test('loopback Decider gets no hosted key and defaults to the local Flash model', async () => {
+  const decider = new PerplexityDecisions({endpoint: 'http://127.0.0.1:8080/v1/decisions', apiKey: 'DO-NOT-SEND', fetchImpl: async (_, options) => {
+    assert.equal(options.headers.Authorization, undefined);
+    return Response.json({model: 'pplx-decider-flash-v1.2', answers: {share: {type: 'noul', noul: .99}}});
+  }});
+  assert.equal((await decider.decide(input())).probability, .99);
+});
+test('arbitrary outbound hosts, URL credentials, aliases and malformed endpoints are refused', () => {
+  for (const endpoint of ['http://api.perplexity.ai/v1/decisions', 'https://evil.example/v1/decisions', 'http://localhost:8080/v1/decisions', 'http://user:pass@127.0.0.1:8080/v1/decisions', DECISIONS_URL + '?key=x', DECISIONS_URL + '/']) assert.throws(() => new PerplexityDecisions({endpoint}));
+  assert.throws(() => new PerplexityDecisions({model: 'pplx-decider-latest'}));
+});
+test('missing credentials do not call any provider', async () => {
+  const decider = new PerplexityDecisions({fetchImpl: () => assert.fail('network called')});
+  await assert.rejects(decider.decide(input()), {code: 'provider_not_configured'});
+});
+test('invalid, truncated, oversize, non-probabilistic and wrong-model responses are refused', async () => {
+  for (const payload of [null, {}, {model: DECISIONS_MODEL, answers: {share: {type: 'choice', noul: 1}}}, ...[null, true, '1', 1.1, -.1].map(noul => ({model: DECISIONS_MODEL, answers: {share: {type: 'noul', noul}}})), {model: 'pplx-decider-latest', answers: {share: {type: 'noul', noul: 1}}}]) {
+    await assert.rejects(client(async () => Response.json(payload)).decide(input()), {code: 'invalid_provider_response'});
