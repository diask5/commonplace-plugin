@@ -0,0 +1,101 @@
+import {createHash} from 'node:crypto';
+import {Groups} from './groups.mjs';
+import {PolicyContext,policyRules} from './policy-context.mjs';
+import {PerplexityDecisions} from './perplexity-decisions.mjs';
+import {sharedContext} from './shared-context.mjs';
+import {WorkProblem} from './work.mjs';
+const fail=(status,message)=>{throw new WorkProblem(status,message);};
+const id=v=>{if(typeof v!=='string'||!/^[a-f0-9]{24}$/.test(v))fail(400,'Invalid space request.');return v;};
+const digest=v=>createHash('sha256').update(JSON.stringify(v)).digest('hex');
+const initialized=new WeakSet();
+// Separate owner policies and owner audit rows. Shared activity never contains
+// policy text, rejected titles/snippets, source IDs, or provider error bodies.
+export class SpaceContext extends Groups {
+ constructor(service){
+  super(service);
+  if(!initialized.has(this.db)){
+   this.db.exec(`CREATE TABLE IF NOT EXISTS cp_space_policies(workspace TEXT NOT NULL,owner TEXT NOT NULL,revision INTEGER NOT NULL,rules TEXT NOT NULL,enabled INTEGER NOT NULL,updated_at INTEGER NOT NULL,PRIMARY KEY(workspace,owner));
+    CREATE TABLE IF NOT EXISTS cp_space_exchanges(id TEXT PRIMARY KEY,workspace TEXT NOT NULL,requester TEXT NOT NULL,contributor TEXT NOT NULL,query TEXT NOT NULL,payload TEXT NOT NULL,state TEXT NOT NULL,excerpts TEXT NOT NULL DEFAULT '[]',at INTEGER NOT NULL);
+    CREATE INDEX IF NOT EXISTS cp_space_exchanges_board ON cp_space_exchanges(workspace,at,id);
+    CREATE TABLE IF NOT EXISTS cp_space_checks(exchange TEXT PRIMARY KEY,owner TEXT NOT NULL,audit TEXT NOT NULL,revision INTEGER NOT NULL);`);
+   initialized.add(this.db);
+  }
+  this.decider=service.spaceContextOptions?.decider||new PerplexityDecisions({apiKey:process.env.PERPLEXITY_API_KEY||''});
+ }
+ policy(owner,{groupId}){
+  this.member(owner,groupId);const row=this.get('SELECT * FROM cp_space_policies WHERE workspace=? AND owner=?',groupId,owner);
+  return {revision:row?.revision||0,rules:row?JSON.parse(row.rules):[],enabled:!!row?.enabled&&row.updated_at>=(this.get('SELECT joined_at FROM cp_workspace_members WHERE workspace=? AND person=?',groupId,owner)?.joined_at||0),providerReady:this.decider.configured===true};
+ }
+ save(owner,{groupId,expectedRevision,rules,enabled}){
+  this.member(owner,groupId);const normalized=policyRules(rules);
+  if(!normalized||typeof enabled!=='boolean'||!Number.isSafeInteger(expectedRevision)||expectedRevision<0)fail(400,'Add 1–8 rules, up to 4,000 characters total.');
+  if(enabled&&!this.decider.configured)fail(409,'The Decisions provider is not configured. Your library stays private.');
+  return this.atomic(()=>{
+   const old=this.policy(owner,{groupId});if(old.revision!==expectedRevision)fail(409,'Your rules changed in another tab. Reload them before saving.');
+   this.run('INSERT INTO cp_space_policies VALUES(?,?,?,?,?,?) ON CONFLICT(workspace,owner) DO UPDATE SET revision=excluded.revision,rules=excluded.rules,enabled=excluded.enabled,updated_at=excluded.updated_at',groupId,owner,old.revision+1,JSON.stringify(normalized),Number(enabled),Date.now());
+   return this.policy(owner,{groupId});
+  });
+ }
+ scope(owner,groupId,contributor){
+  this.member(owner,groupId);this.member(contributor,groupId);
+  return digest(this.all('SELECT person,role,joined_at,revoked FROM cp_workspace_members WHERE workspace=? ORDER BY person',groupId));
+ }
+ archiveRevision(owner){return this.get('SELECT revision FROM cp_cloud_archive_state WHERE owner=?',owner)?.revision??0;}
+ async candidates(owner,query){
+  if(this.s.spaceContextOptions?.candidates)return this.s.spaceContextOptions.candidates(owner,query);
+  const found=await sharedContext(this.s,owner,'archive-search',{query});
+  const candidates=[];
+  // Complete bounded documents only. Never classify an isolated search snippet
+  // without its confidentiality/negation context. Large documents fail closed.
+  for(const result of [...new Map(found.results.map(r=>[r.documentId,r])).values()].slice(0,6)){
+   const doc=await sharedContext(this.s,owner,'archive-read',{documentId:result.documentId,revision:found.revision,offset:0,limit:16000});
+   if(doc.changed)fail(409,'Context changed. Try the request again.');
+   const valid=doc.nextOffset===null&&doc.text.length<=8000;
+   candidates.push({id:result.documentId,ownerId:owner,excluded:false,title:doc.title,text:valid?doc.text:'',context:valid?doc.text:'',revision:found.revision,reason:valid?null:'document_too_large'});
+  }
+  return candidates;
+ }
+ board(owner,{groupId,before=Number.MAX_SAFE_INTEGER}){
+  this.member(owner,groupId);if(!Number.isSafeInteger(before)||before<1)fail(400,'Invalid activity cursor.');
+  const rows=this.all('SELECT rowid AS seq,* FROM cp_space_exchanges WHERE workspace=? AND rowid<? ORDER BY rowid DESC LIMIT 51',groupId,before),more=rows.length>50;rows.splice(50);rows.reverse();
+  return {events:rows.map(r=>({id:r.id,seq:r.seq,requester:r.requester,contributor:r.contributor,query:r.query,state:r.state==='checking'&&r.at<Date.now()-120000?'interrupted':r.state,excerpts:JSON.parse(r.excerpts),at:r.at,...(r.contributor===owner?{privateChecks:this.privateChecks(owner,r.id)}:{})})),nextBefore:more?rows[0].seq:null};
+ }
+ privateChecks(owner,exchange){const row=this.get('SELECT audit,revision FROM cp_space_checks WHERE exchange=? AND owner=?',exchange,owner);return row?{audit:JSON.parse(row.audit),revision:row.revision}:null;}
+ async request(owner,{groupId,contributorId,query,nonce}){
+  id(nonce);id(contributorId);const scope=this.scope(owner,groupId,contributorId);
+  if(typeof query!=='string'||!query.trim()||query.length>300)fail(400,'Ask for context in 1–300 characters.');query=query.trim();
+  const payload=digest([groupId,owner,contributorId,query]);
+  const prior=this.get('SELECT * FROM cp_space_exchanges WHERE id=?',nonce);
+  if(prior){if(prior.payload!==payload)fail(409,'Use a new request identifier.');if(prior.state==='checking')fail(409,'This request is still checking. Refresh the board.');return {id:prior.id,state:prior.state,excerpts:JSON.parse(prior.excerpts),replayed:true};}
+  // At most one in-flight request per contributor across all spaces, including
+  // multiple server processes. Provider deadlines bound stale claim recovery.
+  this.atomic(()=>{
+   if(this.get("SELECT 1 FROM cp_space_exchanges WHERE contributor=? AND state='checking' AND at>?",contributorId,Date.now()-120000))fail(429,'This library is checking another request. Try again shortly.');
