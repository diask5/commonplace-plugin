+import {createHash} from 'node:crypto';
+import {Groups} from './groups.mjs';
+import {safePersonName} from './people-discovery.mjs';
+import {WorkProblem} from './work.mjs';
+const fail=(status,text)=>{throw new WorkProblem(status,text);};
+const hash=code=>{if(typeof code!=='string'||!/^[A-Za-z0-9_-]{43}$/.test(code))fail(400,'Invalid space invitation.');return createHash('sha256').update(code).digest('hex');};
+const initialized=new WeakSet();
+// Owner-issued, reusable group links. Only the hash is stored; a link grants
+// group membership after explicit acceptance, never personal archive access.
+export class SpaceInvitations extends Groups {
+ constructor(service){super(service);if(!initialized.has(this.db)){this.db.exec('CREATE TABLE IF NOT EXISTS cp_space_invites(hash TEXT PRIMARY KEY,workspace TEXT NOT NULL,issuer TEXT NOT NULL,created_at INTEGER NOT NULL,expires_at INTEGER NOT NULL,revoked INTEGER NOT NULL DEFAULT 0)');initialized.add(this.db);}}
+ create(owner,{groupId,code}){this.member(owner,groupId,true);const key=hash(code),old=this.get('SELECT * FROM cp_space_invites WHERE hash=?',key);if(old){if(old.workspace!==groupId||old.issuer!==owner)fail(409,'Use a new invitation link.');if(old.revoked||old.expires_at<=Date.now())fail(409,'This link has ended. Create another.');return {expiresAt:old.expires_at};}const now=Date.now(),expires=now+14*86400000;this.run('INSERT INTO cp_space_invites(hash,workspace,issuer,created_at,expires_at) VALUES(?,?,?,?,?)',key,groupId,owner,now,expires);return {expiresAt:expires};}
+ preview({code}){const row=this.get('SELECT i.*,w.name FROM cp_space_invites i JOIN cp_groups g ON g.workspace=i.workspace AND g.archived=0 JOIN cp_workspaces w ON w.id=i.workspace JOIN cp_workspace_members m ON m.workspace=i.workspace AND m.person=i.issuer AND m.role=\'owner\' AND m.revoked=0 WHERE i.hash=? AND i.revoked=0 AND i.expires_at>?',hash(code),Date.now());if(!row)fail(404,'This invitation has expired or ended. Ask the space owner for a new link.');const profile=this.get('SELECT COALESCE(u.display_name,p.name) AS name FROM cp_profiles p LEFT JOIN cp_public_profiles u ON u.owner=p.id WHERE p.id=?',row.issuer);return {groupId:row.workspace,name:row.name,inviter:safePersonName(profile?.name),expiresAt:row.expires_at};}
+ accept(owner,{code}){return this.atomic(()=>{const info=this.preview({code});const existing=this.get('SELECT revoked FROM cp_workspace_members WHERE workspace=? AND person=?',info.groupId,owner);if(existing?.revoked===0)return this.describe(owner,info.groupId);if(existing?.revoked===1)fail(403,'You were removed from this space. Ask its owner to add you again.');const members=this.get('SELECT count(*) AS n FROM cp_workspace_members WHERE workspace=? AND revoked=0',info.groupId).n;if(members>=50)fail(409,'This space is full. Ask its owner for help.');this.addMember(info.groupId,owner);this.bump(owner,info.groupId,'Joined by invitation');return this.describe(owner,info.groupId);});}
+ revoke(owner,{groupId}){this.member(owner,groupId,true);this.run('UPDATE cp_space_invites SET revoked=1 WHERE workspace=? AND revoked=0',groupId);return {revoked:true};}
+}
