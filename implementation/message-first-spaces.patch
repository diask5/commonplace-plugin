+   // Invoke the owner projection internally; only the filtered view leaves it.
+   const result=await gate.preview({principal:contributorId,grantId:groupId,query,signal:AbortSignal.timeout(20000)});
+   return this.atomic(()=>{
+    if(digest(authority())!==policySnapshot)fail(409,'Rules changed.');if(capturedRevision!==this.archiveRevision(contributorId))fail(409,'Context changed.');
+    const state=result.recipientView.excerpts.length?'shared':'no_context';
+    this.run('UPDATE cp_space_exchanges SET state=?,excerpts=? WHERE id=?',state,JSON.stringify(result.recipientView.excerpts),nonce);
+    this.run('INSERT INTO cp_space_checks VALUES(?,?,?,?)',nonce,contributorId,JSON.stringify(result.audit),this.policy(contributorId,{groupId}).revision);
+    return {id:nonce,state,excerpts:result.recipientView.excerpts};
+   });
+  }catch(error){
+   this.run("UPDATE cp_space_exchanges SET state='unavailable' WHERE id=?",nonce);
+   this.run('INSERT OR REPLACE INTO cp_space_checks VALUES(?,?,?,?)',nonce,contributorId,JSON.stringify([{decision:'withhold',reason:'request_stopped',checks:[]}]),this.get('SELECT revision FROM cp_space_policies WHERE workspace=? AND owner=?',groupId,contributorId)?.revision||0);
+   // No private failure, match count or policy detail is revealed to requester.
+   return {id:nonce,state:'unavailable',excerpts:[]};
+  }
+ }
+}
