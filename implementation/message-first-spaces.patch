+  });
+  let capturedRevision=null;
+  const authority=()=>{
+   if(this.scope(owner,groupId,contributorId)!==scope)fail(409,'Space membership changed. Try again.');
+   const p=this.policy(contributorId,{groupId});
+   return {id:groupId,ownerId:contributorId,recipientId:owner,recipientLabel:JSON.stringify({space:this.member(owner,groupId).name,audience:'All current and future space members can read approved excerpts in the history',currentMembers:this.members(owner,groupId).map(m=>({id:m.id,name:m.name}))}),active:p.enabled,revision:p.revision,rules:p.rules,expiresAt:8640000000000000};
+  };
+  let policySnapshot;try{policySnapshot=digest(authority());}catch{}
+  const gate=new PolicyContext({decider:this.decider,getAuthority:authority,getCandidates:async()=>{const rows=await this.candidates(contributorId,query);capturedRevision=this.archiveRevision(contributorId);if(rows.some(r=>r.revision!==capturedRevision))fail(409,'Context changed.');return rows;},isCurrent:()=>capturedRevision===this.archiveRevision(contributorId)});
