+test('candidate batches share the eight-call ceiling and retain source order', {timeout:3000}, async () => {
+  for(const ruleCount of [1,3,8]){
+    const count=17,width=Math.floor(8/ruleCount),waves=Math.ceil(count/width);
+    const ready=Array.from({length:waves},()=>Promise.withResolvers()),release=Array.from({length:waves},()=>Promise.withResolvers());
+    const started=Array(waves).fill(0);let active=0,peak=0;
+    const candidates=Array.from({length:count},(_,i)=>({...candidate(),id:String(i),text:'Public update '+i}));
+    const f=fixture({candidates,decide:async({candidate:c})=>{
+      const wave=Math.floor(Number(c.id)/width);active++;peak=Math.max(peak,active);
+      if(++started[wave]===Math.min(width,count-wave*width)*ruleCount)ready[wave].resolve();
+      await release[wave].promise;active--;return {probability:1};
+    }});
+    f.state.authority.rules=Array.from({length:ruleCount},(_,i)=>({id:'rule'+i,text:'Share public project updates.'}));
+    const pending=f.preview();
+    for(let wave=0;wave<waves;wave++){
+      await ready[wave].promise;
+      assert.equal(active,Math.min(width,count-wave*width)*ruleCount);assert.ok(peak<=8);
+      release[wave].resolve();
+    }
+    const result=await pending;
+    assert.equal(peak,width*ruleCount);assert.equal(f.state.calls,count*ruleCount);
+    assert.deepEqual(result.audit.map(x=>x.candidateId),candidates.map(x=>x.id));
+    assert.deepEqual(result.recipientView.excerpts.map(x=>x.text),candidates.map(x=>x.text));
+  }
+});
