+const dir=await mkdtemp(path.join(tmpdir(),'sync-index-bench-')),root=path.join(dir,'chats');await mkdir(root);
+const hash=s=>createHash('sha256').update(s).digest('hex'),owner='b'.repeat(24),rows=n=>Array.from({length:n},(_,i)=>JSON.stringify({sessionId:'backlog',uuid:'m'+i,type:'user',message:{role:'user',content:'Visible synthetic turn '+i}})+'\n').join('');
+try{
+ const files={},now=Date.now();
+ for(let i=0;i<6721;i++){
+  const name='complete-'+i+'.jsonl',file=path.join(root,name);await writeFile(file,'');const stat=await lstat(file);
+  files[hash(root+':'+name)]={captureId:'seeded-complete',captureComplete:true,version:stat.size+':'+stat.mtimeMs,revision:1,lastReported:now};
+ }
+ await writeFile(path.join(root,'backlog.jsonl'),rows(6000));await writeFile(path.join(dir,'canonical-sync.json'),JSON.stringify({owner,format:3,files}));
+ let uploads=0,complete=false;const received=new Set(),passes=[];
+ const sync=new CanonicalSync({dir,accountClient:{request:async(_,input)=>{assert.ok(Buffer.byteLength(JSON.stringify(input))<=64000);uploads++;for(const m of input.messages){assert.equal(m.text,'Visible synthetic turn '+Number(m.id.split(':')[0].slice(1)));received.add(m.id);}complete=input.state==='current';return {id:input.sourceKey};}}},{now:()=>now,scanIntervalMs:30000,watchRoots:false});
+ const started=performance.now();
