+    const file=path.resolve(root.path,String(name)),relative=path.relative(root.path,file);
+    if(relative.startsWith('..')||path.isAbsolute(relative)||relative.split(path.sep).some(n=>n.startsWith('.')||n==='node_modules'))return;
+    if(!/\.(jsonl|json)$/i.test(file)||this.dirty.size>=1000){this.snapshot=null;return;}
+    this.dirty.set(root.path+'\0'+file,{root,file});
+   });w.on('error',()=>{this.snapshot=null;w.close();});this.watchers.push(w);
+  }catch{/* Periodic scan reports unavailable roots and recovers unsupported watches. */}
+ }
