+  const relative=path.relative(canonicalRoot,await realpath(file));if(relative.startsWith('..')||path.isAbsolute(relative))return null;
+  const stat=await lstat(file);if(!stat.isFile()||stat.isSymbolicLink())return null;
+  return {root,file,canonicalRoot,relative,key:hash(root.path+':'+relative),id:root.path+'\0'+file,mtime:stat.mtimeMs,version:stat.size+':'+stat.mtimeMs};
+ }
