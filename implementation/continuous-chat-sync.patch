+});
+
+test('server throttling suspends the pump across restart and retries the exact durable chunk',async t=>{
+ const {dir,root,roots}=await fixture(t);await writeFile(path.join(root,'one.jsonl'),Array.from({length:300},(_,i)=>row(i)).join(''));
+ let now=1000,limited=true,calls=0,discoveries=0;const uploads=[];
+ const app={dir,accountClient:{state:{session:{humanAccount:{id:owner}}},view:()=>({connected:true}),request:async(route,body)=>{calls++;if(route.endsWith('/status'))return {syncEnabled:true,contextProtocol:1,contextAtomicCaptures:true};assert.ok(route.endsWith('/context-ingest'));uploads.push(body);if(limited)throw Object.assign(Error('slow down'),{status:429,retryAfter:7});return {id:body.sourceKey};}}};
+ const options={now:()=>now,budget:1,watchRoots:false,discover:async()=>{discoveries++;return [...roots];},prepareHistory:async()=>({roots:[],coverage:{partial:false}})};
+ let sync=await CloudSync.open(app,options);await sync.tick();assert.equal(sync.nextDelayMs,7000);const pending=JSON.parse(await readFile(path.join(dir,'canonical-sync.json'),'utf8')).pending.input;assert.deepEqual(pending,uploads[0]);
+ const before=calls;await sync.tick();assert.equal(calls,before);sync.close();sync=await CloudSync.open(app,options);t.after(()=>sync.close());await sync.tick();assert.equal(calls,before,'persisted backoff survives restart');
+ now+=7000;limited=false;await sync.tick();assert.deepEqual(uploads[1],uploads[0]);await sync.tick();assert.ok(uploads.length>2);assert.equal(discoveries,2,'continuation reuses prepared roots');
+});
+
+test('cooperative deadlines leave a resumable backlog and the pump continues without a five-second pause',async t=>{
+ const {dir,root,roots}=await fixture(t);await writeFile(path.join(root,'one.jsonl'),Array.from({length:1500},(_,i)=>row(i)).join(''));
+ let sent=0;const collector=new CanonicalSync({dir,accountClient:{request:async(_,body)=>{sent++;await delay(12);return {id:body.sourceKey};}}},{maxDurationMs:5});t.after(()=>collector.close());
+ const first=await collector.tick(owner,roots);assert.equal(sent,1);assert.equal(first.hasBacklog,true);
+ const sync=new CloudSync({dir},{version:1,files:{}},{watchRoots:false});let turns=0;sync.tick=async()=>{turns++;sync.nextDelayMs=0;if(turns===3)sync.close();};t.after(()=>sync.close());sync.start();
+ for(let i=0;i<50&&turns<3;i++)await delay(10);assert.equal(turns,3);await delay(20);assert.equal(turns,3,'close prevents rescheduling');
+});
+
+
+test('a disconnected or already-running collector yields instead of spinning the catch-up loop',async t=>{
+ const {dir}=await fixture(t),sync=new CloudSync({dir,accountClient:{view:()=>({connected:false})}},{version:1,files:{}},{watchRoots:false});t.after(()=>sync.close());
