+async function fixture(t){const dir=await mkdtemp(path.join(tmpdir(),'continuous-sync-')),root=path.join(dir,'chats');await mkdir(root);t.after(()=>rm(dir,{recursive:true,force:true}));return {dir,root,roots:[{path:root,name:'Claude chats',kind:'claude'}]};}
