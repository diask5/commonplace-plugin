+ const first=await sync.tick(owner,roots);assert.equal(received.length,10);assert.equal(first.hasBacklog,true);assert.equal(first.scanned,1);
+ const second=await sync.tick(owner,roots);assert.equal(second.scanMode,'cached');assert.equal(second.scanned,0);assert.equal(second.hasBacklog,false);assert.equal(received.at(-1).state,'current');
+ assert.equal(received.flatMap(r=>r.messages).length,1500);assert.equal(new Set(received.flatMap(r=>r.messages.map(m=>m.id))).size,1500);
+ assert.ok(received.slice(0,-1).every(r=>r.state==='backfilling'));assert.equal(new Set(received.map(r=>r.captureId)).size,1);
+});
+
+test('file index uses native change events and periodic fallback; incomplete discovery never asserts deletion',async t=>{
+ const {root,roots}=await fixture(t);let now=1000;const file=path.join(root,'one.jsonl');await writeFile(file,row(1));
+ const scanner=new HistoryScan({now:()=>now,intervalMs:30000}),cursors={};t.after(()=>scanner.close());
+ assert.equal((await scanner.scan(owner,roots,cursors)).scanned,1);assert.equal((await scanner.scan(owner,roots,cursors)).scanned,0);
+ await writeFile(file,row(1)+row(2));for(let i=0;i<100&&!scanner.dirty.size;i++)await delay(10);assert.ok(scanner.dirty.size,'real filesystem watcher observed edit');
+ const changed=await scanner.scan(owner,roots,cursors);assert.equal(changed.mode,'incremental');assert.equal(changed.scanned,1);
+ await writeFile(path.join(root,'new.jsonl'),row(3));scanner.dirty.clear();now+=31000;assert.equal((await scanner.scan(owner,roots,cursors)).discovered,2,'periodic scan recovers a missed watcher event');
+ await rm(file);for(let i=0;i<100&&!scanner.dirty.size;i++)await delay(10);const missing=await scanner.scan(owner,roots,cursors);assert.equal(missing.incomplete,true);assert.equal(missing.partial,true);
+});
+
+test('cached discovery cannot follow a file replaced with a foreign symlink',async t=>{
+ const {dir,root,roots}=await fixture(t),file=path.join(root,'one.jsonl'),foreign=path.join(dir,'private.jsonl');await writeFile(file,Array.from({length:300},(_,i)=>row(i)).join(''));await writeFile(foreign,row(0,'NEVER UPLOAD'));
+ const uploads=[],sync=new CanonicalSync({dir,accountClient:{request:async(_,body)=>{uploads.push(body);return {id:body.sourceKey};}}},{budget:1,scanIntervalMs:30000});t.after(()=>sync.close());
