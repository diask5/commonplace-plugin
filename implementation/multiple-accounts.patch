diff --git a/apps/commonplace/server/account-profile-tools.mjs b/apps/commonplace/server/account-profile-tools.mjs
new file mode 100644
index 0000000..7a550db
--- /dev/null
+++ b/apps/commonplace/server/account-profile-tools.mjs
@@ -0,0 +1,54 @@
+import {AccountProfiles,nativeAliases} from './account-profiles.mjs';
+import {createLocalClient} from './local-client.mjs';
+const tool=(name,description,properties={},required=[],readOnly=false)=>({name,description,inputSchema:{type:'object',properties,required,additionalProperties:false},annotations:{readOnlyHint:readOnly,destructiveHint:false,openWorldHint:true}});
+export const accountProfileTools=[
+ tool('list_linked_accounts','Show this installation’s linked Google accounts and this chat’s active account. Does not sign in, merge accounts or enable uploads.',{},[],true),
+ tool('link_account','Only when the owner asks, link another Google account without disconnecting existing accounts. Supply its exact email. Reuses that email’s pending sign-in. Google verification still requires the owner; host approvals still apply.',{email:{type:'string',maxLength:254}},['email']),
+ tool('use_account','Choose a verified linked account for this native chat before using its context or messaging. Once used, a chat stays on that account; choose another in a new chat. Does not merge accounts or transfer earlier history. syncHistory=true requires explicit owner consent to upload this whole chat to the selected account, including existing turns; otherwise capture is paused.',{profileId:{type:'string'},syncHistory:{type:'boolean'}},['profileId']),
+ tool('set_chat_account_sync','Only on explicit owner instruction, allow or pause private upload and on-demand history access for this whole chat in its selected account. Enabling includes existing visible turns. This does not share with other people or enable upload of other chats; account-wide sync and exclusions still apply.',{enabled:{type:'boolean'}},['enabled'])
+];
+export const accountProfileNames=new Set(accountProfileTools.map(t=>t.name));
+export function createAccountProfileTools({root,session,env,nativeId,selectClient,scoped,makeClient=createLocalClient}){
+ const profiles=new AccountProfiles(root);
+ const refresh=async id=>{
+  const client=makeClient({dir:profiles.dir(id)}),result=await client.request('api/account/connect',{automatic:true,open:false},{timeoutMs:35000});
+  await profiles.verified(id,result);return result;
+ };
+ return async(name,args={})=>{
+  if(await scoped())throw Error('Choose accounts in a personal chat. Existing workspace and shared conversation scopes stay unchanged.');
+  if(session.verified!==true)throw Error('Use a verified native chat to manage linked accounts.');
+  const spec=accountProfileTools.find(t=>t.name===name);if(!spec||Object.keys(args).some(k=>!Object.hasOwn(spec.inputSchema.properties,k)))throw Error('Unknown account argument.');
+  if(name==='list_linked_accounts'){
+   const s=await profiles.read(),selected=await profiles.selection(session),accounts=[];
+   for(const [id,p] of Object.entries(s.profiles)){
+    let status='unavailable';try{status=(await refresh(id)).connected?'connected':'sign-in-required';}catch{}
+    const current=(await profiles.read()).profiles[id];accounts.push({profileId:id,email:current.email||p.expectedEmail||null,status,active:id===selected.profileId});
+   }
+   return {accounts,activeProfileId:selected.profileId,chatSyncEnabled:selected.sync,accountPinned:selected.used,verification:'live status where available'};
+  }
+  if(name==='link_account'){
+   // Refresh the legacy profile before matching email; no account is replaced.
+   await refresh('default');
+   const id=await profiles.add(args.email),client=makeClient({dir:profiles.dir(id)});
+   const result=await client.request('api/account/connect',{open:true},{timeoutMs:35000});
+   await profiles.verified(id,result);
+   return {...result,profileId:id,activeProfileId:(await profiles.selection(session)).profileId,accountSelected:false};
+  }
+  if(name==='use_account'){
+   if(args.syncHistory!==undefined&&typeof args.syncHistory!=='boolean')throw Error('syncHistory must be true or false.');
+   // Live verification precedes local routing. An expired/revoked connection
+   // never silently falls back to another account.
+   await refresh('default');
+   if(args.profileId!=='default')await refresh(args.profileId);
+   const selected=await profiles.select(session,args.profileId,{aliases:nativeAliases(env,session.provider,nativeId()),syncHistory:args.syncHistory});
+   await selectClient(makeClient({dir:profiles.dir(args.profileId)}));
+   return {activeProfileId:selected.profileId,email:(await profiles.read()).profiles[selected.profileId].email,chatSyncEnabled:selected.sync,accountPinned:selected.used,historyTransferred:false,next:selected.sync?'Account-wide sync and exclusions still apply.':'This chat’s capture is paused. Other chats keep their existing account and sync settings.'};
+  }
+  if(name==='set_chat_account_sync'){
+   await refresh('default');
+   await profiles.pin(session,{aliases:nativeAliases(env,session.provider,nativeId())});
+   const selected=await profiles.sync(session,args.enabled);
+   return {activeProfileId:selected.profileId,chatSyncEnabled:selected.sync,includesExistingTurns:selected.sync,accountWideSyncUnchanged:true};
+  }
+ };
+}
diff --git a/apps/commonplace/server/account-profiles.mjs b/apps/commonplace/server/account-profiles.mjs
new file mode 100644
index 0000000..01206c1
--- /dev/null
+++ b/apps/commonplace/server/account-profiles.mjs
@@ -0,0 +1,97 @@
+import {configuredAccountOrigin} from './connect-account.mjs';
+import {mkdir,readFile,writeFile,rename,unlink} from 'node:fs/promises';
+import path from 'node:path';
+import {randomBytes} from 'node:crypto';
+import {setTimeout as delay} from 'node:timers/promises';
+import {acquireProcessLock} from './process-lock.mjs';
+
+const validId=id=>id==='default'||typeof id==='string'&&/^[a-f0-9]{24}$/.test(id);
+const uuid=id=>typeof id==='string'&&/^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$/i.test(id);
+const read=async file=>{try{return JSON.parse(await readFile(file,'utf8'));}catch(e){if(e.code==='ENOENT')return null;throw e;}};
+const save=async(file,value)=>{const temp=file+'.'+randomBytes(6).toString('hex')+'.tmp';try{await writeFile(temp,JSON.stringify(value),{flag:'wx',mode:0o600});await rename(temp,file);}finally{await unlink(temp).catch(()=>{});}};
+export async function profileLocation(dir){
+ dir=path.resolve(dir);const marker=await read(path.join(dir,'account-profile.json'));
+ if(!marker)return {root:dir,id:'default'};
+ if(!validId(marker.id)||marker.id==='default'||!path.isAbsolute(marker.root)||path.join(marker.root,'accounts',marker.id)!==dir)throw Error('Invalid account profile.');
+ return {root:marker.root,id:marker.id,...(marker.origin?{origin:configuredAccountOrigin(marker.origin)}:{})};
+}
+export class AccountProfiles{
+ constructor(root){this.root=path.resolve(root);}
+ dir(id){if(!validId(id))throw Error('Unknown linked account.');return id==='default'?this.root:path.join(this.root,'accounts',id);}
+ async read(){const s=await read(path.join(this.root,'linked-accounts.json'));if(!s)return {version:1,profiles:{default:{}},chats:{}};if(s.version!==1||!s.profiles?.default||!s.chats)throw Error('Invalid linked account registry.');return s;}
+ async locked(fn){
+  await mkdir(this.root,{recursive:true,mode:0o700});const lock=path.join(this.root,'linked-accounts.lock');let owned=false;
+  for(let i=0;i<200&&!owned;i++){owned=await acquireProcessLock(lock);if(!owned)await delay(25);}
+  if(!owned)throw Error('Account routing is busy. Retry after current work finishes.');
+  try{return await fn(await this.read(),s=>save(path.join(this.root,'linked-accounts.json'),s));}finally{await unlink(lock);}
+ }
+ async add(email){
+  if(typeof email!=='string'||email.length>254||!/^\S+@[^\s@]+\.[^\s@]+$/.test(email))throw Error('Choose the Google account email to link.');email=email.toLowerCase();
+  return this.locked(async(s,commit)=>{
+   const found=Object.entries(s.profiles).find(([,p])=>p.email===email||p.expectedEmail===email);if(found)return found[0];
+   if(Object.keys(s.profiles).length>=8)throw Error('This installation already has eight account profiles.');
+   const id=randomBytes(12).toString('hex'),dir=this.dir(id);await mkdir(dir,{recursive:true,mode:0o700});
+   const primary=await read(path.join(this.root,'account-client.json'));
+   const origin=configuredAccountOrigin(primary?.session?.origin||process.env.COMMONPLACE_ACCOUNT_ORIGIN);
+   await save(path.join(dir,'account-profile.json'),{root:this.root,id,origin});s.profiles[id]={expectedEmail:email};await commit(s);return id;
+  });
+ }
+ async verified(id,result){
+  return this.locked(async(s,commit)=>{
+   const p=s.profiles[id];if(!p)throw Error('Unknown linked account.');
+   if(!result.connected||!result.account?.id||!result.account?.email){p.verified=false;await commit(s);return false;}
+   const email=result.account.email.toLowerCase();
+   if(p.expectedEmail&&email!==p.expectedEmail){p.verified=false;await commit(s);throw Error('The browser signed in to a different Google account. This profile was not selected.');}
+   if(p.ownerId&&p.ownerId!==result.account.id)throw Error('The linked account identity changed. Preserve the existing profile.');
+   Object.assign(p,{ownerId:result.account.id,email,verified:true});await commit(s);return true;
+  });
+ }
+ async selection(session,fallback='default'){return (await this.read()).chats[session.sessionId]||{profileId:fallback,sync:fallback==='default',used:false};}
+ async select(session,id,{aliases=[],syncHistory=false}={}){
+  if(session.verified!==true||!/^[a-f0-9]{24}$/.test(session.sessionId||''))throw Error('Use a verified native chat to choose an account.');
+  return this.locked(async(s,commit)=>{
+   if(!validId(id)||!s.profiles[id]?.verified)throw Error('Finish Google sign-in for this account first.');
+   const old=s.chats[session.sessionId];
+   if(old?.used&&old.profileId!==id)throw Error('This chat is already using another account. Choose the other account in a new chat to keep its context and pending replies separate.');
+   const safeAliases=aliases.filter(a=>/^(claude|codex|conductor):[a-f0-9-]{36}$/.test(a));
+   const conflicting=Object.entries(s.chats).some(([key,value])=>key!==session.sessionId&&value.aliases?.some(a=>safeAliases.includes(a))&&value.profileId!==id);
+   if(conflicting)throw Error('This native chat already has another account binding.');
+   s.chats[session.sessionId]={profileId:id,sync:syncHistory===true,used:old?.used===true,aliases:[...new Set([...(old?.aliases||[]),...safeAliases])]};
+   await commit(s);return s.chats[session.sessionId];
+  });
+ }
+ async pin(session,{aliases=[],profileId}={}){
+  if(!session.verified)return;
+  return this.locked(async(s,commit)=>{const previous=s.chats[session.sessionId];if(previous&&profileId&&previous.profileId!==profileId)throw Error('The chat account selection changed. Reconnect this chat before using its context.');const selected=profileId||'default',p=previous||{profileId:selected,sync:selected==='default',aliases};p.used=true;s.chats[session.sessionId]=p;await commit(s);return p;});
+ }
+ async sync(session,enabled){
+  if(session.verified!==true||typeof enabled!=='boolean')throw Error('Choose whether this verified chat may be synced.');
+  return this.locked(async(s,commit)=>{const p=s.chats[session.sessionId];if(!p)throw Error('Select this chat account first.');p.sync=enabled;await commit(s);return p;});
+ }
+}
+export function nativeAliases(env,provider,nativeId){return [...(uuid(nativeId)?[provider.toLowerCase()+':'+nativeId.toLowerCase()]:[]),...(uuid(env.CONDUCTOR_SESSION_ID)?['conductor:'+env.CONDUCTOR_SESSION_ID.toLowerCase()]:[])];}
+export async function profilesFor(dir){const p=await profileLocation(dir);return {profiles:new AccountProfiles(p.root),id:p.id};}
+function assignment(state,conversation){
+ const keys=new Set();const provider=String(conversation.nativeProvider||conversation.provider||'').toLowerCase();
+ const native=conversation.nativeId||conversation.id?.split(':subagent:')[0];
+ if(uuid(native))keys.add(provider+':'+native.toLowerCase());
+ if(conversation.provider==='conductor'&&uuid(conversation.id))keys.add('conductor:'+conversation.id.toLowerCase());
+ const matches=Object.values(state.chats).filter(p=>p.aliases?.some(k=>keys.has(k)));
+ if(matches.some(p=>p.profileId!==matches[0]?.profileId||p.sync!==matches[0]?.sync))return {sync:false};
+ return matches[0];
+}
+export async function withAccountContext(dir,conversation,fn,{ownerId}={}){
+ const {profiles,id}=await profilesFor(dir);
+ return profiles.locked(async state=>{
+  const p=assignment(state,conversation),account=state.profiles[id];
+  if(Object.keys(state.profiles).length>1&&!uuid(conversation.nativeId||conversation.id?.split(':subagent:')[0]))return {accountWithheld:true};
+  if(id!=='default'&&(!account?.verified||ownerId&&account.ownerId!==ownerId))return {accountWithheld:true};
+  if(p?(!p.sync||p.profileId!==id):id!=='default')return {accountWithheld:true};
+  return fn();
+ });
+}
+export async function accountChatAllowed(dir,session,{history=false}={}){
+ const {profiles,id}=await profilesFor(dir),p=(await profiles.read()).chats[session.sessionId];
+ return (p?.profileId||id)===id&&(!history||(p?.sync??id==='default'));
+}
+export async function routedAccountDir(dir,session){const {profiles,id}=await profilesFor(dir);return profiles.dir((await profiles.selection(session,id)).profileId);}
