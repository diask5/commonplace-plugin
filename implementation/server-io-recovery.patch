diff --git a/tests/agent-auth-rate-storage.test.mjs b/tests/agent-auth-rate-storage.test.mjs
new file mode 100644
index 0000000..4c42ebb
--- /dev/null
+++ b/tests/agent-auth-rate-storage.test.mjs
@@ -0,0 +1,125 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { createRateCounters, createAgentAuth } from '../apps/commonplace-account/server/agent-auth.mjs';
+import { signedFixture } from './signed-fixture.mjs';
+
+const at = (t, start) => {
+  let now = start;
+  t.mock.method(Date, 'now', () => now);
+  return (ms) => (now += ms);
+};
+
+test('fixed-window threshold and TTL expiry', (t) => {
+  const tick = at(t, 1_000_000);
+  const c = createRateCounters(10);
+  assert.deepEqual([1, 2, 3].map(() => c.increment('a', 60)), [1, 2, 3]);
+  tick(30_000); // fixed window: later hits do not extend it
+  assert.equal(c.increment('a', 60), 4);
+  tick(30_000);
+  assert.equal(c.increment('a', 60), 1);
+  assert.equal(c.increment('b', 60), 1);
+});
+
+test('concurrent increments are exact', async (t) => {
+  at(t, 5_000);
+  const c = createRateCounters(10);
+  const results = await Promise.all(Array.from({ length: 500 }, async () => c.increment('k', 60)));
+  assert.deepEqual([...results].sort((x, y) => x - y), Array.from({ length: 500 }, (_, i) => i + 1));
+});
+
+test('memory is bounded, reclaims expired keys and never evicts an active counter', (t) => {
+  const tick = at(t, 9_000_000);
+  const c = createRateCounters(100);
+  for (let i = 0; i < 100; i++) assert.equal(c.increment('k' + i, 60), 1);
+  assert.equal(c.increment('k0', 60), 2);
+  for (let i = 0; i < 10_000; i++) assert.equal(c.increment('attacker' + i, 60), Infinity);
+  assert.equal(c.size, 100);
+  assert.equal(c.increment('k0', 60), 3); // active counter intact
+  tick(61_000);
+  assert.equal(c.increment('fresh', 60), 1);
+  assert.equal(c.size, 1);
+});
+
+test('SDK increment is wired to memory and writes nothing durable', async (t) => {
+  const f = await signedFixture(t);
+  const auth = createAgentAuth(f.service);
+  const sql = f.service.db.sqlite;
+  const count = () => sql.prepare('SELECT COUNT(*) n FROM cp_agent_auth_store').get().n;
+  const before = count();
+  const inc = auth.options.secondaryStorage.increment;
+  assert.deepEqual([await inc('1.2.3.4|/x', 60), await inc('1.2.3.4|/x', 60)], [1, 2]);
+  assert.equal(count(), before);
+});
+
+test('signed request replay is still denied; one fewer WAL commit; durable quota unchanged', async (t) => {
+  const f = await signedFixture(t);
+  const p = await f.fresh('A', 'Claude');
+  const link = await p.client.request('/account/api/identity/start', {});
+  const owner = await f.service.profile({ userId: 'firebase:rate1', email: 'r1@example.test' });
+  f.service.mailboxes.approveLink(owner, new URL(link.authorizationUrl).hash.slice(1));
+  await p.call('discover_agents');
+
+  const db = f.service.db.sqlite;
+  const file = db.prepare('PRAGMA database_list').all().find((r) => r.name === 'main').file;
+  db.exec('PRAGMA wal_autocheckpoint=0');
+  const commits = () => {
+    const b = readFileSync(file + '-wal');
+    const ps = b.readUInt32BE(8);
+    let n = 0;
+    for (let o = 32; o + 24 + ps <= b.length; o += 24 + ps) if (b.readUInt32BE(o + 4) !== 0) n++;
+    return n;
+  };
+
+  // Capture the real signed execute request at the Agent Auth handler, then
+  // replay it byte-for-byte through the same handler.
+  const agent = createAgentAuth(f.service);
+  const handle = agent.handle;
+  let captured;
+  agent.handle = async (request) => {
+    if (!captured && request.url.includes('/capability/execute'))
+      captured = { url: request.url, headers: [...request.headers], body: await request.clone().text() };
+    return handle.call(agent, request);
+  };
+  t.after(() => { agent.handle = handle; });
+  const quota = () => sql_quota(db);
+  const sql_quota = (d) => d.prepare('SELECT COALESCE(SUM(count),0) n FROM cp_limits').get().n;
+  const measure = async () => {
+    const c0 = commits(), q0 = quota();
+    await p.call('discover_agents');
+    return { commits: commits() - c0, quota: quota() - q0 };
+  };
+  let after, before;
+  try {
+    after = await measure();
+    // A/B: the pre-change durable increment, same statement as before.
+    const storage = agent.options.secondaryStorage, memory = storage.increment;
+    storage.increment = async (key, ttl) => {
+      const now = Date.now();
+      return Number(db.prepare("INSERT INTO cp_agent_auth_store(key,value,expires) VALUES(?,'1',?) ON CONFLICT(key) DO UPDATE SET value=CASE WHEN expires<=? THEN '1' ELSE CAST(value AS INTEGER)+1 END, expires=CASE WHEN expires<=? THEN excluded.expires ELSE expires END RETURNING value").get('sdk:' + key, now + ttl * 1000, now, now).value);
+    };
+    try { before = await measure(); } finally { storage.increment = memory; }
+  } finally {
+    agent.handle = handle;
+  }
+  const perCall = after.commits;
+  assert.ok(captured, 'captured a signed execute request');
+  const replay = await handle.call(agent, new Request(captured.url, { method: 'POST', headers: captured.headers, body: captured.body }));
+  assert.ok([400, 401, 403, 409].includes(replay.status), 'replay rejected: ' + replay.status + ' ' + (await replay.text()));
+  console.log(`wal commits per tool call: memory=${after.commits} durable-increment=${before.commits}; cp_limits delta: ${after.quota} vs ${before.quota}`);
+  assert.equal(before.commits - after.commits, 1 * 2, 'one fewer commit per authenticated request (2 requests per tool call)');
+  assert.equal(after.quota, before.quota, 'durable device quota counted identically');
+  assert.ok(after.quota >= 1);
+});
+
+
+test('the actual SDK returns 429 at the fixed-window threshold', async t => {
+  const f=await signedFixture(t),auth=createAgentAuth(f.service);
+  auth.options.rateLimit.customRules['/agent-configuration']={window:60,max:2};
+  const statuses=[];
+  for(let i=0;i<3;i++){
+    const response=await auth.handle(new Request(f.service.origin+'/.well-known/agent-configuration'));
+    statuses.push(response.status);await response.text();
+  }
+  assert.deepEqual(statuses,[200,200,429]);
+});
