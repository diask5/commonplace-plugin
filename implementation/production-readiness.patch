new file mode 100644
--- /dev/null
+++ b/scripts/build-runtime-dependencies.py
@@ -0,0 +1,56 @@
+#!/usr/bin/env python3
+"""Package an npm-ci production tree for isolated account-runtime dependencies.
+
+Prepare with npm ci --omit=dev --ignore-scripts in a dedicated directory. This
+archive does not replace dependencies used by the preserved compiled website.
+"""
+import argparse
+import hashlib
+import json
+import tarfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def build(directory, output):
+    for name in ['package.json', 'package-lock.json']:
+        if (directory / name).read_bytes() != (ROOT / name).read_bytes():
+            raise ValueError('Dependency inputs differ from the frozen source: ' + name)
+    if not (directory / 'node_modules').is_dir():
+        raise ValueError('Run npm ci --omit=dev --ignore-scripts first.')
+    output.parent.mkdir(parents=True, exist_ok=True)
+    files = {}
+    with tarfile.open(output, 'w:gz') as archive:
+        inputs = [directory / 'package.json', directory / 'package-lock.json']
+        inputs += sorted((directory / 'node_modules').rglob('*'))
+        for source in inputs:
+            relative = source.relative_to(directory)
+            # CLI entry-point symlinks are not needed by server imports.
+            if '.bin' in relative.parts:
+                continue
+            if source.is_symlink():
+                raise ValueError('Unexpected dependency symlink: ' + str(relative))
+            if not source.is_file():
+                continue
+            files[str(relative)] = hashlib.sha256(source.read_bytes()).hexdigest()
+            info = archive.gettarinfo(str(source), arcname=str(relative))
+            info.uid = info.gid = info.mtime = 0
+            info.uname = info.gname = ''
+            info.mode = 0o644
+            with source.open('rb') as stream:
+                archive.addfile(info, stream)
+    manifest = {'archive': output.name, 'sha256': hashlib.sha256(output.read_bytes()).hexdigest(),
+                'lockSha256': files['package-lock.json'], 'files': files}
+    output.with_suffix('.manifest.json').write_text(json.dumps(manifest, indent=2) + '\n')
+    output.with_suffix('.sha256').write_text(manifest['sha256'] + '  ' + output.name + '\n')
+    return manifest
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--directory', required=True, type=Path)
+    parser.add_argument('--output', required=True, type=Path)
+    args = parser.parse_args()
+    result = build(args.directory, args.output)
+    print(json.dumps({key: value for key, value in result.items() if key != 'files'}))
