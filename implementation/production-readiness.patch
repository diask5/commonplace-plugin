+ assert.equal(response.status,200);
+ const tokens=await response.json(),headers={authorization:'Bearer '+tokens.access_token,accept:'application/json, text/event-stream'};
+ const rpc=async(method,params={})=>{
+  const response=await call('/mcp','POST',{jsonrpc:'2.0',id:1,method,params},headers);
+  assert.equal(response.status,200);return response.json();
+ };
+ assert.ok((await rpc('tools/list')).result.tools.some(tool=>tool.name==='archive_read'));
+ assert.ok((await rpc('resources/list')).result.resources.some(resource=>resource.uri==='meetproxy://context/index'));
+ const resource=await rpc('resources/read',{uri:'meetproxy://context/index'});
+ assert.ok(resource.result.contents.length);
+ const denied=await rpc('tools/call',{name:'run_cloud_task',arguments:{prompt:'Read-only must not write',nonce:randomBytes(12).toString('hex')}});
+ assert.equal(denied.result.isError,true);
+ assert.equal((await call('/mcp','POST',{jsonrpc:'2.0',id:1,method:'tools/list'},{...headers,origin:'https://foreign.example'})).status,403);
