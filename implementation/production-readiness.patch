+ const redirect_uri=origin+'/demo-callback',verifier=randomBytes(32).toString('base64url');
+ const registration=await call('/oauth/register','POST',{client_name:'Release verification demo',redirect_uris:[redirect_uri]});assert.equal(registration.status,201);
+ const client=await registration.json();
+ const flow=await service.beginAuthorization({id:identity.id},{client_id:client.client_id,redirect_uri,response_type:'code',state:'release-demo',code_challenge:createHash('sha256').update(verifier).digest('base64url'),code_challenge_method:'S256',resource:service.resource,scope:'commonplace:read'});
+ const approval=new URL(await service.approve({id:identity.id},{flowId:flow.id,csrf:flow.csrf,consent:'allow'},flow.cookie,origin));
