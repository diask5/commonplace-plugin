+    def dependency_archive(self, entries=None):
+        filename = self.root / 'dependencies.tgz'
+        entries = entries or [('package.json', b'{}'), ('package-lock.json', b'{}'),
+                              ('node_modules/example/index.mjs', b'export default 42;')]
+        with tarfile.open(filename, 'w:gz') as archive:
+            for name, body in entries:
+                info = tarfile.TarInfo(name)
+                if body is None:
+                    info.type = tarfile.SYMTYPE
+                    info.linkname = '/etc'
+                    archive.addfile(info)
+                else:
+                    info.size = len(body)
+                    archive.addfile(info, io.BytesIO(body))
+        return filename, hashlib.sha256(filename.read_bytes()).hexdigest()
+
+    def test_dependency_archive_rejects_checksum_paths_links_and_duplicates(self):
+        archive, digest = self.dependency_archive()
+        with self.assertRaisesRegex(ValueError, 'checksum'):
+            deploy.verify_dependencies(archive, '0' * 64)
+        for name, body in [('../escape', b'x'), ('/escape', b'x'), ('node_modules/../escape', b'x'),
+                           ('node_modules/link', None), ('node_modules//example', b'x'), ('unexpected', b'x')]:
+            archive, digest = self.dependency_archive([(name, body)])
+            with self.assertRaisesRegex(ValueError, 'Unsafe'):
+                deploy.verify_dependencies(archive, digest)
+        archive, digest = self.dependency_archive([('package.json', b'1'), ('package.json', b'2')])
+        with self.assertRaisesRegex(ValueError, 'Unsafe'):
+            deploy.verify_dependencies(archive, digest)
+
+    def test_dependencies_are_isolated_from_previous_release(self):
+        archive, digest = self.dependency_archive()
+        deploy.verify_dependencies(archive, digest)
+        shared = self.root / 'previous-dependencies'
+        shared.mkdir()
+        (shared / 'keep').write_text('original')
+        runtime = self.root / 'candidate-runtime'
+        runtime.mkdir()
+        (runtime / 'node_modules').symlink_to(shared)
+        original = self.root / 'original-package.json'
+        original.write_text('original package')
+        os.link(original, runtime / 'package.json')
+        deploy.install_dependencies(archive, runtime)
+        self.assertFalse((runtime / 'node_modules').is_symlink())
+        self.assertEqual((shared / 'keep').read_text(), 'original')
+        self.assertEqual(original.read_text(), 'original package')
+        self.assertEqual((runtime / 'node_modules/example/index.mjs').read_text(), 'export default 42;')
+
+    def test_prepare_rehearses_without_switching_pointer_or_services(self):
+        previous, current, database, bundle = self.code_only_fixture()
+        archive, digest = self.dependency_archive()
+        before = database.read_bytes()
+        commands = []
+        def vm_path(value):
+            value = str(value)
+            return self.root / value.lstrip('/') if value.startswith(('/opt/', '/var/')) else Path(value)
+        def run(command, **kwargs):
+            commands.append(command)
+            return subprocess.CompletedProcess(command, 0)
+        with patch.object(deploy, 'Path', vm_path), patch.object(deploy.subprocess, 'run', run), \
+             patch('sys.argv', ['deploy', '--bundle', str(bundle), '--baseline', previous.name,
+                                '--release', '20261020-prepared', '--prepare-only',
+                                '--dependencies', str(archive), '--dependencies-sha256', digest,
+                                '--bundle-sha256', hashlib.sha256(bundle.read_bytes()).hexdigest()]):
+            deploy.main()
+        self.assertEqual(current.resolve(), previous)
+        self.assertEqual(database.read_bytes(), before)
+        self.assertEqual(len(commands), 1)
+        self.assertEqual(commands[0][0], '/opt/node/bin/node')
+        self.assertIn('connection-entry.mjs', commands[0][-1])
+        evidence = json.loads((database.parent / 'rollouts/20261020-prepared/prepared.json').read_text())
+        self.assertFalse(evidence['activated'])
+        self.assertEqual(evidence['dependenciesSha256'], digest)
+        self.assertEqual(evidence['migrations'], 'rehearsed')
+
 
