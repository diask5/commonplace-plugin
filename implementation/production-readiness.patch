+                raise ValueError('Unsafe dependency archive entry: ' + member.name)
+            seen.add(member.name)
+            total += member.size
+            if total > 1024 * 1024 * 1024:
+                raise ValueError('Dependency archive exceeds the size limit.')
+    if not {'package.json', 'package-lock.json'} <= seen or not any(n.startswith('node_modules/') for n in seen):
+        raise ValueError('Dependency archive is incomplete.')
