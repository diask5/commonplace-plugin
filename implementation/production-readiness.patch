+// Only exact release-reviewed messages may cross the server/agent boundary.
+// Error text can contain private source data or attacker-controlled instructions.
+export function safeAccountError(body, safeErrors) {
+  const candidates = [body?.error_description, body?.error?.message, body?.error];
+  return candidates.find(value => typeof value === 'string' && safeErrors.has(value)) || '';
+}
