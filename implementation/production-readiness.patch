+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {randomBytes,createHash} from 'node:crypto';
+import {withConnectionRoutes} from '../apps/commonplace-account/server/connection-entry.mjs';
+import {startUiPreview} from '../scripts/preview-ui.mjs';
+const uid=()=>randomBytes(12).toString('hex');
+
+test('real production wrapper with a stub compiled fallback serves current discovery, OAuth, MCP and restricted Agent Auth',async t=>{
+ const p=await startUiPreview();t.after(()=>p.close());p.service.origin=p.origin;p.service.resource=p.origin+'/mcp';
+ let fallback=0;const entry=withConnectionRoutes(()=>{fallback++;return new Response('compiled legacy app',{status:599});},{runtime:()=>p.service});
+ const call=(route,method='GET',body,headers={})=>entry(new Request(p.origin+route,{method,headers:{...(body?{'content-type':'application/json'}:{}),...headers},...(body?{body:JSON.stringify(body)}:{})}));
+ for(const route of ['/.well-known/oauth-authorization-server','/.well-known/oauth-protected-resource','/.well-known/oauth-protected-resource/mcp','/.well-known/agent-configuration','/api/agent-auth/agent-configuration'])assert.equal((await call(route)).status,200,route);
+ const metadata=await (await call('/.well-known/oauth-protected-resource/mcp')).json();assert.equal(metadata.resource,p.origin+'/mcp');
+ assert.equal((await call('/api/agent-auth/sign-in/email','POST',{})).status,404);
+ assert.equal((await call('/api/agent-auth/agent/register','POST',{})).status,400);
+ assert.equal((await call('/account/api/mailbox/connection-read','POST',{})).status,401);
+ const unauthorized=await call('/mcp','POST',{jsonrpc:'2.0',id:1,method:'tools/list'});assert.equal(unauthorized.status,401);assert.match(unauthorized.headers.get('www-authenticate'),/oauth-protected-resource\/mcp/);
+ assert.equal((await call('/mcp','OPTIONS')).status,204);
+ const redirect_uri='http://127.0.0.1:14567/callback';
+ const registration=await call('/oauth/register','POST',{client_name:'Production wrapper contract',redirect_uris:[redirect_uri]});assert.equal(registration.status,201);
+ const client=await registration.json(),verifier=randomBytes(32).toString('base64url');
+ const flow=await p.service.beginAuthorization({id:p.people.ready.owner},{client_id:client.client_id,redirect_uri,response_type:'code',state:'opaque-state',code_challenge:createHash('sha256').update(verifier).digest('base64url'),code_challenge_method:'S256',resource:p.service.resource,scope:'commonplace:read'});
+ const approval=new URL(await p.service.approve({id:p.people.ready.owner},{flowId:flow.id,csrf:flow.csrf,consent:'allow'},flow.cookie,p.origin));
+ const tokenResponse=await entry(new Request(p.origin+'/oauth/token',{method:'POST',headers:{'content-type':'application/x-www-form-urlencoded'},body:new URLSearchParams({grant_type:'authorization_code',client_id:client.client_id,redirect_uri,resource:p.service.resource,code:approval.searchParams.get('code'),code_verifier:verifier})}));assert.equal(tokenResponse.status,200);
+ const tokens=await tokenResponse.json(),headers={authorization:'Bearer '+tokens.access_token,accept:'application/json, text/event-stream'};
+ const rpc=(method,params={})=>call('/mcp','POST',{jsonrpc:'2.0',id:uid(),method,params},headers);
+ const listed=await (await rpc('tools/list')).json();assert.ok(listed.result.tools.find(t=>t.name==='archive_read'));
+ assert.ok((await (await rpc('resources/list')).json()).result.resources.find(r=>r.uri==='meetproxy://context/index'));
+ const denied=await (await rpc('tools/call',{name:'run_cloud_task',arguments:{prompt:'Read-only token must not create work',nonce:uid()}})).json();assert.equal(denied.result.isError,true);
+ const malicious=await call('/mcp','POST',{jsonrpc:'2.0',id:1,method:'tools/list'}, {...headers,origin:'https://evil.test'});assert.equal(malicious.status,403);
+ assert.equal(fallback,0);
+ assert.equal((await call('/workspaces/existing')).status,599);assert.equal(fallback,1);
+});
