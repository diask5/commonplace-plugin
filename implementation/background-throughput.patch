+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {randomBytes} from 'node:crypto';
+import {mkdtemp,rm} from 'node:fs/promises';
+import {readFileSync} from 'node:fs';
+import {tmpdir} from 'node:os';
+import path from 'node:path';
+import {fileURLToPath} from 'node:url';
+import {AccountService} from '../server/service.mjs';
+import {openDatabase} from '../server/sqlite.mjs';
+import {database,identity,origin,registerDevice} from './helpers.mjs';
+
+const id=()=>randomBytes(12).toString('hex');
+async function fixture(t,{persistent=false}={}){
+ let db;
+ if(persistent){
+  const dir=await mkdtemp(path.join(tmpdir(),'inbox-batch-'));
+  db=openDatabase(path.join(dir,'account.sqlite'),{migrations:fileURLToPath(new URL('../drizzle/',import.meta.url))});
+  // Only this disposable fixture: retain WAL frames for exact commit counting.
+  db.sqlite.exec('PRAGMA wal_autocheckpoint=0');
+  t.after(async()=>{db.close();await rm(dir,{recursive:true,force:true});});
+ }else db=await database(t);
+ const s=new AccountService(db,origin),sql=db.sqlite;
+ const a={id:id(),owner:(await s.profile(identity('batch-sender'))).id};
+ const b={id:id(),owner:(await s.profile(identity('batch-receiver'))).id};
+ const stranger={id:id(),owner:(await s.profile(identity('batch-stranger'))).id};
+ for(const d of [a,b,stranger])await registerDevice(s,d);
+ const invite=await s.invite(a.owner,'Receiver');await s.connect(b.owner,invite.code);
+ const aa={sessionId:id(),provider:'Codex',host:'conductor',delivery:'native',label:'Sender'};
+ const bb={...aa,sessionId:id(),label:'Receiver'};
+ await s.personInbox.register(b,bb);
+ const room=await s.personInbox.open(a,{...aa,personId:b.owner});
+ await s.personInbox.takeover(b,{...bb,linkId:room.linkId});
+ const question=await s.personInbox.send(a,{...aa,linkId:room.linkId,kind:'question',text:'Synthetic question',nonce:id()});
+ const event=(await s.personInbox.poll(b,bb)).events.find(e=>e.id===question.id);
+ assert.ok(event);
+ let now=Date.now()+1000;t.mock.method(Date,'now',()=>now);
+ const tick=()=>now+=1000;
+ const me=s.personInbox.identity(b,bb);
+ const state=()=>({session:sql.prepare('SELECT * FROM cp_inbox_sessions WHERE id=?').get(me),route:sql.prepare('SELECT * FROM cp_inbox_routes WHERE link=? AND owner=?').get(room.linkId,b.owner),receipts:sql.prepare('SELECT * FROM cp_inbox_deliveries WHERE link=? ORDER BY id').all(room.linkId)});
