+});
+
+test('a later receipt failure rolls back all receipts, presence and route lease for a retry',async t=>{
+ const f=await fixture(t);
+ const second=await f.s.personInbox.send(f.a,{...f.aa,linkId:f.room.linkId,kind:'context',text:'Second synthetic update',nonce:id()});
+ const next=(await f.s.personInbox.poll(f.b,f.bb)).events.find(e=>e.id===second.id);
+ f.tick();const before=f.state();
+ f.sql.exec(`CREATE TRIGGER fail_receipt BEFORE UPDATE OF submitted_at ON cp_inbox_deliveries WHEN NEW.id='${next.receiptId}' BEGIN SELECT RAISE(ABORT,'synthetic receipt failure'); END`);
+ const input={...f.bb,label:'Failed poll',received:[f.event.receiptId],delivered:[f.event.receiptId,next.receiptId],receiptsOnly:true};
+ await assert.rejects(f.s.personInbox.poll(f.b,input),/synthetic receipt failure/);
+ assert.deepEqual(f.state(),before);
+ f.sql.exec('DROP TRIGGER fail_receipt');
+ assert.deepEqual((await f.s.personInbox.poll(f.b,input)).events,[]);
+ const saved=f.state();assert.equal(saved.session.label,'Failed poll');
+ assert.equal(saved.session.polled_at,before.session.polled_at,'receipt flush never claims polling activity');
+ assert.ok(saved.receipts.every(r=>r.submitted_at===Date.now()));
+ assert.equal((await f.s.personInbox.poll(f.b,f.bb)).events.length,0,'committed retry is not redelivered');
+});
+
+test('poll timestamp failure rolls back the complete bounded write phase before acknowledgment',async t=>{
+ const f=await fixture(t),before=f.state();
+ f.sql.exec("CREATE TRIGGER fail_poll BEFORE UPDATE OF polled_at ON cp_inbox_sessions BEGIN SELECT RAISE(ABORT,'synthetic poll failure'); END");
+ await assert.rejects(f.s.personInbox.poll(f.b,{...f.bb,received:[f.event.receiptId],delivered:[f.event.receiptId]}),/synthetic poll failure/);
+ assert.deepEqual(f.state(),before);
+ f.sql.exec('DROP TRIGGER fail_poll');
+ await f.s.personInbox.poll(f.b,{...f.bb,received:[f.event.receiptId],delivered:[f.event.receiptId]});
+ assert.equal(f.state().session.polled_at,Date.now());
+ assert.equal(f.state().receipts[0].submitted_at,Date.now());
+});
+
+test('receipt retries preserve first timestamps and do not update already recorded receipts',async t=>{
+ const f=await fixture(t),input={...f.bb,received:[f.event.receiptId],delivered:[f.event.receiptId],receiptsOnly:true};
+ await f.s.personInbox.poll(f.b,input);const saved=f.state().receipts;
+ f.sql.exec('CREATE TABLE receipt_updates(n INTEGER); INSERT INTO receipt_updates VALUES(0); CREATE TRIGGER count_receipt_updates AFTER UPDATE OF received_at,submitted_at ON cp_inbox_deliveries BEGIN UPDATE receipt_updates SET n=n+1; END');
+ f.tick();await f.s.personInbox.poll(f.b,input);
+ assert.deepEqual(f.state().receipts,saved);
+ assert.equal(f.sql.prepare('SELECT n FROM receipt_updates').get().n,0);
+});
+
+test('presence, lease and bounded receipts commit once per registration or poll',async t=>{
+ const f=await fixture(t,{persistent:true}),file=f.sql.prepare('PRAGMA database_list').all().find(r=>r.name==='main').file;
+ const commits=()=>{const b=readFileSync(file+'-wal'),ps=b.readUInt32BE(8);let n=0;for(let o=32;o+24+ps<=b.length;o+=24+ps)if(b.readUInt32BE(o+4)!==0)n++;return n;};
+ const results={};
+ const measure=async(name,work)=>{f.tick();const before=commits();await work();results[name]=commits()-before;};
+ await measure('registration',()=>f.s.personInbox.register(f.b,f.bb));
+ await measure('emptyPoll',()=>f.s.personInbox.poll(f.b,f.bb));
+ // Distinct messages and receipts, all in the current route generation.
+ const receipts=Array.from({length:100},()=>id());
+ const insert=f.sql.prepare('INSERT INTO cp_inbox_deliveries(id,link,owner,message,generation) VALUES(?,?,?,?,?)');
+ const sender=f.sql.prepare('SELECT sender FROM cp_chat_messages WHERE id=?').get(f.question.id).sender;
+ const message=f.sql.prepare("INSERT INTO cp_chat_messages(id,link,sender,kind,body,at) VALUES(?,?,?,'context','Synthetic batch update',?)");
+ f.sql.exec('BEGIN');for(const receipt of receipts){const key=id();message.run(key,f.room.linkId,sender,Date.now());insert.run(receipt,f.room.linkId,f.b.owner,key,f.event.generation);}f.sql.exec('COMMIT');
