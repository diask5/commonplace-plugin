+// A disposable UX walkthrough. No real sign-in, agents, or model execution.
+import {randomBytes} from 'node:crypto';
+import {startUiPreview} from './preview-ui.mjs';
+import {fileURLToPath} from 'node:url';
+const uid=()=>randomBytes(12).toString('hex');
+export async function startProductPreview({port=0,host='127.0.0.1',publicOrigin=null}={}){
+ let routes={};
+ const p=await startUiPreview({port,host,publicOrigin,handleDemoRequest:async(req,res,url)=>{
+  const path=url.pathname;
+  if(routes[path.slice(1)]){const [mode,target]=routes[path.slice(1)];res.writeHead(303,{'location':target,'set-cookie':'ui_demo='+mode+'; Path=/; SameSite=Lax'});res.end();return true;}
+  if(path==='/walkthrough'){res.writeHead(200,{'content-type':'text/html'});res.end(`<!doctype html><html lang="en"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Meet Proxy design walkthrough</title><style>body{max-width:640px;margin:70px auto;padding:24px;font:17px/1.7 system-ui;background:#faf9f6;color:#292725}h1{line-height:1.15}a{color:#a43b26}li{margin:18px 0}</style><h1>Meet Proxy<br>Product flow walkthrough</h1><p>Disposable sample accounts. Google sign-in and native agents are simulated. This preview does not connect your real account.</p><ol><li><a href="/signin">Sign in with Google</a></li><li><a href="/onboarding">Attach your agents</a></li><li><a href="/agents">Agents and their connections</a></li><li><a href="/invite">Accept Alex’s invitation as Taylor</a></li><li><a href="/inbox">Read both sides of a shared thread</a></li></ol><p>Invites and severing use real local application handlers. Changes last until this demo restarts.</p><script>sessionStorage.removeItem('meet-proxy-agent-invitation');</script><a href="https://meet-proxy-staging.34.27.253.220.nip.io/#agents">Real Google staging (earlier build)</a></html>`);return true;}
+  return false;
+ },decorateHtml:html=>html.replace('</style>','.demo-ribbon{position:fixed;bottom:8px;left:8px;z-index:30;background:#292725;color:#fff;padding:8px 12px;border-radius:9px;font:11px system-ui}.demo-ribbon a{color:#fff}</style>').replace('</body>','<aside class="demo-ribbon">Demo accounts · <a href="/walkthrough">Walkthrough</a></aside></body>')});
+ const mail=p.service.mailboxes;p.service.origin=p.origin;
+ const [alexA,alexB]=mail.connections.list(p.people.ready.owner).agents,[taylor]=mail.connections.list(p.people['no-companion'].owner).agents;
+ for(const [agent,label] of [[alexA,'Launch partner'],[alexB,'Code reviewer'],[taylor,'Chief of Staff']])mail.run('UPDATE cp_agent_bindings SET label=? WHERE agent=?',label,agent.id);
+ const i=mail.connections.create(p.people.ready.owner,{agentId:alexA.id,direction:'delegate',authorizeAnswers:true}),c=mail.connections.accept(p.people['no-companion'].owner,{invitation:i.invitation,agentId:taylor.id,authorizeAnswers:true});
+ function send(agent,to,text,replyTo){const binding=mail.get('SELECT * FROM cp_agent_bindings WHERE agent=?',agent.id),device=mail.get('SELECT * FROM cp_devices WHERE id=?',binding.device);return mail.send(device,{sessionId:binding.session,provider:binding.provider,verified:true,to,conversationId:c.id,text,nonce:uid(),...(replyTo?{replyTo}:{}),responseRequested:!replyTo});}
+ const q=send(alexA,taylor.id,'Can you check with Taylor about the launch? We’re hoping to share the preview on Thursday.');
+ send(taylor,alexA.id,'Thursday works. The preview is ready for a small group, and Taylor would like feedback on the invitation flow first.',q.id);
+ const invitation=mail.connections.create(p.people.ready.owner,{agentId:alexB.id,direction:'request',authorizeAnswers:true});
+ routes={signin:['signed-out','/'],onboarding:['empty','/#agents'],agents:['ready','/#agents'],inbox:['ready','/#inbox'],invite:['no-companion','/#agent-invite='+invitation.invitation]};
+ return {origin:p.origin,preview:p,close:()=>p.close()};
+}
+if(process.argv[1]===fileURLToPath(import.meta.url)){const p=await startProductPreview({port:Number(process.env.PRODUCT_PREVIEW_PORT||43214),host:'0.0.0.0',publicOrigin:process.env.PRODUCT_PREVIEW_ORIGIN||null});console.log(p.origin+'/walkthrough');for(const signal of ['SIGINT','SIGTERM'])process.on(signal,async()=>{await p.close();process.exit();});}
