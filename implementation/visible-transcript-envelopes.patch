--- /dev/null
+++ b/tests/transcript-visibility.test.mjs
@@ -0,0 +1,30 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {extractTranscript} from '../apps/commonplace/server/ingest.mjs';
+import {transcriptRecord} from '../apps/commonplace/server/canonical-sync.mjs';
+
+test('Claude API request blobs never become synced user turns',()=>{
+ const visible={type:'user',uuid:'visible-turn',message:{role:'user',content:'Move the pilot to November 12.'}};
+ const blob={type:'api-request-blob',message:{role:'user',content:'<system-reminder>PRIVATE_HOST_CANARY</system-reminder>\nMove the pilot to November 12.'}};
+ assert.equal(extractTranscript(JSON.stringify(blob)), '');
+ assert.equal(extractTranscript(JSON.stringify({type:'api-request-blob',messages:[visible,blob]})), '');
+ assert.equal(extractTranscript([visible,blob].map(JSON.stringify).join('\n')), 'User: Move the pilot to November 12.');
+ assert.deepEqual(transcriptRecord(JSON.stringify(blob),{index:1,provider:'claude',fallbackId:'fixture'}).messages,[]);
+});
+
+test('nonconversation envelopes cannot impersonate user or assistant text',()=>{
+ for(const type of ['system','progress','summary','api-response','tool_result','queue-operation']){
+  assert.equal(extractTranscript(JSON.stringify({type,message:{role:'assistant',content:'PRIVATE_HOST_CANARY'}})), '');
+  assert.equal(extractTranscript(JSON.stringify({type,role:'user',content:'PRIVATE_HOST_CANARY'})), '');
+ }
+});
+
+test('visible Claude, Codex and generic messages retain text and omit reasoning',()=>{
+ const records=[
+  {type:'user',message:{role:'user',content:'Original plan'}},
+  {type:'assistant',message:{role:'assistant',content:[{type:'thinking',thinking:'PRIVATE_THOUGHT'},{type:'text',text:'Current plan'}]}},
+  {type:'response_item',payload:{type:'message',role:'assistant',content:[{type:'output_text',text:'Codex answer'}]}},
+  {role:'user',content:'Generic message'},
+ ];
+ assert.equal(extractTranscript(JSON.stringify(records)), 'User: Original plan\n\nAssistant: Current plan\n\nAssistant: Codex answer\n\nUser: Generic message');
+});
