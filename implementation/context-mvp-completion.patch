index 0000000..8cf9c8a
--- /dev/null
+++ b/apps/commonplace-account/server/space-management.mjs
@@ -0,0 +1,31 @@
+import {randomBytes} from 'node:crypto';
+import {SpaceInvitations} from './space-invitations.mjs';
+import {Groups} from './groups.mjs';
+import {WorkProblem} from './work.mjs';
+const id={type:'string',pattern:'^[a-f0-9]{24}$'},invitation={type:'string',maxLength:2048};
+export const spaceManagementTools=[
+ ['create_context_space','space-create',{name:{type:'string',minLength:1,maxLength:80},nonce:id},['name','nonce'],false,'Create an owner-requested shared space. Reuse nonce only for an identical retry. Then create a space invitation for the people the owner wants to invite. Membership never enables private-context sharing.'],
+ ['create_space_invitation','space-invitation-create',{groupId:id},['groupId'],false,'Create a private 14-day invitation URL for a space you own, only when the owner asks. Return the link for the owner to share; do not send externally without permission. Each call creates a new link.'],
+ ['preview_space_invitation','space-invitation-preview',{invitation},['invitation'],true,'Read the inviter and space before accepting an owner-supplied invitation. Previewing grants no access and does not join.'],
+ ['accept_space_invitation','space-invitation-accept',{invitation},['invitation'],false,'Join only the space the owner explicitly asked to join. Preview first. All current and future members can read shared history. This never enables private-library sharing or changes native permissions.'],
+ ['leave_context_space','space-leave',{groupId:id},['groupId'],false,'Leave an owner-selected space immediately. Its members lose access to your private-context requests, and you lose access to the space. Previously shared history remains. Space owners must archive instead.'],
+ ['archive_context_space','space-archive',{groupId:id},['groupId'],false,'Archive a space you own only when the owner explicitly requests it. Immediately stops access and requests for all members; retained data is not deleted.'],
+].map(([name,action,properties,required,readOnlyHint,description])=>({name,action,description,inputSchema:{type:'object',properties,required,additionalProperties:false},annotations:{readOnlyHint,destructiveHint:['space-leave','space-archive'].includes(action),openWorldHint:!readOnlyHint}}));
+function codeFrom(service,value){
+ if(typeof value!=='string')throw new WorkProblem(400,'Use the invitation link supplied by the owner.');
+ try{const url=new URL(value);if(url.origin!==new URL(service.origin).origin||url.pathname!=='/'||url.username||url.password)throw Error();const code=url.searchParams.get('space-invite');if(!/^[A-Za-z0-9_-]{43}$/.test(code||''))throw Error();return code;}catch{throw new WorkProblem(400,'Use a space invitation from this Meet Proxy server.');}
+}
+export async function manageSpace(service,owner,action,input){
+ const spaces=new SpaceInvitations(service);
+ if(action==='space-create'){await service.limit('group-create:'+owner,20,3600000);return new Groups(service).create(owner,{...input,personIds:[]});}
+ if(action==='space-invitation-create'){
+  await service.limit('space-invite-create:'+owner,20,3600000);
+  const code=randomBytes(32).toString('base64url'),result=spaces.create(owner,{groupId:input.groupId,code});
+  return {...result,invitationUrl:new URL('/?space-invite='+code,service.origin).href};
+ }
+ if(action==='space-invitation-preview')return spaces.preview({code:codeFrom(service,input.invitation)});
+ if(action==='space-invitation-accept')return spaces.accept(owner,{code:codeFrom(service,input.invitation)});
+ if(action==='space-leave')return spaces.remove(owner,{groupId:input.groupId,personId:owner});
+ if(action==='space-archive')return spaces.archive(owner,{groupId:input.groupId});
+ throw new WorkProblem(404,'Unknown space action.');
+}
