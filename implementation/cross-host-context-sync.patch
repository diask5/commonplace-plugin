index 0000000..e80b0b5
--- /dev/null
+++ b/tests/context-setup-cross-host.test.mjs
@@ -0,0 +1,78 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {randomBytes,createHash} from 'node:crypto';
+import {mkdtemp,mkdir,writeFile,rm} from 'node:fs/promises';
+import {tmpdir} from 'node:os';
+import path from 'node:path';
+import {signedFixture} from './signed-fixture.mjs';
+import {ContextSetup} from '../apps/commonplace-account/server/context-setup.mjs';
+import {UnifiedContext} from '../apps/commonplace-account/server/unified-context.mjs';
+import {CloudSync} from '../apps/commonplace/server/cloud-sync.mjs';
+import {contextSyncPresentation} from '../apps/commonplace-account/server/context-assets/context-native-setup.mjs';
+
+const uid=()=>randomBytes(12).toString('hex');
+// These are protocol clients with synthetic identities, not actual host model sessions.
+async function remoteClient(f,owner,label){
+ const s=f.service,redirect_uri='http://127.0.0.1:14567/callback';
+ const client=await s.register({client_name:label,redirect_uris:[redirect_uri]}),verifier=randomBytes(32).toString('base64url');
+ const flow=await s.beginAuthorization({id:owner},{client_id:client.client_id,redirect_uri,response_type:'code',state:uid(),code_challenge:createHash('sha256').update(verifier).digest('base64url'),code_challenge_method:'S256',resource:s.resource,scope:'commonplace:read'});
+ const approved=new URL(await s.approve({id:owner},{flowId:flow.id,csrf:flow.csrf,consent:'allow'},flow.cookie,s.origin));
+ const tokens=await s.exchange({grant_type:'authorization_code',client_id:client.client_id,redirect_uri,resource:s.resource,code:approved.searchParams.get('code'),code_verifier:verifier});
+ return {label,call:async(name,args)=>{
+  const response=await fetch(f.origin+'/mcp',{method:'POST',headers:{'Content-Type':'application/json',Accept:'application/json',Authorization:'Bearer '+tokens.access_token},body:JSON.stringify({jsonrpc:'2.0',id:1,method:'tools/call',params:{name,arguments:args}})});
+  assert.equal(response.status,200);const rpc=await response.json();assert.notEqual(rpc.result?.isError,true,JSON.stringify(rpc));return JSON.parse(rpc.result.content.find(c=>c.type==='text').text);
+ }};
+}
+
+test('native collection updates one library read by three native and two independent OAuth clients',async t=>{
+ const f=await signedFixture(t),owner=await f.service.profile({userId:'synthetic:cross-host-owner',email:'owner@example.test'}),setup=new ContextSetup(f.service),native=[];
+ for(const [app,provider,host] of [['claude','Claude','claude-code'],['codex','Codex','codex'],['conductor','Claude','conductor']]){
+  const client=await f.fresh(app,provider);client.native.host=host;const token='commonplace-context:'+randomBytes(32).toString('base64url');
+  setup.begin(owner.id,{app,token});await client.call('finish_context_setup',{token});assert.equal(setup.status(owner.id,{token}).searchableConversations,0);native.push({...client,label:app,token});
+ }
+ // Native plugins expose the shared-context aliases; remote chat connectors use
+ // archive_search/archive_read. Both must return the same canonical source.
+ const readers=[...native.map(client=>({label:client.label,call:(name,args)=>client.call(name==='archive_search'?'search_shared_context':'read_shared_context',args)})),await remoteClient(f,owner.id,'Claude regular chat protocol fixture'),await remoteClient(f,owner.id,'ChatGPT regular chat protocol fixture')];
+ const dir=await mkdtemp(path.join(tmpdir(),'cross-host-sync-'));t.after(()=>rm(dir,{recursive:true,force:true}));const roots=[];
+ for(const name of ['claude','codex','conductor']){const root=path.join(dir,name);await mkdir(root);roots.push({path:root,name:name+' test history',kind:name==='claude'?'claude':'codex'});}
+ const text=(name,version)=>'crosshostanchor '+name+' decision version '+version;
+ const write=async(name,version)=>{
+  const i=['claude','codex','conductor'].indexOf(name),file=path.join(roots[i].path,name+'.jsonl');
+  const rows=name==='claude'?[{type:'user',sessionId:'cross-host-claude',uuid:'m1',message:{role:'user',content:text(name,version)}},{type:'assistant',message:{role:'assistant',content:[{type:'thinking',thinking:'HIDDEN_REASONING_CANARY'},{type:'tool_use',input:{secret:'HIDDEN_TOOL_CANARY'}}]}}]:[{type:'session_meta',payload:{id:'cross-host-'+name}},{type:'response_item',payload:{id:'m1',type:'message',role:'assistant',channel:'final',content:[{type:'output_text',text:text(name,version)}]}},{type:'response_item',payload:{id:'hidden',type:'message',role:'assistant',channel:'analysis',content:[{type:'output_text',text:'HIDDEN_REASONING_CANARY'}]}}];
+  await writeFile(file,rows.map(row=>JSON.stringify(row)).join('\n')+'\n');
+ };
+ for(const name of ['claude','codex','conductor'])await write(name,1);
+ const app={dir,accountClient:native[0].client},options={discover:async()=>roots.slice(0,2),prepareHistory:async()=>({roots:[roots[2]],coverage:{partial:false}})};
+ let sync=await CloudSync.open(app,options);await sync.tick();assert.equal(sync.state.error,null);
+ const readAll=async()=>Promise.all(readers.map(async reader=>{
+  const found=await reader.call('archive_search',{query:'crosshostanchor'});assert.equal(found.results.length,3,reader.label);
+  const pages=await Promise.all(found.results.map(d=>reader.call('archive_read',{documentId:d.documentId})));
+  assert.ok(pages.every(p=>!p.changed&&p.citations.length));const value=pages.map(p=>p.text).join('\n');assert.doesNotMatch(value,/HIDDEN_REASONING_CANARY|HIDDEN_TOOL_CANARY/);return {label:reader.label,value,ids:found.results.map(r=>r.documentId)};
+ }));
+ for(const r of await readAll())for(const name of ['claude','codex','conductor'])assert.ok(r.value.includes(text(name,1)),r.label);
+ // Reading from another app cannot claim that app has uploaded any source.
+ assert.equal(setup.status(owner.id,{token:native[0].token}).searchableConversations,3);
+ assert.equal(setup.status(owner.id,{token:native[1].token}).searchableConversations,0);
+ assert.equal(setup.status(owner.id,{token:native[2].token}).searchableConversations,0);
