+.policy-page textarea{height:132px;min-height:112px;max-height:340px;resize:vertical;border:1px solid #d9d0c2;border-radius:13px;background:#fffefa;font-size:14px;line-height:1.8;padding:14px 16px;transition:border-color .15s,box-shadow .15s;scrollbar-width:thin;scrollbar-color:#d7cdbc transparent}.policy-page textarea:focus{border-color:#a695b6;outline:0;box-shadow:0 0 0 3px #eee8f5}.field-note{display:flex;gap:7px;align-items:flex-start;font-size:11px;line-height:1.7;color:#756c60;margin:11px 0 18px}.mini-icon{width:14px;height:14px;flex-shrink:0;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;margin-top:2px}
+.policy-page .share-primary{min-height:50px;width:100%;border-radius:999px;background:#b63e27;border:1px solid #b63e27;font-size:13px;font-weight:600;color:#fff;padding:12px 18px;gap:12px}.policy-page .share-primary:hover{background:#a03421;border-color:#a03421;box-shadow:0 3px 10px #b63e2718}.policy-page .share-primary:disabled{opacity:.55;cursor:wait}.share-primary svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}
+.preview-assurance{display:flex;align-items:center;justify-content:center;gap:5px;text-align:center;margin:12px 0 0;font-size:10px;color:#7b7165;line-height:1.6}.preview-assurance .mini-icon{width:12px;height:12px;margin:0}
+.status{font-size:12px;line-height:1.7;color:#696054;text-align:center;margin:12px 0 0;overflow-wrap:anywhere}.status:empty{display:none}.status[data-error=true]{color:#973b27;background:#fcf0e9;border-radius:9px;padding:10px 12px}
+.preview-person{display:flex;align-items:center;gap:10px;padding:13px 0;border-top:1px solid #e8e2d9;border-bottom:1px solid #e8e2d9;margin-bottom:3px}.person-avatar{display:grid;place-items:center;flex-shrink:0;width:34px;height:34px;border-radius:11px;background:#dde6d1;color:#566644;font-size:16px;font-weight:600}.preview-person strong{font-size:12px;font-weight:600}.preview-person small{display:block;color:#756c60;font-size:10px}.match-count{margin-left:auto;font-size:10px;color:#776386;background:#f0eaf6;border-radius:999px;padding:4px 9px;white-space:nowrap}
+.excerpt{padding:17px 0;border-bottom:1px solid #e8e2d9;animation:excerpt-in .3s ease both}.excerpt h3{font-size:12px;line-height:1.6;color:#5c4d6b;font-weight:650;margin-bottom:6px}.excerpt p{font-size:13px;line-height:1.8;color:#5e574d;white-space:pre-wrap;overflow-wrap:anywhere}.excerpt-heading{display:flex;align-items:center;gap:7px}.excerpt-heading .mini-icon{width:13px;height:13px;margin:0}.preview-actions{margin-top:24px}.preview-private{font-size:11px;color:#756c60;text-align:center;line-height:1.8;margin:15px 0 0}.empty{font-size:13px;color:#756c60;line-height:1.8;padding:25px 0;text-align:center}
+.experiment-details{margin:16px 8px 0;color:#756c60}.experiment-details>summary{min-height:44px;display:flex;align-items:center;justify-content:center;gap:8px;font-size:11px;cursor:pointer;list-style:none}.experiment-details>summary::-webkit-details-marker{display:none}.detail-chevron{transition:transform .2s;display:inline-block;font-size:13px}.experiment-details[open] .detail-chevron{transform:rotate(90deg)}.experiment-copy{font-size:11px;line-height:1.9;padding:8px 12px 12px}.experiment-copy p+p{margin-top:10px}#provider{font-family:var(--font-mono);font-size:10px;color:#7a6b87;margin:12px 0}#audit:empty{display:none}.audit-row{display:grid;grid-template-columns:minmax(0,1fr) 90px 52px;gap:8px;padding:10px 0;border-top:1px solid #e5dfd6;font-size:10px}.audit-row span{overflow-wrap:anywhere}.audit-row span:last-child{text-align:right}.audit-row [data-allow=true]{color:#37634a}
+.share-sheet[data-state=checking] .art-document{animation:context-float 1.4s ease-in-out infinite alternate}.share-sheet[data-state=checking] .art-person{animation:context-float 1.4s .35s ease-in-out infinite alternate}.share-sheet[data-state=checking] .art-bridge{animation:bridge-pulse .9s ease-in-out infinite alternate}
+.policy-page :focus-visible{outline:2px solid #9678ae;outline-offset:4px}
+@keyframes context-float{to{transform:translateY(-5px)}}@keyframes bridge-pulse{to{opacity:.25}}@keyframes excerpt-in{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:translateY(0)}}
+@media(min-width:1100px){.policy-main{margin-top:18px}}
+@media(max-width:600px){.policy-header-inner{padding:12px 18px;gap:4px;flex-wrap:wrap;min-height:78px}.policy-header .brand{font-size:17px}.policy-header .brand svg{width:24px;height:26px}.policy-header .account{width:32px;height:32px}.policy-header nav{order:3;justify-content:center;width:100%;gap:26px;margin-top:6px}.policy-header nav a{font-size:12px}.policy-main{margin:6px 14px 0;padding-bottom:20px}.stage-topline{margin:0 3px 8px;padding:0}.share-sheet{border-radius:23px;padding:16px 22px 20px}.sheet-topline{margin-bottom:0}.sharing-art{max-height:110px;margin:0 0 14px}.sharing-copy{margin-bottom:14px}.sharing-copy h1,.sharing-copy h2{font-size:30px;letter-spacing:-1.2px}.sharing-copy p{font-size:12px}.policy-page textarea{font-size:16px;line-height:1.65;height:140px;padding:12px 13px}.field-note{font-size:10px;margin:10px 0 16px}.experiment-details{margin-top:10px}}
+@media(max-width:350px){.policy-header nav{gap:20px}.share-sheet{padding-left:17px;padding-right:17px}.sheet-label{font-size:12px}.sharing-copy h1,.sharing-copy h2{font-size:28px}.prompt-heading label{font-size:11px}.match-count{padding:4px 6px}.experiment-copy{padding-left:0;padding-right:0}}
+@media(prefers-reduced-motion:reduce){.policy-page *,.policy-page *::before,.policy-page *::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
+`;
