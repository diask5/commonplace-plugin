+// Synthetic collector/transport benchmark. No real accounts, upload traffic or
+// wall-clock network claims. Run in a fresh process for each collector revision.
+import {mkdtemp,mkdir,writeFile,readFile,rm} from 'node:fs/promises';
+import {tmpdir} from 'node:os';
+import path from 'node:path';
+import {pathToFileURL} from 'node:url';
+import {createHash} from 'node:crypto';
+import {gunzipSync} from 'node:zlib';
+import assert from 'node:assert/strict';
+const args=process.argv.slice(2),option=name=>args[args.indexOf(name)+1];
+const collector=args.includes('--collector')?path.resolve(option('--collector')):path.resolve('apps/commonplace/server/canonical-sync.mjs');
+const {CanonicalSync}=await import(pathToFileURL(collector));
+const encoding=args.includes('--gzip')?'gzip-base64-v1':undefined;
+const directory=await mkdtemp(path.join(tmpdir(),'chat-upload-benchmark-')),root=path.join(directory,'chats');await mkdir(root);
+const base=Date.now(),expected=new Map(),received=new Map(),completed=new Set();
+let uploads=0,wireBytes=0,plainBytes=0,compressedUploads=0,maxWireBytes=0,maxMessages=0,now=base,ticks=0;
+const digest=s=>createHash('sha256').update(s).digest('hex');
+try{
+ for(let n=0;n<=200;n++){
+  const session='synthetic-'+n,count=n===200?6000:120,rows=[];
+  for(let i=0;i<count;i++){
+   const text=`Project ${n}, turn ${i}: Review the deployment plan and record the owner, decision and unresolved follow-up. `+digest(session+':'+i)+'. The launch time remains undecided.';
+   expected.set(session+':m'+i+':0',text);
+   rows.push(JSON.stringify({sessionId:session,uuid:'m'+i,type:'user',message:{role:'user',content:text}})+'\n');
+  }
+  await writeFile(path.join(root,session+'.jsonl'),rows.join(''));
+ }
+ const app={dir:directory,accountClient:{request:async(route,wire)=>{
+  assert.ok(route.endsWith('/context-ingest'));const bytes=Buffer.byteLength(JSON.stringify(wire));assert.ok(bytes<=64000);
+  const input=wire.encoding?(compressedUploads++,JSON.parse(gunzipSync(Buffer.from(wire.data,'base64')))):wire;
+  uploads++;wireBytes+=bytes;plainBytes+=Buffer.byteLength(JSON.stringify(input));maxWireBytes=Math.max(maxWireBytes,bytes);maxMessages=Math.max(maxMessages,input.messages.length);
+  for(const m of input.messages)if(!m.deleted){const key=input.conversation.id+':'+m.id;assert.equal(m.text,expected.get(key));received.set(key,m.text);}
+  if(input.state==='current')completed.add(input.conversation.id);
+  return {id:input.sourceKey};
+ }}};
+ const sync=new CanonicalSync(app,{now:()=>now});
+ const io=async()=>Object.fromEntries((await readFile('/proc/self/io','utf8')).trim().split('\n').map(l=>{const [k,v]=l.split(':');return [k,Number(v.trim())];}));
+ const before=await io(),start=performance.now();let windowReadBytes=0;
+ while(completed.size<201&&ticks<1000){const count=uploads;const result=await sync.tick('synthetic-owner',[{path:root,name:'Claude chats',kind:'claude'}],{uploadEncoding:encoding});assert.ok(uploads-count<=6);windowReadBytes+=result.io?.readBytes||0;ticks++;now=base+ticks*5000;}
+ const wallMs=performance.now()-start,after=await io();assert.equal(completed.size,201);assert.equal(received.size,expected.size);
