+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {randomBytes} from 'node:crypto';
+import {contextSetupRequest,contextSetupLink} from '../apps/commonplace-account/server/context-assets/context-setup-request.mjs';
+const input={origin:'https://context.example.test',account:{email:'owner@example.test'},token:'commonplace-context:'+randomBytes(32).toString('base64url'),space:{type:'group',id:'a'.repeat(24)}};
+test('each app gets a complete install-and-connect request with one exact private handoff',()=>{
+ for(const app of ['claude','codex','conductor']){const request=contextSetupRequest({...input,app}),url=new URL(contextSetupLink(app,request));assert.equal(url.protocol,app+':');assert.ok(decodeURIComponent(url.href).includes(input.token));assert.ok(request.includes(input.origin));assert.ok(request.includes(input.space.id));assert.match(request,/skip installation/);assert.match(request,/do not call connect_account/);assert.match(request,/never change permissions or substitute shell\/HTTP for a denied tool/);assert.match(request,/Existing exclusions stay in force/);assert.match(request,/finish_context_setup/);assert.equal(request.split(input.token).length,2);}
+ const claude=contextSetupRequest({...input,app:'claude'});assert.match(claude,/claude plugin install meet-proxy@commonplace/);assert.match(claude,/plugin includes its MCP server/);assert.doesNotMatch(claude,/configure-codex/);
+ const codex=contextSetupRequest({...input,app:'codex'});assert.match(codex,/SHA-256/);assert.match(codex,/configure-codex.mjs/);assert.match(codex,/bundled OS runtime/);assert.doesNotMatch(codex,/claude plugin install/);
+});
+test('missing account, unknown app or invalid handoff never produces a setup authorization',()=>{
+ for(const change of [{account:null},{app:'unknown'},{token:'public-invitation'}])assert.equal(contextSetupRequest({...input,app:'claude',...change}),'');
+});
