@@ -0,0 +1,13 @@
+export const setupApps={claude:'Claude Desktop',codex:'Codex',conductor:'Conductor'};
+const claudeInstall='For Claude Code, inspect the installed plugins first. Reuse a working meet-proxy/commonplace alias. If installation is needed, use the supported plugin manager: claude plugin marketplace add diask5/commonplace-plugin, then claude plugin install meet-proxy@commonplace. Update the existing alias when present; keep only one enabled. The plugin includes its MCP server: do not add a second MCP entry. Reload using host controls if required.';
+const codexInstall='For Codex, reuse a working Meet Proxy MCP installation. Otherwise get the latest published Meet Proxy ZIP from https://github.com/diask5/commonplace-plugin/releases, verify its published SHA-256, extract to a permanent folder and run its server/configure-codex.mjs with the bundled OS runtime from this actual chat shell. The helper configures MCP and preserves existing settings. Never invent native identity variables.';
+export function contextSetupRequest({app,origin,account,space,token}){
+ if(!Object.hasOwn(setupApps,app)||!account||!/^commonplace-context:[A-Za-z0-9_-]{43}$/.test(token||''))return '';
+ const install=app==='claude'?claudeInstall:app==='codex'?codexInstall:'Use the installer for this Conductor chat’s actual provider. '+claudeInstall+' '+codexInstall;
+ return 'Set up Meet Proxy in THIS '+setupApps[app]+' chat at '+origin+'. Do the setup now, rather than giving me a list of steps. I already signed in as '+(account.email||account.name)+'.\n\n'
+ +'I authorize routine plugin installation/configuration, automatic private collection of supported visible work chats'+(space?.type==='group'?', and using THIS chat for space '+space.id:'')+'. Existing exclusions stay in force.\n\n'
+ +'First use setup_status if loaded. If finish_context_setup is already available and the server/account match, skip installation. '+install+'\n\n'
+ +'Verify the exact server origin before continuing; preserve and report any existing server or account mismatch. Call finish_context_setup with token '+token+'. This private 30-minute handoff carries my verified sign-in; do not call connect_account or request a second Google login. It starts collection automatically. Check context_sync_status; the browser confirms progress.\n\n'
+ +'Respect host approvals. If blocked, stop that action and explain the exact approval/reload needed; never change permissions or substitute shell/HTTP for a denied tool. If the latest release lacks finish_context_setup, report the missing release capability. Keep this chat and its real identity. Do not enable cloud inference or share my private archive with other members.';
+}
+export function contextSetupLink(app,prompt){return ({claude:'claude://code/new?q=',codex:'codex://threads/new?prompt=',conductor:'conductor://prompt='})[app]+encodeURIComponent(prompt);}
